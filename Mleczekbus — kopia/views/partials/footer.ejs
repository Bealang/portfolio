<!-- Font & Color Customizer Panel -->
<button class="customizer-trigger" id="customizer-trigger" aria-label="Dostosuj Wygląd">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z">
        </path>
    </svg>
</button>

<div class="customizer-panel" id="customizer-panel">
    <h3>Dostosuj Wygląd</h3>

    <!-- Czcionka -->
    <div class="customizer-section">
        <h4>Czcionka strony</h4>
        <select id="custom-font-select" class="custom-font-select">
            <option value="Plus Jakarta Sans">Plus Jakarta Sans (Domyślna)</option>
            <option value="Poppins">Poppins</option>
            <option value="Roboto">Roboto</option>
            <option value="Montserrat">Montserrat</option>
            <option value="Inter">Inter</option>
            <option value="Playfair Display">Playfair Display</option>
            <option value="Oswald">Oswald</option>
            <option value="Lora">Lora</option>
            <option value="Outfit">Outfit</option>
            <option value="Kanit">Kanit</option>
        </select>
    </div>

    <!-- Gotowe Motywy -->
    <div class="customizer-section">
        <h4>Gotowe motywy</h4>
        <div class="custom-theme-grid">
            <button type="button" class="theme-btn" data-theme="classic">Granat</button>
            <button type="button" class="theme-btn" data-theme="emerald">Szmaragd</button>
            <button type="button" class="theme-btn" data-theme="bronze">Bursztyn</button>
            <button type="button" class="theme-btn" data-theme="darkred">Czerwień</button>
        </div>
    </div>

    <!-- Własne Kolory -->
    <div class="customizer-section">
        <h4>Edytuj Kolory</h4>
        <div class="custom-color-grid">
            <div class="color-picker-item">
                <label>Główny</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-primary">
                    <input type="text" id="cpt-primary" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Główny Hover</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-primaryHover">
                    <input type="text" id="cpt-primaryHover" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Akcent (Złoty)</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-accent">
                    <input type="text" id="cpt-accent" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Akcent Hover</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-accentHover">
                    <input type="text" id="cpt-accentHover" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Tło strony</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-bg">
                    <input type="text" id="cpt-bg" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Karty/Pudełka</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-surface">
                    <input type="text" id="cpt-surface" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Tekst główny</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-textPrimary">
                    <input type="text" id="cpt-textPrimary" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Tekst pomocny</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-textSecondary">
                    <input type="text" id="cpt-textSecondary" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Tekst akcentu</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-accentText">
                    <input type="text" id="cpt-accentText" maxlength="7">
                </div>
            </div>
            <div class="color-picker-item">
                <label>Ramki</label>
                <div class="color-picker-wrap">
                    <input type="color" id="cp-border">
                    <input type="text" id="cpt-border" maxlength="7">
                </div>
            </div>
        </div>
    </div>

    <!-- Akcje -->
    <div class="customizer-actions">
        <button type="button" id="customizer-save" class="btn-customizer-save">Zapisz</button>
        <button type="button" id="customizer-reset" class="btn-customizer-reset">Resetuj</button>
    </div>
</div>

<!-- Script loading -->
<script src="/customizer.js"></script>
</body>

</html>