<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Testbus' %>
    </title>
    <!-- Instant Cookie Theme & Font Applier -->
    <script>
        (function () {
            function getCookie(name) {
                const nameEQ = name + "=";
                const ca = document.cookie.split(';');
                for (let i = 0; i < ca.length; i++) {
                    let c = ca[i];
                    while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                    if (c.indexOf(nameEQ) === 0) return decodeURIComponent(c.substring(nameEQ.length, c.length));
                }
                return null;
            }
            const savedFont = getCookie('testbus_font');
            const savedThemeJson = getCookie('testbus_theme');
            if (savedFont && savedFont !== 'default' && savedFont !== 'Plus Jakarta Sans') {
                const fontId = 'gfont-' + savedFont.toLowerCase().replace(/\s+/g, '-');
                if (!document.getElementById(fontId)) {
                    const link = document.createElement('link');
                    link.id = fontId;
                    link.rel = 'stylesheet';
                    link.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(savedFont) + ':ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap';
                    document.head.appendChild(link);
                }
                document.documentElement.style.setProperty('--font-family-custom', "'" + savedFont + "', sans-serif");
            }
            if (savedThemeJson) {
                try {
                    const colors = JSON.parse(savedThemeJson);
                    document.documentElement.style.setProperty('--primary-color', colors.primary);
                    document.documentElement.style.setProperty('--primary-hover', colors.primaryHover);
                    document.documentElement.style.setProperty('--accent-color', colors.accent);
                    document.documentElement.style.setProperty('--accent-hover', colors.accentHover);
                    document.documentElement.style.setProperty('--bg-color', colors.bg);
                    document.documentElement.style.setProperty('--surface-color', colors.surface);
                    document.documentElement.style.setProperty('--text-primary', colors.textPrimary);
                    document.documentElement.style.setProperty('--text-secondary', colors.textSecondary);
                    document.documentElement.style.setProperty('--accent-text', colors.accentText);
                    document.documentElement.style.setProperty('--border-color', colors.border);
                } catch (e) { }
            }
        })();
    </script>
    <% if (typeof description !=='undefined' && description) { %>
        <meta name="description" content="<%= description %>">
        <% } %>
            <% if (typeof keywords !=='undefined' && keywords) { %>
                <meta name="keywords" content="<%= keywords %>">
                <% } %>
                    <link rel="preconnect" href="https://fonts.googleapis.com">
                    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
                    <link
                        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
                        rel="stylesheet" media="print" onload="this.media='all'">
                    <link rel="preload" href="/style.css" as="style">
                    <% if (typeof isHome !=='undefined' && isHome) { %>
                        <link rel="preload" href="/bus.webp" as="image" fetchpriority="high">
                        <% } %>
                            <link rel="stylesheet" href="/style.css">
                            <script src="/main.js" defer></script>

                            <% if (typeof isHome !=='undefined' && isHome) { %>
                                <!-- Schema.org JSON-LD for Local Business and Bus Service -->
                                <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BusReservationService",
      "name": "Testbus",
      "url": "https://testbus.pl",
      "logo": "https://testbus.pl/bus.png",
      "description": "Przewozy osób na trasie [miejscowości]",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Testbus",
        "telephone": "+48999999999",
        "priceRange": "$",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "miejscowosc",
          "addressRegion": "malopolskie",
          "addressCountry": "PL"
        }
      },
      "areaServed": [
        "miejscowosc 1",
        "miejscowosc 2",
        "miejscowosc 3",
        "miejscowosc 4",
        "miejscowosc 5"
      ]
    }
    </script>
                                <% } %>
</head>

