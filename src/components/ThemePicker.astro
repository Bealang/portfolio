---
// ThemePicker.astro - Floating personalization controls: theme mode toggle & color theme picker
---

<div class="theme-floating-controls" id="theme-floating-controls">
    <!-- Dark / Light Mode Toggle Button (Taki sam okrąg jak próbnik kolorów) -->
    <button 
        class="theme-mode-toggle" 
        id="theme-mode-toggle" 
        aria-label="Przełącz motyw jasny / ciemny"
        title="Przełącz motyw jasny / ciemny"
    >
        <span class="theme-mode-icon-wrap">
            <i class="fa-solid fa-sun sun-icon"></i>
            <i class="fa-solid fa-moon moon-icon"></i>
        </span>
    </button>

    <!-- Color Theme Picker Container -->
    <div class="theme-picker" id="theme-picker-container">
        <!-- Trigger Button -->
        <button 
            class="theme-picker__trigger" 
            id="theme-picker-trigger" 
            aria-label="Wybierz motyw kolorystyczny"
            title="Zmień kolorystykę strony"
        >
            <i class="fa-solid fa-palette"></i>
        </button>

        <!-- Menu -->
        <div class="theme-picker__menu" id="theme-picker-menu">
            <div class="theme-picker__title">Kolorystyka strony</div>
            <div class="theme-picker__options">
                <button 
                    class="theme-picker__option" 
                    data-theme-value="blue" 
                    title="Niebieski" 
                    aria-label="Motyw niebieski"
                    style="background: linear-gradient(135deg, #2563eb, #38bdf8);"
                >
                    <span class="theme-picker__option-dot"></span>
                </button>
                <button 
                    class="theme-picker__option" 
                    data-theme-value="pink" 
                    title="Różowy" 
                    aria-label="Motyw różowy"
                    style="background: linear-gradient(135deg, #8b5cf6, #ec4899);"
                >
                    <span class="theme-picker__option-dot"></span>
                </button>
                <button 
                    class="theme-picker__option" 
                    data-theme-value="green" 
                    title="Zielony" 
                    aria-label="Motyw zielony"
                    style="background: linear-gradient(135deg, #059669, #34d399);"
                >
                    <span class="theme-picker__option-dot"></span>
                </button>
                <button 
                    class="theme-picker__option" 
                    data-theme-value="red" 
                    title="Czerwony" 
                    aria-label="Motyw czerwony"
                    style="background: linear-gradient(135deg, #dc2626, #f87171);"
                >
                    <span class="theme-picker__option-dot"></span>
                </button>
                <button 
                    class="theme-picker__option" 
                    data-theme-value="yellow" 
                    title="Żółty" 
                    aria-label="Motyw żółty"
                    style="background: linear-gradient(135deg, #d97706, #facc15);"
                >
                    <span class="theme-picker__option-dot"></span>
                </button>
                <button 
                    class="theme-picker__option" 
                    data-theme-value="orange" 
                    title="Pomarańczowy" 
                    aria-label="Motyw pomarańczowy"
                    style="background: linear-gradient(135deg, #ea580c, #fb923c);"
                >
                    <span class="theme-picker__option-dot"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Floating button container in the bottom right corner */
    .theme-floating-controls {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 10000; /* overlay all components */
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Hide controls on mobile screens (mobile uses drawer theme switch) */
    @media (max-width: 768px) {
        .theme-floating-controls {
            display: none !important;
        }
    }

    .theme-picker {
        position: relative;
    }

    /* Trigger & Toggle Buttons - Identical glassmorphism circles (compact & elegant) */
    .theme-picker__trigger,
    .theme-mode-toggle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid rgba(var(--accent-blue-rgb), 0.25);
        background: rgba(var(--accent-blue-rgb), 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: var(--accent-blue);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08), 0 0 12px rgba(var(--accent-blue-rgb), 0.12);
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        padding: 0;
        position: relative;
    }

    .theme-picker__trigger:hover,
    .theme-mode-toggle:hover {
        background: var(--accent-blue);
        color: #ffffff;
        border-color: var(--accent-blue);
        box-shadow: 0 12px 28px rgba(var(--accent-blue-rgb), 0.3), 0 0 20px rgba(var(--accent-blue-rgb), 0.2);
        transform: scale(1.08);
    }

    .theme-picker__trigger:hover {
        transform: scale(1.08) rotate(15deg);
    }

    .theme-picker__trigger:active,
    .theme-mode-toggle:active {
        transform: scale(0.95);
    }

    /* Theme Mode Icon Switching Animation */
    .theme-mode-icon-wrap {
        position: relative;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .theme-mode-icon-wrap .sun-icon,
    .theme-mode-icon-wrap .moon-icon {
        position: absolute;
        font-size: 1.15rem;
        transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s ease;
    }

    /* Light mode: Sun is visible, Moon is hidden */
    :global(html[data-theme="light"]) .sun-icon {
        opacity: 1;
        transform: rotate(0) scale(1);
    }

    :global(html[data-theme="light"]) .moon-icon {
        opacity: 0;
        transform: rotate(90deg) scale(0.4);
        pointer-events: none;
    }

    /* Dark mode: Moon is visible, Sun is hidden */
    :global(html[data-theme="dark"]) .sun-icon {
        opacity: 0;
        transform: rotate(-90deg) scale(0.4);
        pointer-events: none;
    }

    :global(html[data-theme="dark"]) .moon-icon {
        opacity: 1;
        transform: rotate(0) scale(1);
    }

    /* Menu container - Glassmorphic card styling */
    .theme-picker__menu {
        position: absolute;
        bottom: 58px;
        right: 0;
        width: 220px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(var(--accent-blue-rgb), 0.15);
        border-radius: 20px;
        padding: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12), 0 0 20px rgba(var(--accent-blue-rgb), 0.05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        opacity: 0;
        visibility: hidden;
        transform: translateY(15px) scale(0.95);
        transform-origin: bottom right;
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Dark mode adaptibility for menu */
    :global(html[data-theme="dark"]) .theme-picker__menu {
        background: rgba(0, 0, 0, 0.9);
        border-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 25px rgba(var(--accent-blue-rgb), 0.1);
    }

    /* Opened state */
    .theme-picker.is-open .theme-picker__menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .theme-picker.is-open .theme-picker__trigger {
        transform: rotate(90deg);
        background: var(--accent-blue);
        color: #ffffff;
        border-color: var(--accent-blue);
    }

    .theme-picker__title {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 12px;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Grid of color swatches */
    .theme-picker__options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    /* Individual Color Swatch */
    .theme-picker__option {
        aspect-ratio: 1;
        border-radius: 50%;
        border: 2px solid transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
    }

    .theme-picker__option:hover {
        transform: scale(1.15) translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .theme-picker__option:active {
        transform: scale(0.9);
    }

    /* Selected state indicator */
    .theme-picker__option.is-active {
        border-color: var(--text-primary);
        box-shadow: 0 0 0 2px rgba(var(--accent-blue-rgb), 0.3), 0 6px 12px rgba(0, 0, 0, 0.15);
        transform: scale(1.1);
    }

    .theme-picker__option-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ffffff;
        opacity: 0;
        transform: scale(0.5);
        transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .theme-picker__option.is-active .theme-picker__option-dot {
        opacity: 1;
        transform: scale(1);
    }
</style>

<script>
    // ThemePicker & Theme Mode Toggle Script
    document.addEventListener("DOMContentLoaded", () => {
        // 1. Theme Picker (Color Swatches)
        const container = document.getElementById("theme-picker-container");
        const trigger = document.getElementById("theme-picker-trigger");
        const options = document.querySelectorAll(".theme-picker__option");

        if (container && trigger) {
            const getActiveTheme = (): string => {
                return document.documentElement.getAttribute("data-color-theme") || "pink";
            };

            const updateActiveState = (activeTheme: string) => {
                options.forEach(opt => {
                    const themeVal = opt.getAttribute("data-theme-value");
                    if (themeVal === activeTheme) {
                        opt.classList.add("is-active");
                    } else {
                        opt.classList.remove("is-active");
                    }
                });
            };

            updateActiveState(getActiveTheme());

            trigger.addEventListener("click", (e) => {
                e.stopPropagation();
                container.classList.toggle("is-open");
            });

            document.addEventListener("click", (e) => {
                if (!container.contains(e.target as Node)) {
                    container.classList.remove("is-open");
                }
            });

            options.forEach(opt => {
                opt.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const selectedTheme = opt.getAttribute("data-theme-value");
                    if (!selectedTheme) return;

                    document.cookie = `color-theme=${selectedTheme}; path=/; max-age=${365 * 24 * 60 * 60}; SameSite=Lax`;
                    document.documentElement.setAttribute("data-color-theme", selectedTheme);
                    updateActiveState(selectedTheme);

                    setTimeout(() => {
                        container.classList.remove("is-open");
                    }, 200);
                });
            });
        }

        // 2. Dark / Light Mode Toggle Button with Fluid Expanding Circle Transition
        const modeToggle = document.getElementById("theme-mode-toggle");
        let isModeTransitioning = false;

        if (modeToggle) {
            modeToggle.addEventListener("click", (event: MouseEvent) => {
                if (isModeTransitioning) return;
                isModeTransitioning = true;

                const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
                const newTheme = currentTheme === "dark" ? "light" : "dark";

                let x = event.clientX;
                let y = event.clientY;
                if (x === undefined || y === undefined) {
                    const rect = modeToggle.getBoundingClientRect();
                    x = rect.left + rect.width / 2;
                    y = rect.top + rect.height / 2;
                }

                const overlay = document.createElement("div");
                overlay.className = "theme-transition-overlay";

                const circle = document.createElement("div");
                circle.className = "theme-transition-circle";
                circle.style.left = (x - 50) + "px";
                circle.style.top = (y - 50) + "px";

                const currentBg = document.createElement("div");
                currentBg.className = "theme-transition-circle-bg current-bg";
                currentBg.style.backgroundColor = currentTheme === "dark" ? "#000000" : "#f5f6f8";

                const targetBg = document.createElement("div");
                targetBg.className = "theme-transition-circle-bg target-bg";
                targetBg.style.backgroundColor = newTheme === "dark" ? "#000000" : "#f5f6f8";

                circle.appendChild(currentBg);
                circle.appendChild(targetBg);
                overlay.appendChild(circle);
                document.body.appendChild(overlay);

                const maxDist = Math.max(
                    Math.hypot(x, y),
                    Math.hypot(window.innerWidth - x, y),
                    Math.hypot(x, window.innerHeight - y),
                    Math.hypot(window.innerWidth - x, window.innerHeight - y)
                );
                const targetScale = (maxDist / 50) + 0.5;

                overlay.offsetWidth;

                // Phase 1: Expand circle via transform scale
                circle.animate([
                    { transform: "scale(0)" },
                    { transform: "scale(" + targetScale + ")" }
                ], {
                    duration: 550,
                    easing: "cubic-bezier(0.76, 0, 0.24, 1)",
                    fill: "forwards"
                });

                // Phase 2: Fade target background
                setTimeout(() => {
                    targetBg.animate([
                        { opacity: 0 },
                        { opacity: 1 }
                    ], {
                        duration: 150,
                        easing: "ease-out",
                        fill: "forwards"
                    });
                }, 550);

                // Phase 3: Switch theme under the hood
                setTimeout(() => {
                    document.documentElement.setAttribute("data-theme", newTheme);
                    localStorage.setItem("theme", newTheme);
                    const metaTheme = document.querySelector('meta[name="theme-color"]');
                    if (metaTheme) {
                        metaTheme.setAttribute("content", newTheme === "dark" ? "#000000" : "#f5f6f8");
                    }
                }, 700);

                // Phase 4: Shrink circle back to reveal the page
                setTimeout(() => {
                    const shrinkAnimation = circle.animate([
                        { transform: "scale(" + targetScale + ")" },
                        { transform: "scale(0)" }
                    ], {
                        duration: 550,
                        easing: "cubic-bezier(0.76, 0, 0.24, 1)",
                        fill: "forwards"
                    });

                    shrinkAnimation.onfinish = () => {
                        overlay.remove();
                        isModeTransitioning = false;
                    };
                }, 750);
            });
        }
    });
</script>
