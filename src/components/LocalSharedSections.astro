---
import ProjectCard from "./ProjectCard.astro";
import { getCollection } from "astro:content";

interface Props {
    cityName?: string;
}

const { cityName } = Astro.props;

// Pobieranie projektów z kolekcji
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<div class="local-shared-wrapper">
    <!-- SEKCJA: PRZYKŁADOWE REALIZACJE -->
    <section class="local-shared-section local-shared-projects" id="realizacje">
        <div class="local-shared-container">
            <div class="local-shared-header" data-aos="fade-up">
                <span class="local-shared-tag">Portfolio & Jakość</span>
                <h2 class="local-shared-title">
                    Przykładowe <span class="gradient__text">realizacje</span>
                </h2>
                <p class="local-shared-desc">
                    {cityName 
                        ? `Zobacz wybrane strony, które stworzyliśmy od zera dla firm z okolic ${cityName} i całej Małopolski. Bez szablonów, z wynikiem 95-100 w Google PageSpeed.`
                        : "Zobacz wybrane strony internetowe, które stworzyliśmy od zera. Bez ciężkich szablonów WordPress, zoptymalizowane pod konwersję i Google PageSpeed 95-100."
                    }
                </p>
            </div>

            <div class="projects-grid" data-aos="fade-up" data-aos-delay="150">
                {
                    projects.map((project) => (
                        <ProjectCard
                            slug={project.id}
                            title={project.data.title}
                            date={project.data.date}
                            url={project.data.url}
                            color={project.data.color}
                            accent={project.data.accent}
                            thumbnail={project.data.thumbnail}
                            thumbnailAlt={project.data.thumbnailAlt}
                            mockup={project.data.mockup}
                        />
                    ))
                }
            </div>

            <div class="local-shared-center-action" data-aos="fade-up" data-aos-delay="200">
                <a href="/#projekty" class="local-shared-btn-secondary">
                    <span>Zobacz szczegóły portfolio na stronie głównej</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- SEKCJA: JAK DZIAŁAMY -->
    <section class="local-shared-section local-shared-process" id="jak-dzialamy">
        <div class="local-shared-container">
            <div class="local-shared-header" data-aos="fade-up">
                <span class="local-shared-tag">Bez komplikacji</span>
                <h2 class="local-shared-title">
                    Jak <span class="gradient__text">działamy</span> krok po kroku?
                </h2>
                <p class="local-shared-desc">
                    Prosty, 4-etapowy proces współpracy. Nie musisz znać się na technologii – my przeprowadzimy Cię przez każdy krok.
                </p>
            </div>

            <div class="local-shared-steps-grid">
                <div class="local-step-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="local-step-num">01</div>
                    <div class="local-step-icon">
                        <i class="fa-solid fa-comments"></i>
                    </div>
                    <h3>Rozmowa & Wycena</h3>
                    <p>
                        Opisujesz nam swoją firmę i cele. W ciągu 24h otrzymujesz bezpłatną, niezobowiązującą wycenę ze stałą kwotą bez ukrytych opłat.
                    </p>
                </div>

                <div class="local-step-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="local-step-num">02</div>
                    <div class="local-step-icon">
                        <i class="fa-solid fa-compass-drafting"></i>
                    </div>
                    <h3>Projekt graficzny UI/UX</h3>
                    <p>
                        Projektujemy indywidualny layout dopasowany do Twojej branży. Żadnych gotowych, powtarzalnych szablonów. Akceptujesz wygląd przed kodowaniem.
                    </p>
                </div>

                <div class="local-step-card" data-aos="fade-up" data-aos-delay="300">
                    <div class="local-step-num">03</div>
                    <div class="local-step-icon">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <h3>Czyste kodowanie</h3>
                    <p>
                        Programujemy stronę w ultranowoczesnej technologii Astro. Strona jest responsywna, bezpieczna i ładuje się w ułamku sekundy.
                    </p>
                </div>

                <div class="local-step-card" data-aos="fade-up" data-aos-delay="400">
                    <div class="local-step-num">04</div>
                    <div class="local-step-icon">
                        <i class="fa-solid fa-rocket"></i>
                    </div>
                    <h3>Uruchomienie & Google</h3>
                    <p>
                        Konfigurujemy hosting, domenę, certyfikat SSL i indeksujemy witrynę w Google Search Console. Strona jest w 100% Twoją własnością bez abonamentu.
                    </p>
                </div>
            </div>

            <div class="local-shared-center-action" data-aos="fade-up" data-aos-delay="200">
                <a href="/jak-dzialamy" class="local-shared-btn-secondary">
                    <span>Poznaj szczegółowy proces i FAQ &rarr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- SEKCJA: CENNIK TEASER -->
    <section class="local-shared-section local-shared-pricing" id="cennik">
        <div class="local-shared-container">
            <div class="local-shared-header" data-aos="fade-up">
                <span class="local-shared-tag">Przejrzyste stawki</span>
                <h2 class="local-shared-title">
                    Przejrzysty <span class="gradient__text">cennik</span> bez abonamentu
                </h2>
                <p class="local-shared-desc">
                    Inwestujesz raz w narzędzie, które zarabia na siebie. Brak comiesięcznych opłat licencyjnych za stronę.
                </p>
            </div>

            <div class="local-pricing-grid">
                <!-- Karta 1 -->
                <div class="local-pricing-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="local-pricing-tier">Pakiet Start</div>
                    <h3 class="local-pricing-name">OnePage / Wizytówka</h3>
                    <div class="local-pricing-price">
                        od <span>990</span> zł <small>/ netto</small>
                    </div>
                    <p class="local-pricing-summary">
                        Wszystkie kluczowe informacje, oferta i formularz kontaktowy na jednej, nowoczesnej stronie. Idealne na lokalny start.
                    </p>
                    <ul class="local-pricing-features">
                        <li><i class="fa-solid fa-check"></i> 100% autorski kod (Astro)</li>
                        <li><i class="fa-solid fa-check"></i> Wynik 95-100 Google PageSpeed</li>
                        <li><i class="fa-solid fa-check"></i> Podstawowe SEO lokalne + Schema</li>
                        <li><i class="fa-solid fa-check"></i> 0 zł abonamentu za system</li>
                    </ul>
                    <a href="/cennik" class="local-pricing-cta">Zobacz szczegóły pakietu</a>
                </div>

                <!-- Karta 2 (wyróżniona) -->
                <div class="local-pricing-card local-pricing-card--popular" data-aos="fade-up" data-aos-delay="200">
                    <div class="local-pricing-badge">Najczęściej wybierany</div>
                    <div class="local-pricing-tier">Pakiet Standard</div>
                    <h3 class="local-pricing-name">Strona Wielostronicowa</h3>
                    <div class="local-pricing-price">
                        od <span>1 690</span> zł <small>/ netto</small>
                    </div>
                    <p class="local-pricing-summary">
                        Kompleksowa strona z osobnymi podstronami dla usług, cennika, galerii i kontaktu. Opcjonalnie z panelem CMS.
                    </p>
                    <ul class="local-pricing-features">
                        <li><i class="fa-solid fa-check"></i> Kilka dedykowanych podstron</li>
                        <li><i class="fa-solid fa-check"></i> Zaawansowane SEO pod lokalne frazy</li>
                        <li><i class="fa-solid fa-check"></i> Możliwość edycji treści (CMS)</li>
                        <li><i class="fa-solid fa-check"></i> Integracja z mapami i formularzami</li>
                    </ul>
                    <a href="/cennik" class="local-pricing-cta local-pricing-cta--popular">Wybierz stronę www</a>
                </div>

                <!-- Karta 3 -->
                <div class="local-pricing-card" data-aos="fade-up" data-aos-delay="300">
                    <div class="local-pricing-tier">Dedykowane rozwiązania</div>
                    <h3 class="local-pricing-name">Indywidualny Projekt</h3>
                    <div class="local-pricing-price">
                        <span>Wycena</span> <small>indywidualna</small>
                    </div>
                    <p class="local-pricing-summary">
                        Niestandardowe kalkulatory, systemy rezerwacji, katalogi produktów czy sklepy zoptymalizowane pod szybką sprzedaż.
                    </p>
                    <ul class="local-pricing-features">
                        <li><i class="fa-solid fa-check"></i> Dowolne zaawansowane funkcje</li>
                        <li><i class="fa-solid fa-check"></i> Integracje zewnętrzne przez API</li>
                        <li><i class="fa-solid fa-check"></i> Dedykowana architektura bazy danych</li>
                        <li><i class="fa-solid fa-check"></i> Wsparcie powdrożeniowe SLA</li>
                    </ul>
                    <a href="/zamow" class="local-pricing-cta">Zapytaj o wycenę</a>
                </div>
            </div>

            <div class="local-shared-center-action" data-aos="fade-up" data-aos-delay="200">
                <a href="/cennik" class="local-shared-btn-secondary">
                    <span>Przejdź do pełnego cennika z kalkulatorem brutto/netto &rarr;</span>
                </a>
            </div>
        </div>
    </section>
</div>

<style>
    .local-shared-wrapper {
        position: relative;
        width: 100%;
        margin-top: 40px;
    }

    .local-shared-section {
        padding: 90px 24px;
        position: relative;
    }

    .local-shared-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .local-shared-header {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 50px;
    }

    .local-shared-tag {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(var(--accent-blue-rgb), 0.1);
        color: var(--accent-blue);
        border: 1px solid rgba(var(--accent-blue-rgb), 0.25);
        border-radius: 100px;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 16px;
    }

    .local-shared-title {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(2rem, 3.8vw, 3rem);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -0.8px;
        margin-bottom: 18px;
    }

    .local-shared-desc {
        font-size: 1.05rem;
        color: var(--text-secondary);
        line-height: 1.65;
        margin: 0;
    }

    .local-shared-center-action {
        display: flex;
        justify-content: center;
        margin-top: 48px;
    }

    .local-shared-btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        border-radius: 14px;
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .local-shared-btn-secondary:hover {
        border-color: var(--accent-blue);
        color: var(--accent-blue);
        transform: translateY(-2px);
    }

    /* KROKI PROCESU (JAK DZIAŁAMY) */
    .local-shared-steps-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    .local-step-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 32px 24px;
        position: relative;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .local-step-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-blue);
    }

    .local-step-num {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: rgba(var(--accent-blue-rgb), 0.2);
        line-height: 1;
        margin-bottom: 12px;
    }

    .local-step-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(var(--accent-blue-rgb), 0.12);
        color: var(--accent-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: 18px;
    }

    .local-step-card h3 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 10px;
    }

    .local-step-card p {
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
    }

    /* CENNIK */
    .local-pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        align-items: stretch;
    }

    .local-pricing-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 22px;
        padding: 36px 28px;
        display: flex;
        flex-direction: column;
        position: relative;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .local-pricing-card:hover {
        transform: translateY(-4px);
    }

    .local-pricing-card--popular {
        border-color: var(--accent-blue);
        box-shadow: 0 10px 30px rgba(var(--accent-blue-rgb), 0.15);
    }

    .local-pricing-badge {
        position: absolute;
        top: -13px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--accent-blue);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 14px;
        border-radius: 100px;
        white-space: nowrap;
    }

    .local-pricing-tier {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .local-pricing-name {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 0 0 16px;
    }

    .local-pricing-price {
        font-size: 1.05rem;
        color: var(--text-secondary);
        margin-bottom: 16px;
    }

    .local-pricing-price span {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--text-primary);
    }

    .local-pricing-price small {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .local-pricing-summary {
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 24px;
        min-height: 48px;
    }

    .local-pricing-features {
        list-style: none;
        padding: 0;
        margin: 0 0 32px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex-grow: 1;
    }

    .local-pricing-features li {
        font-size: 0.9rem;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .local-pricing-features li i {
        color: var(--accent-blue);
        font-size: 0.85rem;
    }

    .local-pricing-cta {
        display: block;
        text-align: center;
        padding: 13px 20px;
        border-radius: 12px;
        background: rgba(var(--accent-blue-rgb), 0.1);
        border: 1px solid rgba(var(--accent-blue-rgb), 0.3);
        color: var(--accent-blue);
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .local-pricing-cta:hover {
        background: var(--accent-blue);
        color: #fff;
    }

    .local-pricing-cta--popular {
        background: var(--accent-blue);
        color: #fff;
        border-color: var(--accent-blue);
    }

    .local-pricing-cta--popular:hover {
        filter: brightness(1.1);
    }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
        .local-shared-steps-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .local-pricing-grid {
            grid-template-columns: 1fr;
            max-width: 480px;
            margin: 0 auto;
        }
    }

    @media (max-width: 640px) {
        .local-shared-steps-grid {
            grid-template-columns: 1fr;
        }
        .local-shared-section {
            padding: 60px 16px;
        }
        .local-step-card, .local-pricing-card {
            padding: 24px 20px;
        }
    }
</style>
