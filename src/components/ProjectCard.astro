---
interface Props {
  slug: string;
  title: string;
  date: string;
  url?: string;
  color: string;
  accent: string;
  thumbnail: string;
  thumbnailAlt: string;
}

const { slug, title, date, url, color, accent, thumbnail, thumbnailAlt } = Astro.props;

// Extract clean domain from url
let domain = '';
if (url) {
  try {
    const urlObj = new URL(url);
    domain = urlObj.hostname;
    if (domain.startsWith('www.')) {
      domain = domain.substring(4);
    }
  } catch (e) {
    domain = url;
  }
}
---

<a
  href={`/realizacje/${slug}`}
  class="c3d__card"
  data-color={color}
  data-accent={accent}
  data-slug={slug}
  style="text-decoration: none;"
>
    <div class="c3d__card-inner" style={`--card-accent: ${accent}; cursor: pointer;`}>
        <div class="c3d__logo-wrap">
            <img src={thumbnail} alt={thumbnailAlt} loading="lazy" style="border-radius:10px;">
        </div>
        <p class="c3d__name">{title}</p>
        {domain ? (
            <span class="c3d__domain">{domain}</span>
        ) : (
            <span class="c3d__date">{date}</span>
        )}
    </div>
</a>
