---
interface Props {
  slug: string;
  title: string;
  date: string;
  url?: string;
  color: string;
  accent: string;
  thumbnail: string;
  thumbnailAlt: string;
  mockup?: string;
}

const { slug, title, date, url, color, accent, thumbnail, thumbnailAlt, mockup } = Astro.props;

// Extract clean domain from url
let domain = '';
if (url) {
  try {
    const urlObj = new URL(url);
    domain = urlObj.hostname;
    if (domain.startsWith('www.')) {
      domain = domain.substring(4);
    }
  } catch (e) {
    domain = url;
  }
}
---

<a
  href={`/realizacje/${slug}`}
  class={`project-card ${mockup ? 'has-mockup' : 'no-mockup'}`}
  data-color={color}
  data-accent={accent}
  data-slug={slug}
  style="text-decoration: none;"
>
    <div class="project-card-inner" style={`--card-accent: ${accent};`}>
        <div class="project-mockup-viewport">
            {mockup ? (
                <div class="project-mockup-scroll-wrapper">
                    <img src={mockup} alt={thumbnailAlt} class="project-mockup-img" loading="lazy" decoding="async" onload="this.closest('.project-mockup-viewport').classList.add('loaded')" />
                    <img src={mockup} alt={thumbnailAlt} class="project-mockup-img" aria-hidden="true" loading="lazy" decoding="async" onload="this.closest('.project-mockup-viewport').classList.add('loaded')" />
                </div>
            ) : (
                <div class="project-logo-static-wrapper">
                    <img src={thumbnail} alt={thumbnailAlt} class="project-logo-static" loading="lazy" decoding="async" onload="this.closest('.project-mockup-viewport').classList.add('loaded')" />
                </div>
            )}
            
            <!-- Unified Overlay -->
            <div class="project-card-overlay">
                <div class="project-overlay-content">
                    <div class="project-overlay-text">
                        <h3 class="project-title">{title}</h3>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <span class="project-cursor-cta" aria-hidden="true">
        <span>O projekcie</span>
    </span>
</a>

<script>
    const finePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
    );
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    );

    if (finePointer.matches) {
        document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
            if (card.dataset.cursorFollowerReady === "true") return;
            card.dataset.cursorFollowerReady = "true";

            const viewport = card.querySelector<HTMLElement>(
                ".project-mockup-viewport",
            );
            const follower = card.querySelector<HTMLElement>(
                ".project-cursor-cta",
            );

            if (!viewport || !follower) return;

            let currentX = 0;
            let currentY = 0;
            let targetX = 0;
            let targetY = 0;
            let animationFrame = 0;

            const positionTarget = (event: PointerEvent) => {
                const bounds = viewport.getBoundingClientRect();
                targetX = event.clientX - bounds.left;
                targetY = event.clientY - bounds.top;
            };

            const render = () => {
                const smoothing = reduceMotion.matches ? 1 : 0.16;
                currentX += (targetX - currentX) * smoothing;
                currentY += (targetY - currentY) * smoothing;
                follower.style.transform = `translate3d(${currentX - follower.offsetWidth / 2}px, ${currentY - follower.offsetHeight / 2}px, 0)`;

                if (
                    Math.abs(targetX - currentX) > 0.1 ||
                    Math.abs(targetY - currentY) > 0.1
                ) {
                    animationFrame = requestAnimationFrame(render);
                } else {
                    animationFrame = 0;
                }
            };

            const handlePointerMove = (event: PointerEvent) => {
                positionTarget(event);
                if (!animationFrame) animationFrame = requestAnimationFrame(render);
            };

            viewport.addEventListener("pointerenter", (event) => {
                positionTarget(event);
                currentX = targetX;
                currentY = targetY;
                render();
                card.classList.add("is-cursor-following");
            });

            viewport.addEventListener("pointermove", handlePointerMove);

            viewport.addEventListener("pointerleave", () => {
                card.classList.remove("is-cursor-following");
            });
        });
    }
</script>
