---
import HeroBg from "./HeroBg.astro";
---

<!-- HERO SECTION WITH ASYMMETRIC MANIFESTO -->
<section id="o-nas" class="onas-hero">
    <HeroBg />
    <div class="onas-hero__container">
        <h1 class="onas-hero__title" data-aos="fade-up" data-aos-duration="800">
            Tworzymy strony www z <span
                class="gradient__text text-glow"
                data-text="pasji.">pasji.</span
            ><br />
            Dowozimy jakość drogiej agencji w uczciwej cenie.
        </h1>
        <p
            class="onas-hero__subtitle"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
        >
            Jesteśmy 3-osobowym zespołem pasjonatów programowania, który
            porzucił ciężkie szablony WordPress na rzecz czystego i szybkiego
            kodu. Tworzymy dedykowane witryny, które generują zyski i ładują się
            w mgnieniu oka, co lepiej pozycjonuje je w google.
        </p>
        <div
            class="onas-hero__actions"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="400"
        >
            <a
                href="#trio"
                class="btn-arrow-down"
                aria-label="Przewiń do zespołu"
            >
                <i class="fa-solid fa-chevron-down"></i>
            </a>
        </div>
    </div>
</section>

<!-- MISSION SECTION (WHY WE EXIST / LOCAL ANCHOR) -->
<section class="onas-mission">
    <div class="onas-mission__container">
        <div class="onas-mission__grid">
            <div
                class="onas-mission__visual"
                data-aos="fade-right"
                data-aos-duration="1000"
            >
                <div class="mission-geo-card" id="mission-map-container">
                    <div class="map-placeholder" id="mission-map-placeholder">
                        <div class="map-placeholder__bg"></div>
                        <div class="map-placeholder__content">
                            <h3>Wczytywanie mapy...</h3>
                            <button
                                class="map-placeholder__btn"
                                aria-label="Załaduj mapę Google">Załaduj</button
                            >
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="onas-mission__content"
                data-aos="fade-left"
                data-aos-duration="1000"
                data-aos-delay="200"
            >
                <h2>
                    Lokalne zaufanie, <span class="gradient__text"
                        >globalna jakość</span
                    >
                </h2>
                <p class="accent-paragraph">
                    Dostarczamy dedykowane systemy tworzone od zera w jakości drogiej agencji – bez narzutu kosztownego biura i w uczciwych, lokalnych cenach.
                </p>
                <div class="expandable-text-block">
                    <div class="expandable-content" id="mission-expanded-content">
                        <p>
                            Zauważyliśmy, że wiele firm w regionie opiera biznes na przestarzałych, wolnych szablonach, które zniechęcają klientów na smartfonach. My tworzymy witryny bezawaryjne, ultra szybkie i bezpośrednio przekładające się na zapytania ofertowe.
                        </p>
                    </div>
                    <button type="button" class="btn-text-toggle" aria-expanded="false" aria-controls="mission-expanded-content">
                        <span class="toggle-text">Czytaj więcej</span>
                        <i class="fa-solid fa-chevron-down toggle-icon"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TEAM SECTION (TRIO) -->
<section id="trio" class="onas-trio">
    <div class="onas-trio__container">
        <div
            class="onas-trio__header"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>
                Trzy osoby, <span class="gradient__text">jeden wspólny cel</span
                >
            </h2>
            <p class="section-subtitle">
                Każdy z nas specjalizuje się w innej dziedzinie, dzięki czemu
                Twoja strona jest dopracowana pod każdym kątem – od stabilnej
                architektury backendowej, przez niepowtarzalny design, aż po
                bezkompromisową szybkość.
            </p>
        </div>

        <div class="onas-trio__grid">
            <!-- Member 1: Łukasz -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(var(--accent-cyan-rgb), 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-code"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role">Backend developer</span>
                    <h3 class="team-card__name">Łukasz</h3>
                </div>
                <p class="team-card__desc">
                    Ekspert od baz danych, stabilnej architektury i bezpieczeństwa. Dba o to, by Twoja strona działała bezawaryjnie i była w 100% odporna na ataki.
                </p>
            </div>

            <!-- Member 2: Szymon -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="200"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(var(--accent-blue-rgb), 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role"
                        >UI/UX Designer & Frontend Developer</span
                    >
                    <h3 class="team-card__name">Szymon</h3>
                </div>
                <p class="team-card__desc">
                    Projektuje unikalny wygląd i intuicyjny interfejs. Zamienia wizję Twojego biznesu w stronę, która przyciąga wzrok i świetnie wygląda na każdym smartfonie.
                </p>
            </div>

            <!-- Member 3: Kacper -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(20, 184, 166, 0.15) 0%, transparent 70%);"
                >
