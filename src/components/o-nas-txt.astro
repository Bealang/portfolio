</section>

<!-- THE 4-STEP PROCESS PREVIEW -->
<section class="onas-process">
    <div class="onas-process__container">
        <div
            class="onas-process__header"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>
                Skupiamy się na <span class="gradient__text"
                    >efekcie biznesowym</span
                >
            </h2>
            <p class="section-subtitle">
                Nie zaczynamy od ślepego pisania kodu.
                Szczegóły znajdziesz na stronie <a href="/jak-dzialamy"
                    >jak działamy</a
                >.
            </p>
        </div>

        <div class="process-steps">
            <!-- Step 1 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <div class="step-num">01</div>
                <h3 class="step-title">Analiza</h3>
                <p class="step-desc">
                    Nie piszemy kodu w ciemno. Najpierw poznajemy Twój biznes i
                    konkurencję, aby strona skutecznie zdobywała dla Ciebie
                    klientów.
                </p>
            </div>

            <!-- Step 2 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="200"
            >
                <div class="step-num">02</div>
                <h3 class="step-title">Projekt</h3>
                <p class="step-desc">
                    Tworzymy nowoczesną oprawę wizualną, która wyróżni Twoją
                    firmę i będzie idealnie działać na każdym smartfonie.
                </p>
            </div>

            <!-- Step 3 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <div class="step-num">03</div>
                <h3 class="step-title">Budowa</h3>
                <p class="step-desc">
                    Piszemy czysty, lekki kod bez zbędnych wtyczek. Gwarantuje
                    to błyskawiczne ładowanie strony i bezawaryjność na lata.
                </p>
            </div>

            <!-- Step 4 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="400"
            >
                <div class="step-num">04</div>
                <h3 class="step-title">Wdrożenie</h3>
                <p class="step-desc">
                    Uruchamiamy stronę, podpinamy statystyki i konfigurujemy
                    Google. Dostajesz gotowe narzędzie, które od razu dla Ciebie
                    zarabia.
                </p>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const mapContainer = document.getElementById("mission-map-container");
        const mapPlaceholder = document.getElementById(
            "mission-map-placeholder",
        );
        let loaded = false;

        if (mapContainer && mapPlaceholder) {
            const loadMap = () => {
                if (loaded) return;
                loaded = true;

                // Preconnect Google Maps domains
                const preconnect1 = document.createElement("link");
                preconnect1.rel = "preconnect";
                preconnect1.href = "https://maps.googleapis.com";
                const preconnect2 = document.createElement("link");
                preconnect2.rel = "preconnect";
                preconnect2.href = "https://maps.gstatic.com";
                document.head.appendChild(preconnect1);
                document.head.appendChild(preconnect2);

                // Create map iframe
                const iframe = document.createElement("iframe");
                iframe.src =
                    "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d164284.03881732273!2d19.81539296121519!3d49.95626210607544!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6447d991c045ed81%3A0x80337cb291998748!2sweb2sell%20-%20Tworzenie%20stron%20internetowych!5e0!3m2!1spl!2spl!4v1779532948277!5m2!1spl!2spl";
                iframe.width = "100%";
                iframe.height = "100%";
                iframe.style.border = "0";
                iframe.style.display = "block";
                iframe.title = "Lokalizacja web2sell na mapie Google";
                iframe.setAttribute("allowfullscreen", "");
                iframe.setAttribute(
                    "referrerpolicy",
                    "no-referrer-when-downgrade",
                );
                iframe.className = "mission-map-iframe";

                // Fade out placeholder and inject iframe
                iframe.addEventListener("load", () => {
                    mapPlaceholder.style.opacity = "0";
                    setTimeout(() => {
                        mapPlaceholder.style.display = "none";
                    }, 500);
                });

                mapContainer.appendChild(iframe);

                // Clean up event listeners
                mapContainer.removeEventListener("mouseenter", loadMap);
                mapContainer.removeEventListener("click", loadMap);
                mapContainer.removeEventListener("touchstart", loadMap);
                window.removeEventListener("scroll", checkScroll);
            };

            const checkScroll = () => {
                const rect = mapContainer.getBoundingClientRect();
                if (rect.top < window.innerHeight + 300 && rect.bottom > -300) {
                    loadMap();
                }
            };

            // Event listeners for lazy loading
            mapContainer.addEventListener("mouseenter", loadMap, {
                passive: true,
            });
            mapContainer.addEventListener("click", loadMap, { passive: true });
            mapContainer.addEventListener("touchstart", loadMap, {
                passive: true,
            });
            window.addEventListener("scroll", checkScroll, { passive: true });

            // Proximity detection using IntersectionObserver
            if ("IntersectionObserver" in window) {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                loadMap();
                                observer.disconnect();
                            }
                        });
                    },
                    { rootMargin: "300px" },
                );
                observer.observe(mapContainer);
            }

            // Initial check
            checkScroll();
        }
    })();
</script>

