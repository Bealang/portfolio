    /* ==========================================================================
       ANIMATED EXPANDABLE TEXT BLOCKS
       ========================================================================== */
    .expandable-text-block {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
    }

    .expandable-content {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
        opacity: 0;
    }

    .expandable-content > * {
        overflow: hidden;
    }

    .expandable-content.is-expanded {
        grid-template-rows: 1fr;
        opacity: 1;
    }

    .btn-text-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: var(--radius-pill, 9999px);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--glass-border);
        color: var(--accent-blue);
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition-smooth);
    }

    html[data-theme="light"] .btn-text-toggle {
        background: rgba(0, 0, 0, 0.03);
        color: var(--accent-blue);
    }

    html[data-theme="dark"] .btn-text-toggle {
        color: var(--accent-cyan);
    }

    .btn-text-toggle:hover {
        background: rgba(139, 92, 246, 0.1);
        border-color: var(--card-hover-border);
        transform: translateY(-1px);
    }

    .toggle-icon {
        font-size: 0.75rem;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-text-toggle.is-active .toggle-icon {
        transform: rotate(180deg);
    }
</style>

<script>
    (function () {
        const tabs = document.querySelectorAll('.speed-compare-tab');
        const wpValue = document.getElementById('wp-value');
        const wpBar = document.getElementById('wp-bar');
        const astroValue = document.getElementById('astro-value');
        const astroBar = document.getElementById('astro-bar');
        const explanation = document.getElementById('metric-explanation');

        const metricsData = {
            'load-time': {
                wpValue: '4.8&nbsp;s',
                wpHeight: '100%',
                astroValue: '0.8&nbsp;s',
                astroHeight: '17%',
                explanation: 'Czas ładowania strony bezpośrednio wpływa na pozycję w Google i zadowolenie użytkowników smartfonów.'
            },
            'page-size': {
                wpValue: '2.4&nbsp;MB',
                wpHeight: '100%',
                astroValue: '150&nbsp;KB',
                astroHeight: '6%',
                explanation: 'Lżejsza strona oznacza mniejsze zużycie pakietu danych i błyskawiczne wczytywanie przy słabym sygnale LTE/5G.'
            },
            'lighthouse': {
                wpValue: '45&nbsp;/&nbsp;100',
                wpHeight: '45%',
                astroValue: '99&nbsp;/&nbsp;100',
                astroHeight: '99%',
                explanation: 'Wynik wydajności w teście Google Lighthouse. Wyższy wynik to lepsza widoczność w wyszukiwarce Google.'
            }
        };

        if (tabs && wpValue && wpBar && astroValue && astroBar && explanation) {
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const metric = tab.getAttribute('data-metric');
                    const data = metricsData[metric];
                    if (!data) return;

                    // Update active state for tabs
                    tabs.forEach(t => {
                        t.classList.remove('active');
                        t.setAttribute('aria-selected', 'false');
                    });
                    tab.classList.add('active');
                    tab.setAttribute('aria-selected', 'true');

                    // Update values and heights (vertical columns)
                    wpValue.innerHTML = data.wpValue;
                    wpBar.style.height = data.wpHeight;
                    astroValue.innerHTML = data.astroValue;
                    astroBar.style.height = data.astroHeight;
                    explanation.innerHTML = data.explanation;
                });
            });
        }

        // Expandable text blocks
        const toggleButtons = document.querySelectorAll('.btn-text-toggle');
        toggleButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('aria-controls');
                const content = targetId ? document.getElementById(targetId) : null;
                const textSpan = btn.querySelector('.toggle-text');
                
                if (content) {
                    const isExpanded = content.classList.toggle('is-expanded');
                    btn.classList.toggle('is-active', isExpanded);
                    btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    if (textSpan) {
                        textSpan.textContent = isExpanded ? 'Schowaj tekst' : 'Czytaj więcej';
                    }
                }
            });
        });
    })();
</script>
