---
import HeroBg from "./HeroBg.astro";
---

<!-- HERO SECTION WITH ASYMMETRIC MANIFESTO -->
<section id="o-nas" class="onas-hero">
    <HeroBg />
    <div class="onas-hero__container">
        <h1 class="onas-hero__title" data-aos="fade-up" data-aos-duration="800">
            Tworzymy strony www z <span
                class="gradient__text text-glow"
                data-text="pasji.">pasji.</span
            ><br />
            Dowozimy jakość drogiej agencji w uczciwej cenie.
        </h1>
        <p
            class="onas-hero__subtitle"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
        >
            Jesteśmy 3-osobowym zespołem pasjonatów programowania, który
            porzucił ciężkie szablony WordPress na rzecz czystego i szybkiego
            kodu. Tworzymy dedykowane witryny, które generują zyski i ładują się
            w mgnieniu oka, co lepiej pozycjonuje je w google.
        </p>
        <div
            class="onas-hero__actions"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="400"
        >
            <a
                href="#trio"
                class="btn-arrow-down"
                aria-label="Przewiń do zespołu"
            >
                <i class="fa-solid fa-chevron-down"></i>
            </a>
        </div>
    </div>
</section>

<!-- MISSION SECTION (WHY WE EXIST / LOCAL ANCHOR) -->
<section class="onas-mission">
    <div class="onas-mission__container">
        <div class="onas-mission__grid">
            <div
                class="onas-mission__visual"
                data-aos="fade-right"
                data-aos-duration="1000"
            >
                <div class="mission-geo-card">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d164284.03881732273!2d19.81539296121519!3d49.95626210607544!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6447d991c045ed81%3A0x80337cb291998748!2sweb2sell%20-%20Tworzenie%20stron%20internetowych!5e0!3m2!1spl!2spl!4v1779532948277!5m2!1spl!2spl"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="mission-map-iframe"></iframe>
                </div>
            </div>
            <div
                class="onas-mission__content"
                data-aos="fade-left"
                data-aos-duration="1000"
                data-aos-delay="200"
            >
                <h2>
                    Lokalne zaufanie, <span class="gradient__text"
                        >globalna jakość</span
                    >
                </h2>
                <p class="accent-paragraph">
                    Zauważyliśmy, że ogromna liczba świetnych firm w okolicach
                    powiatu Myślenickiego i Małopolski nie posiada własnej
                    strony internetowej albo opiera swój biznes na
                    przestarzałych szablonach, które zamiast budować prestiż –
                    zniechęcają klientów i wolno działają na smartfonach.
                </p>
                <p>
                    Postanowiliśmy to zmienić. Dostarczamy dedykowane systemy
                    tworzone w 100% od zera. Ponieważ nie posiadamy kosztownego
                    biura i działamy w trójkę, oferujemy jakość premium agencji
                    interaktywnej w dużo atrakcyjniejszych cenach, dostępnych
                    dla lokalnych przedsiębiorców.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- TEAM SECTION (TRIO) -->
<section id="trio" class="onas-trio">
    <div class="onas-trio__container">
        <div
            class="onas-trio__header"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>
                Trzy osoby, <span class="gradient__text">jeden wspólny cel</span
                >
            </h2>
            <p class="section-subtitle">
                Każdy z nas specjalizuje się w innej dziedzinie, dzięki czemu
                Twoja strona jest dopracowana pod każdym kątem – od stabilnej
                architektury backendowej, przez niepowtarzalny design, aż po
                bezkompromisową szybkość.
            </p>
        </div>

        <div class="onas-trio__grid">
            <!-- Member 1: Łukasz -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(236, 72, 153, 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-code"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role">Backend developer</span>
                    <h3 class="team-card__name">Łukasz</h3>
                </div>
                <p class="team-card__desc">
                    Łukasz to ekspert od zaawansowanej struktury stron, baz
                    danych oraz ochrony sieciowej. Projektuje stabilne zaplecze
                    techniczne witryn, dbając o to, by Twoje dane oraz dane
                    Twoich klientów były w 100% bezpieczne. Tworzy rozwiązania
                    gwarantujące płynne działanie strony nawet przy bardzo dużym
                    ruchu, skutecznie chroniąc ją przed awariami oraz atakami
                    hakerskimi.
                </p>
            </div>

            <!-- Member 2: Szymon -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="200"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role"
                        >UI/UX Designer & Frontend Developer</span
                    >
                    <h3 class="team-card__name">Szymon</h3>
                </div>
                <p class="team-card__desc">
                    Szymon zajmuje się projektowaniem nowoczesnego wyglądu stron
                    i dba o ich pełną intuicyjność. Przekłada Twoją wizję
                    biznesu na atrakcyjny interfejs, który przyciąga uwagę
                    klientów i wzbudza zaufanie od pierwszego kliknięcia. Tworzy
                    responsywne strony internetowe, które działają bezbłędnie i
                    wyglądają perfekcyjnie na wszystkich urządzeniach.
                </p>
            </div>

            <!-- Member 3: Kacper -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(20, 184, 166, 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-gauge-high"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role"
                        >Specjalista ds. Optymalizacji i SEO</span
                    >
                    <h3 class="team-card__name">Kacper</h3>
                </div>
                <p class="team-card__desc">
                    Kacper odpowiada za to, aby Twoja strona była widoczna w
                    internecie i działała bez jakichkolwiek opóźnień.
                    Optymalizuje kod źródłowy tak, by witryna ładowała się
                    błyskawicznie, co zapobiega ucieczce potencjalnych klientów
                    i znacznie podnosi skuteczność sprzedaży. Dba o zaawansowane
                    SEO, dzięki czemu Twoja firma zdobywa wysokie pozycje w
                    wyszukiwarce Google.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- TECHNOLOGY COMPARISON SECTION -->
<section class="onas-tech">
    <div class="onas-tech__container">
        <div class="onas-tech__grid">
            <div
                class="onas-tech__content"
                data-aos="fade-right"
                data-aos-duration="1000"
            >
                <h2>
                    Dlaczego porzuciliśmy <span class="gradient__text"
                        >WordPressa i Elementora?</span
                    >
                </h2>
                <p class="accent-paragraph">
                    Większość tradycyjnych agencji reklamowych stawia strony na
                    gotowych, ciężkich szablonach WordPress i edytorach
                    wizualnych typu Elementor czy Divi. Wynik? Powolna strona,
                    która zniechęca klientów na telefonach i generuje wysokie
                    koszty utrzymania.
                </p>
                <p>
                    My idziemy zupełnie inną drogą. Odrzucamy generatory stron i
                    budujemy dedykowane witryny w oparciu o najnowocześniejsze
                    frameworki i architektury. Dzięki wykorzystaniu nowoczesnych
                    i szybkich technologii nasze strony są bezpieczne, odporne
                    na ataki oraz wolne od zbędnych wtyczek. Brak ciężkiego
                    systemu sprawia, że w przyszłości witryna generuje znacznie
                    mniejsze koszty utrzymania — stabilny i bezpieczny hosting
                    kosztuje u nas zaledwie 140 zł rocznie, a nie 400-500 zł,
                    jak w przypadku tradycyjnych rozwiązań. Nasze projekty są
                    ultra szybkie i gotowe na przyszłość.
                </p>
            </div>

            <div
                class="onas-tech__visual"
                data-aos="fade-left"
                data-aos-duration="1000"
                data-aos-delay="200"
            >
                <div class="performance-metric-box">
                    <div class="lighthouse-mockup">
                        <div class="lh-header">
                            <div class="lh-dots">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <span class="lh-url">lighthouse-report: mobile</span
                            >
                        </div>
                        <div class="lh-stats-grid">
                            <div class="lh-stat">
                                <div
                                    class="lh-gauge"
                                    style="--percent: 99; --color: #00cc66;"
                                >
                                    <svg
                                        viewBox="0 0 36 36"
                                        class="circular-chart"
                                    >
                                        <path
                                            class="circle-bg"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                        <path
                                            class="circle"
                                            stroke-dasharray="99, 100"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                    </svg>
                                    <span class="lh-num">99</span>
                                </div>
                                <span class="lh-label">Wydajność</span>
                            </div>
                            <div class="lh-stat">
                                <div
                                    class="lh-gauge"
                                    style="--percent: 100; --color: #00cc66;"
                                >
                                    <svg
                                        viewBox="0 0 36 36"
                                        class="circular-chart"
                                    >
                                        <path
                                            class="circle-bg"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                        <path
                                            class="circle"
                                            stroke-dasharray="100, 100"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                    </svg>
                                    <span class="lh-num">100</span>
                                </div>
                                <span class="lh-label">Dostępność</span>
                            </div>
                            <div class="lh-stat">
                                <div
                                    class="lh-gauge"
                                    style="--percent: 100; --color: #00cc66;"
                                >
                                    <svg
                                        viewBox="0 0 36 36"
                                        class="circular-chart"
                                    >
                                        <path
                                            class="circle-bg"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                        <path
                                            class="circle"
                                            stroke-dasharray="100, 100"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                    </svg>
                                    <span class="lh-num">100</span>
                                </div>
                                <span class="lh-label">Dobre praktyki</span>
                            </div>
                            <div class="lh-stat">
                                <div
                                    class="lh-gauge"
                                    style="--percent: 100; --color: #00cc66;"
                                >
                                    <svg
                                        viewBox="0 0 36 36"
                                        class="circular-chart"
                                    >
                                        <path
                                            class="circle-bg"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                        <path
                                            class="circle"
                                            stroke-dasharray="100, 100"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                        ></path>
                                    </svg>
                                    <span class="lh-num">100</span>
                                </div>
                                <span class="lh-label">SEO</span>
                            </div>
                        </div>
                        <div class="lh-footer-badge">
                            <i class="fa-solid fa-bolt"></i> Nasze strony osiągają
                            wyniki 90+/100 na telefonach komórkowych
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- THE 4-STEP PROCESS PREVIEW -->
<section class="onas-process">
    <div class="onas-process__container">
        <div
            class="onas-process__header"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>
                Skupiamy się na <span class="gradient__text"
                    >efekcie biznesowym</span
                >
            </h2>
            <p class="section-subtitle">
                Nie zaczynamy od ślepego pisania kodu. Każda współpraca to
                precyzyjnie zaplanowany proces, który gwarantuje stworzenie
                strony doskonale odpowiadającej na potrzeby Twoich klientów.
                Szczegóły znajdziesz na stronie <a href="/jak-dzialamy"
                    >jak działamy</a
                >.
            </p>
        </div>

        <div class="process-steps">
            <!-- Step 1 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <div class="step-num">01</div>
                <h3 class="step-title">Analiza</h3>
                <p class="step-desc">
                    Nie piszemy kodu w ciemno. Najpierw poznajemy Twój biznes i
                    konkurencję, aby strona skutecznie zdobywała dla Ciebie
                    klientów.
                </p>
            </div>

            <!-- Step 2 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="200"
            >
                <div class="step-num">02</div>
                <h3 class="step-title">Projekt</h3>
                <p class="step-desc">
                    Tworzymy nowoczesną oprawę wizualną, która wyróżni Twoją
                    firmę i będzie idealnie działać na każdym smartfonie.
                </p>
            </div>

            <!-- Step 3 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <div class="step-num">03</div>
                <h3 class="step-title">Budowa</h3>
                <p class="step-desc">
                    Piszemy czysty, lekki kod bez zbędnych wtyczek. Gwarantuje
                    to błyskawiczne ładowanie strony i bezawaryjność na lata.
                </p>
            </div>

            <!-- Step 4 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="400"
            >
                <div class="step-num">04</div>
                <h3 class="step-title">Wdrożenie</h3>
                <p class="step-desc">
                    Uruchamiamy stronę, podpinamy statystyki i konfigurujemy
                    Google. Dostajesz gotowe narzędzie, które od razu dla Ciebie
                    zarabia.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* ==========================================================================
       BLACK TEXT OVERRIDES AS REQUESTED BY USER (FOR LIGHT THEME)
       ========================================================================== */
    .section-tag,
    .section-subtitle,
    .onas-hero__title,
    .onas-hero__subtitle,
    .onas-mission__content h2,
    .accent-paragraph,
    .onas-mission__content p,
    .onas-trio__header h2,
    .team-card__role,
    .team-card__name,
    .team-card__desc,
    .onas-tech__content h2,
    .onas-tech__content p,
    .onas-process__header h2,
    .step-title,
    .step-desc {
        color: #000 !important;
    }

    /* ==========================================================================
       DARK MODE ADJUSTMENTS TO KEEP TEXT LEGIBLE AND BEAUTIFUL
       ========================================================================== */
    html[data-theme="dark"] .onas-hero__title,
    html[data-theme="dark"] .onas-mission__content h2,
    html[data-theme="dark"] .onas-trio__header h2,
    html[data-theme="dark"] .team-card__name,
    html[data-theme="dark"] .onas-tech__content h2,
    html[data-theme="dark"] .onas-process__header h2,
    html[data-theme="dark"] .step-title {
        color: #ffffff !important;
    }

    html[data-theme="dark"] .section-tag,
    html[data-theme="dark"] .team-card__role {
        color: var(--accent-cyan) !important;
    }

    html[data-theme="dark"] .section-subtitle,
    html[data-theme="dark"] .onas-hero__subtitle,
    html[data-theme="dark"] .accent-paragraph,
    html[data-theme="dark"] .onas-mission__content p,
    html[data-theme="dark"] .team-card__desc,
    html[data-theme="dark"] .onas-tech__content p,
    html[data-theme="dark"] .step-desc {
        color: #e5e7eb !important;
    }

    /* ==========================================================================
       COMMON STYLES & RESET ANCHOR
       ========================================================================== */
    .section-tag {
        display: inline-block;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .section-subtitle {
        max-width: 700px;
        margin: 15px auto 0;
        font-size: 1.25rem;
        line-height: 1.6;
    }

    /* ==========================================================================
       HERO SECTION
       ========================================================================= */
    .onas-hero {
        position: relative;
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 5% 100px;
        text-align: center;
    }

    .onas-hero__container {
        max-width: 900px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }

    .onas-hero__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-primary);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 50px;
        box-shadow: var(--glass-shadow);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        background: var(--accent-cyan);
        border-radius: 50%;
        animation: pulse-dot 1.8s infinite;
    }

    .onas-hero__title {
        font-size: clamp(2rem, 5.5vw, 3.8rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -1.5px;
        margin: 0;
    }

    .onas-hero__subtitle {
        font-size: clamp(1.15rem, 2.5vw, 1.45rem);
        line-height: 1.6;
        color: var(--text-secondary);
        max-width: 760px;
        margin: 0;
    }

    .onas-hero__actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        margin-top: 10px;
    }

    .btn-manifesto {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        font-size: 1rem;
        font-weight: 600;
        color: #fff !important;
        background: linear-gradient(
            135deg,
            rgba(139, 92, 246, 0.95),
            rgba(236, 72, 153, 0.95)
        );
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 50px;
        box-shadow:
            0 10px 30px rgba(139, 92, 246, 0.25),
            var(--glass-shadow);
        text-decoration: none !important;
        transition: var(--transition-smooth);
    }

    html[data-theme="dark"] .btn-manifesto {
        background: linear-gradient(
            135deg,
            rgba(167, 139, 250, 0.95),
            rgba(251, 113, 133, 0.95)
        );
    }

    .btn-manifesto:hover {
        transform: translateY(-4px);
        box-shadow:
            0 15px 35px rgba(139, 92, 246, 0.4),
            var(--glass-shadow);
    }

    .btn-manifesto i {
        font-size: 0.9rem;
        transition: transform 0.3s ease;
    }

    .btn-manifesto:hover i {
        transform: translateX(4px);
    }

    .btn-arrow-down {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: var(--text-secondary);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 50%;
        box-shadow: var(--glass-shadow);
        text-decoration: none !important;
        animation: arrow-float 2.5s infinite ease-in-out;
        transition: var(--transition-smooth);
    }

    .btn-arrow-down:hover {
        color: var(--text-primary);
        border-color: var(--card-hover-border);
    }

    /* ==========================================================================
       MISSION SECTION
       ========================================================================== */
    .onas-mission {
        padding: var(--section-spacing) 5%;
        border-top: 1px solid var(--glass-border);
        background: linear-gradient(
            180deg,
            transparent 0%,
            rgba(139, 92, 246, 0.02) 100%
        );
    }

    .onas-mission__container {
        max-width: var(--container-width);
        margin: 0 auto;
    }

    .onas-mission__grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: clamp(40px, 8vw, 100px);
        align-items: center;
    }

    .onas-mission__visual {
        position: relative;
        display: flex;
        justify-content: center;
    }

