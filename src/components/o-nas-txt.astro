---
import HeroBg from "./HeroBg.astro";
---





<!-- PROBLEM & REFRESH SECTION (WHY WE EXIST / VALUE ANCHOR) -->
<section class="onas-mission">
    <div class="onas-mission__container">
        <div class="onas-mission__grid">
            <div
                class="onas-mission__visual"
                data-aos="fade-right"
                data-aos-duration="1000"
            >
                <div class="confused-man-wrapper" aria-label="Zastanawiasz się, dlaczego Twoja strona nie zdobywa klientów?">
                    <div class="confused-man-body"></div>
                    <div class="confused-man-question"></div>
                </div>
            </div>

            <div
                class="onas-mission__content"
                data-aos="fade-left"
                data-aos-duration="1000"
                data-aos-delay="200"
            >
                <h2>
                    Twoja strona nie zbiera klientów? <br />
                    <span class="gradient__text"
                        >A może przyda jej się odświeżenie?</span
                    >
                </h2>
                <p class="accent-paragraph">
                    Przestarzały szablon WordPress i wolne ładowanie sprawiają, że potencjalny klient rezygnuje w pierwszych 3 sekundach. My tworzymy dedykowane strony od zera – bez ciężkich motywów, bez zbędnych wtyczek i w uczciwej cenie.
                </p>

                <div class="mission-benefits">
                    <div class="benefit-item">
                        <div class="benefit-item__icon">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div class="benefit-item__text">
                            <strong>100% autorski kod bez szablonów</strong>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-item__icon">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div class="benefit-item__text">
                            <strong>Błyskawiczna prędkość i Mobile-First</strong>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-item__icon">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div class="benefit-item__text">
                            <strong>Jakość drogiej agencji w lokalnej cenie</strong>
                        </div>
                    </div>
                </div>

                <div class="mission-cta-wrapper">
                    <a href="#kontakt" class="btn-refresh-cta">
                        <span>Zamów darmową wycenę</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <span class="mission-cta-hint">
                        <i class="fa-regular fa-clock"></i> Odpowiadamy i wyceniamy w 24h
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- HERO SECTION WITH ASYMMETRIC MANIFESTO -->
<section id="o-nas" class="onas-hero">
    <HeroBg />
    <div class="onas-hero__container">
        <h1 class="onas-hero__title" data-aos="fade-up" data-aos-duration="800">
            Tworzymy strony www z <span
                class="gradient__text text-glow"
                data-text="pasji.">pasji.</span
            ><br />
            Dowozimy jakość drogiej agencji w uczciwej cenie.
        </h1>
        <p
            class="onas-hero__subtitle"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
        >
            Jesteśmy 3-osobowym zespołem pasjonatów programowania, który
            porzucił ciężkie szablony WordPress na rzecz czystego i szybkiego
            kodu. 
        </p>
        <div
            class="onas-hero__actions"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="400"
        >
            <a
                href="#trio"
                class="btn-arrow-down"
                aria-label="Przewiń do zespołu"
            >
                <i class="fa-solid fa-chevron-down"></i>
            </a>
        </div>
    </div>
</section>  
<!-- TEAM SECTION (TRIO) -->
<section class="onas-trio">
    <div class="onas-trio__container">
        <div id="trio" class="onas-trio__grid">
            <!-- Member 1: Łukasz -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(var(--accent-cyan-rgb), 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-code"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role">Backend developer</span>
                    <h3 class="team-card__name">Łukasz</h3>
                </div>
                <p class="team-card__desc">
                    Ekspert od baz danych, stabilnej architektury i bezpieczeństwa. Dba o to, by Twoja strona działała bezawaryjnie i była w 100% odporna na ataki.
                </p>
            </div>

            <!-- Member 2: Szymon -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="200"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(var(--accent-blue-rgb), 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role"
                        >UI/UX Designer & Frontend Developer</span
                    >
                    <h3 class="team-card__name">Szymon</h3>
                </div>
                <p class="team-card__desc">
                    Projektuje unikalny wygląd i intuicyjny interfejs. Zamienia wizję Twojego biznesu w stronę, która przyciąga wzrok i świetnie wygląda na każdym smartfonie.
                </p>
            </div>

            <!-- Member 3: Kacper -->
            <div
                class="team-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <div
                    class="team-card__glow"
                    style="background: radial-gradient(circle, rgba(20, 184, 166, 0.15) 0%, transparent 70%);"
                >
                </div>
                <div class="team-card__avatar">
                    <i class="fa-solid fa-gauge-high"></i>
                </div>
                <div class="team-card__meta">
                    <span class="team-card__role"
                        >Specjalista ds. Optymalizacji i SEO</span
                    >
                    <h3 class="team-card__name">Kacper</h3>
                </div>
                <p class="team-card__desc">
                    Odpowiada za bezkompromisową szybkość i widoczność w sieci. Optymalizuje kod pod algorytmy Google, aby klienci bez trudu trafiali na Twoją ofertę.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- TECHNOLOGY COMPARISON SECTION -->
<section class="onas-tech">
    <div class="onas-tech__container">
        <div class="onas-tech__grid">
            <div
                class="onas-tech__content"
                data-aos="fade-right"
                data-aos-duration="1000"
            >
                <h2>
                    Porzuciliśmy<span class="gradient__text"
                        >WordPressa i Elementora.</span
                    >
                </h2>
                <p class="accent-paragraph">
                    Odrzuciliśmy ociężałe szablony WordPress i edytory wizualne. Budujemy witryny w nowoczesnych technologiach, zapewniając szybkość i bezpieczeństwo.
                </p>
                <div class="expandable-text-block">
                    <div class="expandable-content" id="tech-expanded-content">
                        <p>
                            Brak podatnych wtyczek eliminuje ryzyko ataków i awarii. Nasze strony generują też znacznie mniejsze koszty utrzymania – szybki i stabilny hosting kosztuje u nas zaledwie 140 zł rocznie zamiast 400–500 zł w tradycyjnych agencjach.
                        </p>
                    </div>
                    <button type="button" class="btn-text-toggle" aria-expanded="false" aria-controls="tech-expanded-content">
                        <span class="toggle-text">Czytaj więcej</span>
                        <i class="fa-solid fa-chevron-down toggle-icon"></i>
                    </button>
                </div>
            </div>

            <div
                class="onas-tech__visual"
                data-aos="fade-up"
                data-aos-duration="1000"
                data-aos-delay="200"
            >
                <div class="performance-metric-box">
                    <div class="speed-compare-card">
                        <div class="speed-compare-header">
                            <span class="speed-compare-title">Porównanie wydajności strony</span>
                        </div>
                        
                        <!-- Interactive Tabs -->
                        <div class="speed-compare-tabs" role="tablist" aria-label="Metryki wydajności">
                            <button 
                                class="speed-compare-tab active" 
                                role="tab" 
                                aria-selected="true" 
                                data-metric="load-time"
                                aria-label="Porównaj czas ładowania strony"
                            >
                                Ładowanie
                            </button>
                            <button 
                                class="speed-compare-tab" 
                                role="tab" 
                                aria-selected="false" 
                                data-metric="page-size"
                                aria-label="Porównaj wagę strony"
                            >
                                Waga strony
                            </button>
                            <button 
                                class="speed-compare-tab" 
                                role="tab" 
                                aria-selected="false" 
                                data-metric="lighthouse"
                                aria-label="Porównaj wynik Lighthouse"
                            >
                                Wydajność
                            </button>
                        </div>

                        <!-- Chart Content (Vertical Columns) -->
                        <div class="chart-vertical-wrapper" id="speed-chart-content">
                            <!-- WordPress Column -->
                            <div class="chart-col wordpress-col">
                                <span class="value-display wordpress-color" id="wp-value">4.8&nbsp;s</span>
                                <div class="col-bar-container">
                                    <div class="col-bar bar-wordpress" id="wp-bar" style="height: 100%;"></div>
                                </div>
                                <span class="col-label">WordPress</span>
                            </div>

                            <!-- Astro Column -->
                            <div class="chart-col astro-col">
                                <span class="value-display astro-color" id="astro-value">0.8&nbsp;s</span>
                                <div class="col-bar-container">
                                    <div class="col-bar bar-astro" id="astro-bar" style="height: 17%;"></div>
                                </div>
                                <span class="col-label">Strony Astro</span>
                            </div>
                        </div>
                        
                        <div class="speed-compare-footer">
                            <p class="metric-explanation" id="metric-explanation">
                                Czas ładowania strony bezpośrednio wpływa na pozycję w Google i zadowolenie użytkowników smartfonów.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- THE 4-STEP PROCESS PREVIEW -->
<section class="onas-process">
    <div class="onas-process__container">
        <div
            class="onas-process__header"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>
                Skupiamy się na <span class="gradient__text"
                    >efekcie biznesowym</span
                >
            </h2>
            <p class="section-subtitle">
                Nie zaczynamy od ślepego pisania kodu.
                Szczegóły znajdziesz na stronie <a href="/jak-dzialamy"
                    >jak działamy</a
                >.
            </p>
        </div>

        <div class="process-steps">
            <!-- Step 1 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <div class="step-num">01</div>
                <h3 class="step-title">Analiza</h3>
                <p class="step-desc">
                    Nie piszemy kodu w ciemno. Najpierw poznajemy Twój biznes i
                    konkurencję, aby strona skutecznie zdobywała dla Ciebie
                    klientów.
                </p>
            </div>

            <!-- Step 2 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="200"
            >
                <div class="step-num">02</div>
                <h3 class="step-title">Projekt</h3>
                <p class="step-desc">
                    Tworzymy nowoczesną oprawę wizualną, która wyróżni Twoją
                    firmę i będzie idealnie działać na każdym smartfonie.
                </p>
            </div>

            <!-- Step 3 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <div class="step-num">03</div>
                <h3 class="step-title">Budowa</h3>
                <p class="step-desc">
                    Piszemy czysty, lekki kod bez zbędnych wtyczek. Gwarantuje
                    to błyskawiczne ładowanie strony i bezawaryjność na lata.
                </p>
            </div>

            <!-- Step 4 -->
            <div
                class="process-step-card"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="400"
            >
                <div class="step-num">04</div>
                <h3 class="step-title">Wdrożenie</h3>
                <p class="step-desc">
                    Uruchamiamy stronę, podpinamy statystyki i konfigurujemy
                    Google. Dostajesz gotowe narzędzie, które od razu dla Ciebie
                    zarabia.
                </p>
            </div>
        </div>
    </div>
</section>




<style>
    /* ==========================================================================
       BLACK TEXT OVERRIDES AS REQUESTED BY USER (FOR LIGHT THEME)
       ========================================================================== */
    .section-tag,
    .section-subtitle,
    .onas-hero__title,
    .onas-hero__subtitle,
    .onas-mission__content h2,
    .accent-paragraph,
    .onas-mission__content p,
    .team-card__role,
    .team-card__name,
    .team-card__desc,
    .onas-tech__content h2,
    .onas-tech__content p,
    .onas-process__header h2,
    .step-title,
    .step-desc {
        color: #000 !important;
    }

    /* ==========================================================================
       DARK MODE ADJUSTMENTS TO KEEP TEXT LEGIBLE AND BEAUTIFUL
       ========================================================================== */
    html[data-theme="dark"] .onas-hero__title,
    html[data-theme="dark"] .onas-mission__content h2,
    html[data-theme="dark"] .team-card__name,
    html[data-theme="dark"] .onas-tech__content h2,
    html[data-theme="dark"] .onas-process__header h2,
    html[data-theme="dark"] .step-title {
        color: #ffffff !important;
    }

    html[data-theme="dark"] .section-tag,
    html[data-theme="dark"] .team-card__role {
        color: var(--accent-cyan) !important;
    }

    html[data-theme="dark"] .section-subtitle,
    html[data-theme="dark"] .onas-hero__subtitle,
    html[data-theme="dark"] .accent-paragraph,
    html[data-theme="dark"] .onas-mission__content p,
    html[data-theme="dark"] .team-card__desc,
    html[data-theme="dark"] .onas-tech__content p,
    html[data-theme="dark"] .step-desc {
        color: #e5e7eb !important;
    }

    /* ==========================================================================
       COMMON STYLES & RESET ANCHOR
       ========================================================================== */
    .section-tag {
        display: inline-block;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .section-subtitle {
        max-width: 700px;
        margin: 15px auto 0;
        font-size: 1.25rem;
        line-height: 1.6;
    }

    /* ==========================================================================
       HERO SECTION
       ========================================================================= */
    .onas-hero {
        position: relative;
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 72px 5% 48px;
        text-align: center;
    }

    .onas-hero__container {
        max-width: 900px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }

    .onas-hero__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-primary);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 50px;
        box-shadow: var(--glass-shadow);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        background: var(--accent-cyan);
        border-radius: 50%;
        animation: pulse-dot 1.8s infinite;
    }

    .onas-hero__title {
        font-size: clamp(2rem, 5.5vw, 3.8rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -1.5px;
        margin: 0;
    }

    .onas-hero__subtitle {
        font-size: clamp(1.15rem, 2.5vw, 1.45rem);
        line-height: 1.6;
        color: var(--text-secondary);
        max-width: 760px;
        margin: 0;
    }

    .onas-hero__actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        margin-top: 10px;
    }

    .btn-manifesto {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        font-size: 1rem;
        font-weight: 600;
        color: #fff !important;
        background: linear-gradient(
            135deg,
            rgba(var(--accent-blue-rgb), 0.95),
            rgba(var(--accent-cyan-rgb), 0.95)
        );
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 50px;
        box-shadow:
            0 10px 30px rgba(var(--accent-blue-rgb), 0.25),
            var(--glass-shadow);
        text-decoration: none !important;
        transition: var(--transition-smooth);
    }

    html[data-theme="dark"] .btn-manifesto {
        background: linear-gradient(
            135deg,
            rgba(var(--accent-blue-rgb), 0.95),
            rgba(var(--accent-cyan-rgb), 0.95)
        );
    }

    .btn-manifesto:hover {
        transform: translateY(-4px);
        box-shadow:
            0 15px 35px rgba(var(--accent-blue-rgb), 0.4),
            var(--glass-shadow);
    }

    .btn-manifesto i {
        font-size: 0.9rem;
        transition: transform 0.3s ease;
    }

    .btn-manifesto:hover i {
        transform: translateX(4px);
    }

    .btn-arrow-down {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: var(--text-secondary);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 50%;
        box-shadow: var(--glass-shadow);
        text-decoration: none !important;
        animation: arrow-float 2.5s infinite ease-in-out;
        transition: var(--transition-smooth);
    }

    .btn-arrow-down:hover {
        color: var(--text-primary);
        border-color: var(--card-hover-border);
    }

    @media (prefers-reduced-motion: reduce) {
        .btn-arrow-down {
            animation: none;
        }
    }

    /* ==========================================================================
       MISSION SECTION
       ========================================================================== */
    .onas-mission {
        padding: var(--section-spacing) 5%;
        border-top: 1px solid var(--glass-border);
        background: linear-gradient(
            180deg,
            transparent 0%,
            rgba(var(--accent-blue-rgb), 0.02) 100%
        );
    }

    .onas-mission__container {
        max-width: var(--container-width);
        margin: 0 auto;
    }

    .onas-mission__grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: clamp(40px, 8vw, 100px);
        align-items: center;
    }

    .onas-mission__visual {
        position: relative;
        display: flex;
        justify-content: center;
    }

    /* Confused Man Visual Icon Component */
    .confused-man-wrapper {
        position: relative;
        width: clamp(220px, 30vw, 320px);
        aspect-ratio: 475 / 508;
    }

    .confused-man-body,
    .confused-man-question {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        background-color: #0f172a;
        transition: background-color 0.3s ease;
    }

    .confused-man-body {
        -webkit-mask: url('/assets/icons/confused-man-body.webp') no-repeat center / contain;
        mask: url('/assets/icons/confused-man-body.webp') no-repeat center / contain;
    }

    .confused-man-question {
        -webkit-mask: url('/assets/icons/confused-man-question.webp') no-repeat center / contain;
        mask: url('/assets/icons/confused-man-question.webp') no-repeat center / contain;
        transform-origin: 86.6% 19%;
        animation: questionFloat 3.2s ease-in-out infinite;
        will-change: transform;
    }

    html[data-theme="light"] .confused-man-body,
    html[data-theme="light"] .confused-man-question {
        background-color: #0f172a;
    }

    html[data-theme="dark"] .confused-man-body,
    html[data-theme="dark"] .confused-man-question {
        background-color: #ffffff;
    }

    @keyframes questionFloat {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }
        25% {
            transform: translateY(-5px) rotate(-3deg);
        }
        50% {
            transform: translateY(-9px) rotate(2deg);
        }
        75% {
            transform: translateY(-4px) rotate(-1deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .confused-man-question {
            animation: none;
        }
    }

    @supports not (mask: url('/assets/icons/confused-man-body.webp')) {
        .confused-man-body {
            background-image: url('/assets/icons/confused-man-body-dark.webp');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }
        .confused-man-question {
            background-image: url('/assets/icons/confused-man-question-dark.webp');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }
        html[data-theme="dark"] .confused-man-body {
            background-image: url('/assets/icons/confused-man-body-white.webp');
        }
        html[data-theme="dark"] .confused-man-question {
            background-image: url('/assets/icons/confused-man-question-white.webp');
        }
    }


    /* Mission Benefits & CTA */
    .mission-benefits {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 4px 0 8px;
    }

    .benefit-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .benefit-item__icon {
        width: 22px;
        height: 22px;
        min-width: 22px;
        border-radius: 6px;
        background: rgba(var(--accent-blue-rgb), 0.12);
        color: var(--accent-cyan);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        margin-top: 3px;
    }

    html[data-theme="light"] .benefit-item__icon {
        background: rgba(var(--accent-blue-rgb), 0.1);
        color: var(--accent-blue);
    }

    .benefit-item__text {
        font-size: 0.95rem;
