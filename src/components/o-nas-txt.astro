    }

    .expandable-content.is-expanded {
        grid-template-rows: 1fr;
        opacity: 1;
    }

    .btn-text-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: var(--radius-pill, 9999px);
        background: rgba(255, 255, 255, 0.04);
