---
// ContactForm component - EmailJS integration
---

<section id="kontakt">
    <div class="contact__container">
        <div class="contact__featured">
            <div
                class="featured__header"
                data-aos="fade-right"
                data-aos-duration="1000"
                data-aos-delay="200"
            >
                <h2>
                    Zamów <span class="gradient__text">darmową</span> wycenę
                </h2>
                <p>
                    Skontaktuj się z nami poprzez formularz kontaktowy, bądź
                    poniższy adres e-mail/nr. telefonu , aby otrzymać
                    indywidualną wycenę dla swojego projektu. Zazwyczaj
                    odpowiadamy w ciągu 24 godzin.
                </p>
            </div>

            <div
                class="featured__cards"
                data-aos="fade-right"
                data-aos-duration="1000"
                data-aos-delay="300"
            >
                <a
                    href="mailto:kontakt@web2sell.pl"
                    class="featured__card email"
                >
                    <div class="card__glow"></div>
                    <i class="fa-solid fa-envelope"></i>
                    <div class="card__content">
                        <span class="card__title"
                            >Kontakt przez e-mail</span
                        >
                        <span class="card__value">kontakt@web2sell.pl</span>
                    </div>
                    <i class="fa-solid fa-arrow-right card__arrow"></i>
                </a>
                <a href="tel:+48530315860" class="featured__card phone">
                    <div class="card__glow"></div>
                    <i class="fa-solid fa-phone"></i>
                    <div class="card__content">
                        <span class="card__title">Kontakt telefoniczny/SMS</span
                        >
                        <span class="card__value">+48 530 315 860</span>
                    </div>
                    <i class="fa-solid fa-arrow-right card__arrow"></i>
                </a>
            </div>
        </div>

        <div id="kontakt__formularz">
            <form id="kontakt__form" novalidate>
                <div id="kontakt__formularz__lewy">
                    <div class="form__group">
                        <label for="imie" class="kontakt__formularz__label"
                            >Imię i Nazwisko <span class="required">*</span
                            ></label
                        >
                        <input
                            type="text"
                            id="imie"
                            name="imie"
                            placeholder="Jan Kowalski"
                            autocomplete="name"
                        />
                        <span class="form__error" id="imie__error"></span>
                    </div>
                    <div class="form__group">
                        <label for="usluga" class="kontakt__formularz__label"
                            >Wstępna usługa <span class="required">*</span
                            ></label
                        >
                        <select id="usluga" name="usluga">
                            <option value="Nie wiem. Chcę to ustalić" selected
                                >Nie wiem. Chcę to ustalić</option
                            >
                            <option value="OnePage (Szybki start w sieci)"
                                >OnePage (Szybki start w sieci)</option
                            >
                            <option
                                value="Wizytówka Multi-Page (Budowa autorytetu)"
                                >Wizytówka Multi-Page (Budowa autorytetu)</option
                            >
                            <option value="Wizytówka + CMS (Dynamiczne treści)"
                                >Wizytówka + CMS (Dynamiczne treści)</option
                            >
                            <option
                                value='System Dedykowany (Rozwiązania "Full Custom")'
                                >System Dedykowany (Rozwiązania "Full Custom")</option
                            >
                        </select>
                        <span class="form__error" id="usluga__error"></span>
                    </div>
                    <div class="form__group">
                        <label
                            for="kontakt_info"
                            class="kontakt__formularz__label"
                            >Adres e-mail <span class="required">*</span></label
                        >
                        <input
                            type="email"
                            id="kontakt_info"
                            name="kontakt"
                            placeholder="twoj@email.com"
                            autocomplete="email"
                        />
                        <span class="form__error" id="kontakt__error"></span>
                    </div>
                </div>
                <div id="kontakt__formularz__prawy">
                    <div class="form__group">
                        <label for="tresc" class="kontakt__formularz__label"
                            >Treść wiadomości <span class="required">*</span
                            ></label
                        >
                        <textarea
                            id="tresc"
                            name="tresc"
                            placeholder="Słuchamy Cię! Opisz, w czym rzecz. Jeśli wolisz, żebyśmy zadzwonili, dopisz swój numer telefonu – tak będzie szybciej."
                        ></textarea>
                        <span class="form__error" id="tresc__error"></span>
                    </div>
                    <div class="form__group rodo__group">
                        <label class="rodo__label">
                            <input
                                type="checkbox"
                                id="rodo"
                                name="rodo"
                                required
                            />
                            <span class="rodo__checkmark"></span>
                            <span class="rodo__text"
                                >Wyrażam zgodę na przetwarzanie moich danych
                                osobowych w celu udzielenia odpowiedzi na
                                zapytanie. <a href="/polityka"
                                    >Polityka prywatności</a
                                ></span
                            >
                        </label>
                        <span class="form__error" id="rodo__error"></span>
                    </div>
                    <div class="form__group rodo__group">
                        <label class="rodo__label">
                            <input
                                type="checkbox"
                                id="zasady"
                                name="zasady"
                                required
                            />
                            <span class="rodo__checkmark"></span>
                            <span class="rodo__text"
                                >Zapoznałem się z <a href="/zasady-wspolpracy"
                                    >zasadami współpracy</a
                                > i akceptuję ich postanowienia. <span class="required">*</span></span
                            >
                        </label>
                        <span class="form__error" id="zasady__error"></span>
                    </div>
                </div>
                <button
                    type="submit"
                    id="form__submit"
                    class="form__submit__btn"
                >
                    <span class="btn__text">Wyślij wiadomość</span>
                    <i class="fa-solid fa-paper-plane btn__icon"></i>
                    <span class="btn__loading" style="display:none;"
                        ><i class="fa-solid fa-spinner fa-spin"></i>
                        Wysyłanie...</span
                    >
                </button>
            </form>
        </div>
    </div>
</section>
<div id="form__notification" class="form__notification" style="display:none;">
    <i class="notification__icon"></i>
    <span class="notification__text"></span>
</div>

<script>
    // ============================================================
    // EMAILJS KONFIGURACJA & Dynamic Loader
    // ============================================================
    const EMAILJS_PUBLIC_KEY = "RZK1nw4Vj1eZiggfr";
    const EMAILJS_SERVICE_ID = "service_dnkrj6g";
    const EMAILJS_TEMPLATE_ID = "template_h5b0n9s";

    let emailjsLoaded = false;
    let loadingPromise: Promise<void> | null = null;

    function loadEmailJS(): Promise<void> {
        if (emailjsLoaded) return Promise.resolve();
        if (loadingPromise) return loadingPromise;

        loadingPromise = new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = "https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js";
            script.async = true;
            script.onload = () => {
                emailjsLoaded = true;
                if ((window as any).emailjs) {
                    (window as any).emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
                }
                resolve();
            };
            script.onerror = () => {
                loadingPromise = null;
                reject(new Error("Nie udało się załadować biblioteki EmailJS."));
            };
            document.body.appendChild(script);
        });

        return loadingPromise;
    }

    // ─── Elementy DOM ────────────────────────────────────────────
    const form = document.getElementById("kontakt__form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("form__submit") as HTMLButtonElement | null;
    const btnText = submitBtn?.querySelector(".btn__text") as HTMLElement | null;
    const btnIcon = submitBtn?.querySelector(".btn__icon") as HTMLElement | null;
    const btnLoading = submitBtn?.querySelector(".btn__loading") as HTMLElement | null;
    const notification = document.getElementById("form__notification") as HTMLElement | null;
    const notifIcon = notification?.querySelector(".notification__icon") as HTMLElement | null;
    const notifText = notification?.querySelector(".notification__text") as HTMLElement | null;

    // Auto-wybór pakietu na podstawie parametru z URL (?pakiet=...)
    (function () {
        const urlParams = new URLSearchParams(window.location.search);
        const pakiet = urlParams.get('pakiet');
        const selectEl = document.getElementById("usluga") as HTMLSelectElement | null;
        if (pakiet && selectEl) {
            if (pakiet === 'onepage') {
                selectEl.value = "OnePage (Szybki start w sieci)";
            } else if (pakiet === 'multipage') {
                selectEl.value = "Wizytówka Multi-Page (Budowa autorytetu)";
            } else if (pakiet === 'cms') {
                selectEl.value = "Wizytówka + CMS (Dynamiczne treści)";
            } else if (pakiet === 'system') {
                selectEl.value = 'System Dedykowany (Rozwiązania "Full Custom")';
            }
        }
    })();

    // Load EmailJS dynamically when user interacts with the form
    if (form) {
        const triggerDynamicLoad = () => {
            loadEmailJS().catch(err => console.error("EmailJS lazy load error:", err));
            // Remove event listeners so we only try to load once
            form.removeEventListener("focusin", triggerDynamicLoad);
            form.removeEventListener("mouseenter", triggerDynamicLoad);
            form.removeEventListener("touchstart", triggerDynamicLoad);
        };

        form.addEventListener("focusin", triggerDynamicLoad, { passive: true });
        form.addEventListener("mouseenter", triggerDynamicLoad, { passive: true });
        form.addEventListener("touchstart", triggerDynamicLoad, { passive: true });
    }

    // ─── Walidacja pól ───────────────────────────────────────────
    function showError(fieldId: string, message: string) {
        const el = document.getElementById(fieldId + "__error");
        const input =
            document.getElementById(fieldId) ||
            document.querySelector('[name="' + fieldId + '"]');
        if (el) {
            el.textContent = message;
            el.classList.add("visible");
        }
        if (input) input.classList.add("input--error");
    }

    function clearError(fieldId: string) {
        const el = document.getElementById(fieldId + "__error");
        const input =
            document.getElementById(fieldId) ||
            document.querySelector('[name="' + fieldId + '"]');
        if (el) {
            el.textContent = "";
            el.classList.remove("visible");
        }
        if (input) input.classList.remove("input--error");
    }

    function validateForm() {
        let valid = true;

        const imieEl = document.getElementById("imie") as HTMLInputElement | null;
        const imie = imieEl ? imieEl.value.trim() : "";
        if (!imie) {
            showError("imie", "Imię i nazwisko są wymagane.");
            valid = false;
        } else if (imie.split(" ").filter(Boolean).length < 2) {
            showError("imie", "Wpisz imię oraz nazwisko.");
            valid = false;
        } else {
            clearError("imie");
        }

        const kontaktEl = document.getElementById("kontakt_info") as HTMLInputElement | null;
        const kontakt = kontaktEl ? kontaktEl.value.trim() : "";
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!kontakt) {
            showError("kontakt", "Podaj adres e-mail.");
            valid = false;
        } else if (!emailRegex.test(kontakt)) {
            showError("kontakt", "Podaj poprawny adres e-mail.");
            valid = false;
        } else {
            clearError("kontakt");
        }

        const trescEl = document.getElementById("tresc") as HTMLTextAreaElement | null;
        const tresc = trescEl ? trescEl.value.trim() : "";
        if (!tresc || tresc.length < 10) {
            showError("tresc", "Wpisz wiadomość (min. 10 znaków).");
            valid = false;
        } else {
            clearError("tresc");
        }

        const rodoEl = document.getElementById("rodo") as HTMLInputElement | null;
        const rodo = rodoEl ? rodoEl.checked : false;
        if (!rodo) {
            showError("rodo", "Wymagana zgoda na przetwarzanie danych.");
            valid = false;
        } else {
            clearError("rodo");
        }

        const zasadyEl = document.getElementById("zasady") as HTMLInputElement | null;
        const zasady = zasadyEl ? zasadyEl.checked : false;
        if (!zasady) {
            showError("zasady", "Wymagana jest akceptacja zasad współpracy.");
            valid = false;
        } else {
            clearError("zasady");
        }

        return valid;
    }

    // ─── Resetowanie błędów na bieżąco ───────────────────────────
    ["imie", "kontakt_info", "tresc"].forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        const errorId = id === "kontakt_info" ? "kontakt" : id;
        el.addEventListener("input", () => clearError(errorId));
    });
    document
        .getElementById("usluga")
        ?.addEventListener("change", () => clearError("usluga"));
    document
        .getElementById("rodo")
        ?.addEventListener("change", () => clearError("rodo"));
    document
        .getElementById("zasady")
        ?.addEventListener("change", () => clearError("zasady"));

    // ─── Powiadomienie ────────────────────────────────────────────
    function showNotification(type: "success" | "error", message: string) {
        if (!notification || !notifIcon || !notifText) return;
        notification.className = "form__notification " + type;
        notifIcon.className =
            "notification__icon fa-solid " +
            (type === "success" ? "fa-check-circle" : "fa-circle-exclamation");
        notifText.textContent = message;
        notification.style.display = "flex";

        setTimeout(() => {
            notification.style.display = "none";
        }, 6000);
    }

    // ─── Wysyłanie formularza ─────────────────────────────────────
    function setLoading(loading: boolean) {
        if (!submitBtn || !btnText || !btnIcon || !btnLoading) return;
        if (loading) {
            btnText.style.display = "none";
            btnIcon.style.display = "none";
            btnLoading.style.display = "inline-flex";
            submitBtn.disabled = true;
        } else {
            btnText.style.display = "inline";
            btnIcon.style.display = "inline";
            btnLoading.style.display = "none";
            submitBtn.disabled = false;
        }
    }

    form?.addEventListener("submit", async function (e) {
        e.preventDefault();

        const lastSentTime = localStorage.getItem("lastEmailSentTime");
        const cooldownTime = 2 * 60 * 1000;

        if (lastSentTime) {
            const timeElapsed = Date.now() - parseInt(lastSentTime, 10);
            if (timeElapsed < cooldownTime) {
                const timeLeft = Math.ceil((cooldownTime - timeElapsed) / 1000);
                const minutesLeft = Math.floor(timeLeft / 60);
                const secondsLeft = timeLeft % 60;
                const timeString =
                    minutesLeft > 0
                        ? `${minutesLeft}m ${secondsLeft}s`
                        : `${secondsLeft}s`;
                showNotification(
                    "error",
                    `⏳ Odczekaj jeszcze ${timeString} przed wysłaniem kolejnej wiadomości.`,
                );
                return;
            }
        }

        if (!validateForm()) return;

        setLoading(true);

        try {
            // Ensure EmailJS is fully loaded
            await loadEmailJS();

            if (!(window as any).emailjs) {
                throw new Error("Biblioteka EmailJS nie została załadowana.");
            }

            const imieEl = document.getElementById("imie") as HTMLInputElement | null;
            const uslugaEl = document.getElementById("usluga") as HTMLSelectElement | null;
            const kontaktEl = document.getElementById("kontakt_info") as HTMLInputElement | null;
            const trescEl = document.getElementById("tresc") as HTMLTextAreaElement | null;

            const templateParams = {
                imie: imieEl ? imieEl.value.trim() : "",
                nazwisko:
                    " — Usługa: " + (uslugaEl ? uslugaEl.value.trim() : ""),
                kontakt: kontaktEl ? kontaktEl.value.trim() : "",
                tresc: trescEl ? trescEl.value.trim() : "",
            };

            (window as any).emailjs
                .send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams, {
                    publicKey: EMAILJS_PUBLIC_KEY
                })
                .then(() => {
                    setLoading(false);
                    localStorage.setItem(
                        "lastEmailSentTime",
                        Date.now().toString(),
                    );
                    window.location.href = '/dziekujemy';
                })
                .catch((error: any) => {
                    setLoading(false);
                    console.error("EmailJS error:", error);
                    showNotification(
                        "error",
                        "❌ Nie udało się wysłać wiadomości. Napisz bezpośrednio na kontakt@web2sell.pl",
                    );
                });
        } catch (error: any) {
            setLoading(false);
            console.error("EmailJS submit error:", error);
            showNotification(
                "error",
                `❌ Błąd: ${error.message || "Nie udało się załadować formularza. Napisz bezpośrednio na kontakt@web2sell.pl"}`
            );
        }
    });

    // Lightweight IntersectionObserver slide-in from right animation for the form block
    // to prevent lag on less-performant laptops (uses GPU-accelerated transition)
    (function() {
        const formBlock = document.getElementById("kontakt__formularz");
        if (formBlock && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            formBlock.style.opacity = "0";
            formBlock.style.transform = "translateX(50px)";
            formBlock.style.willChange = "transform, opacity";
            formBlock.style.transition = "opacity 1.2s cubic-bezier(0.25, 1, 0.5, 1), transform 1.2s cubic-bezier(0.25, 1, 0.5, 1)";
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        formBlock.style.opacity = "1";
                        formBlock.style.transform = "translateX(0)";
                        // Clean up inline styles once transition is done to free GPU memory and prevent scroll lag
                        setTimeout(() => {
                            formBlock.style.opacity = "";
                            formBlock.style.transform = "";
                            formBlock.style.transition = "";
                            formBlock.style.willChange = "";
                        }, 1200);
                        observer.unobserve(formBlock);
                    }
                });
            }, { 
                rootMargin: "0px 0px -50px 0px",
                threshold: 0.05 
            });
            observer.observe(formBlock);
        }
    })();
</script>
