    @media (max-width: 768px) {
        .email-error-content {
            padding: 32px 24px;
        }
        .email-error-close {
            top: 16px;
            left: 16px;
        }
    }
</style>

<script>
    // ============================================================
    // EMAILJS KONFIGURACJA & Dynamic Loader
    // ============================================================
    const EMAILJS_PUBLIC_KEY = "RZK1nw4Vj1eZiggfr";
    const EMAILJS_SERVICE_ID = "service_dnkrj6g";
    const EMAILJS_TEMPLATE_ID = "template_h5b0n9s";

    let emailjsLoaded = false;
    let loadingPromise: Promise<void> | null = null;

    function loadEmailJS(): Promise<void> {
        if (emailjsLoaded) return Promise.resolve();
        if (loadingPromise) return loadingPromise;

        loadingPromise = new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src =
                "https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js";
            script.async = true;
            script.onload = () => {
                emailjsLoaded = true;
                if ((window as any).emailjs) {
                    (window as any).emailjs.init({
                        publicKey: EMAILJS_PUBLIC_KEY,
                    });
                }
                resolve();
            };
            script.onerror = () => {
                loadingPromise = null;
                reject(
                    new Error("Nie udało się załadować biblioteki EmailJS."),
                );
            };
            document.body.appendChild(script);
        });

        return loadingPromise;
    }

    // ─── Elementy DOM Wizarda ────────────────────────────────────
    const form = document.getElementById(
        "wizard-form",
    ) as HTMLFormElement | null;
    const stepItems = document.querySelectorAll(".wizard-step-item");
    const panels = document.querySelectorAll(".wizard-panel");

    // Paski postępu
    const progressFill = document.getElementById("progress-fill");
    const globalProgressFill = document.getElementById("global-progress-fill");
    const globalProgressStepText = document.getElementById(
        "global-progress-step-text",
    );
    const globalProgressPercent = document.getElementById(
        "global-progress-percent",
    );

    // Przyciski nawigacyjne
    const prevBtn = document.getElementById(
        "prev-btn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
        "next-btn",
    ) as HTMLButtonElement | null;
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement | null;

    // Pola formularza
    const inputUsluga = document.getElementById(
        "usluga",
    ) as HTMLSelectElement | null;
    const inputBudzet = document.getElementById(
        "budzet",
    ) as HTMLInputElement | null;
    const budzetKwotaEl = document.getElementById(
        "budzet_kwota",
    ) as HTMLInputElement | null;
    const walutaEl = document.getElementById(
        "waluta",
    ) as HTMLSelectElement | null;

    // Powiadomienie
    const notification = document.getElementById(
        "form__notification",
    ) as HTMLElement | null;

    let currentStep = 1;
    const totalSteps = 4;
    let maxStepReached = 1;

    // Krok po kroku tytuły
    const stepNames = [
        "Przedstaw się nam",
        "Wybierz usługę i budżet",
        "Opisz swój biznes",
        "Dane kontaktowe",
    ];

    // Load EmailJS dynamically when user interacts with form
    if (form) {
        const triggerLoad = () => {
            loadEmailJS().catch((err) =>
                console.error("EmailJS lazy load error:", err),
            );
            form.removeEventListener("focusin", triggerLoad);
            form.removeEventListener("mouseenter", triggerLoad);
            form.removeEventListener("touchstart", triggerLoad);
        };
        form.addEventListener("focusin", triggerLoad, { passive: true });
        form.addEventListener("mouseenter", triggerLoad, { passive: true });
        form.addEventListener("touchstart", triggerLoad, { passive: true });
    }

    // ============================================================
    // DYNAMICZNE ELEMENTY WIZARDU: KAFELKI I WALUTA
    // ============================================================

    // Kafelki usług
    const serviceTiles = document.querySelectorAll(".service-tile");
    serviceTiles.forEach((tile) => {
        tile.addEventListener("click", () => {
            serviceTiles.forEach((t) => t.classList.remove("selected"));
            tile.classList.add("selected");

            const value = tile.getAttribute("data-value");
            if (inputUsluga && value) {
                inputUsluga.value = value;
                clearError("usluga");
            }
        });
    });

    // Auto-wybór pakietu na podstawie parametru z URL (?pakiet=...)
    (function () {
        const urlParams = new URLSearchParams(window.location.search);
        const pakiet = urlParams.get("pakiet");
        if (pakiet && inputUsluga) {
            let matchedValue = "";
            if (pakiet === "onepage") {
                matchedValue = "OnePage (Szybki start w sieci)";
            } else if (pakiet === "multipage") {
                matchedValue = "Wizytówka Multi-Page (Budowa autorytetu)";
            } else if (pakiet === "cms") {
                matchedValue = "Wizytówka + CMS (Dynamiczne treści)";
            } else if (pakiet === "system") {
                matchedValue = 'System Dedykowany (Rozwiązania "Full Custom")';
            }

            if (matchedValue) {
                inputUsluga.value = matchedValue;
                const activeTile = document.querySelector(
                    `.service-tile[data-value="${matchedValue}"]`,
                );
                if (activeTile) {
                    serviceTiles.forEach((t) => t.classList.remove("selected"));
                    activeTile.classList.add("selected");
                }
            }
        } else {
            // Domyślnie zaznacz "Potrzebuję pomocy doradcy"
            const defaultTile = document.querySelector(
                '.service-tile[data-value="Potrzebuję pomocy doradcy"]',
            );
            if (defaultTile && inputUsluga) {
                defaultTile.classList.add("selected");
                inputUsluga.value = "Potrzebuję pomocy doradcy";
            }
        }
    })();

    // Czyszczenie błędów przy zmianie budżetu lub waluty
    if (budzetKwotaEl) {
        budzetKwotaEl.addEventListener("input", () =>
            clearError("budzet_kwota"),
        );
    }
    if (walutaEl) {
        walutaEl.addEventListener("change", () => clearError("budzet_kwota"));
    }

    // ============================================================
    // WALIDACJA I ZARZĄDZANIE KROKAMI
    // ============================================================

    function showError(fieldId: string, message: string) {
        const el = document.getElementById(fieldId + "__error");
        const input =
            document.getElementById(fieldId) ||
            document.querySelector('[name="' + fieldId + '"]');
        if (el) {
            el.textContent = message;
            el.classList.add("visible");
        }
        if (input) input.classList.add("input--error");
    }

    function clearError(fieldId: string) {
        const el = document.getElementById(fieldId + "__error");
        const input =
            document.getElementById(fieldId) ||
            document.querySelector('[name="' + fieldId + '"]');
        if (el) {
            el.textContent = "";
            el.classList.remove("visible");
        }
        if (input) input.classList.remove("input--error");
    }

    // Walidacja konkretnego kroku
    function validateStep(step: number): boolean {
        let valid = true;

        if (step === 1) {
            const imieEl = document.getElementById(
                "imie",
            ) as HTMLInputElement | null;
            const imie = imieEl ? imieEl.value.trim() : "";
            if (!imie) {
                showError("imie", "Imię i nazwisko są wymagane.");
                valid = false;
            } else if (imie.split(" ").filter(Boolean).length < 2) {
                showError("imie", "Proszę podać imię oraz nazwisko.");
                valid = false;
            } else {
                clearError("imie");
            }
        }

        if (step === 2) {
            // Wstępna usługa
            if (inputUsluga && !inputUsluga.value) {
                showError("usluga", "Proszę wybrać wstępną usługę.");
                valid = false;
            } else {
                clearError("usluga");
            }

            // Budżet numeryczny, minimalnie 1000
            const budzetKwotaVal = budzetKwotaEl
                ? budzetKwotaEl.value.trim()
                : "";
            const walutaVal = walutaEl ? walutaEl.value : "zł";

            if (!budzetKwotaVal) {
                showError("budzet_kwota", "Proszę wpisać kwotę budżetu.");
                valid = false;
            } else {
                const kwotaNum = parseFloat(budzetKwotaVal);
                if (isNaN(kwotaNum) || kwotaNum < 1000) {
                    showError(
                        "budzet_kwota",
                        "Minimalny budżet projektu to 1000 zł / EUR.",
                    );
                    valid = false;
                } else {
                    clearError("budzet_kwota");
                    if (inputBudzet) {
                        // Aktualizacja ukrytego pola na wartość łączną
                        inputBudzet.value = `${kwotaNum} ${walutaVal}`;
                    }
                }
            }
        }

        if (step === 3) {
            // Branża
            const branzaEl = document.getElementById(
                "branza",
            ) as HTMLInputElement | null;
            if (!branzaEl || !branzaEl.value.trim()) {
                showError("branza", "Wpisz branżę w jakiej działa firma.");
                valid = false;
            } else {
                clearError("branza");
            }

            // Opis firmy
            const opisEl = document.getElementById(
                "opis_firmy",
            ) as HTMLTextAreaElement | null;
            if (!opisEl || opisEl.value.trim().length < 10) {
                showError(
                    "opis_firmy",
                    "Opisz krótko profil firmy (min. 10 znaków).",
                );
                valid = false;
            } else {
                clearError("opis_firmy");
            }

            // Zakres strony
            const zakresEl = document.getElementById(
                "zakres_strony",
            ) as HTMLTextAreaElement | null;
            if (!zakresEl || zakresEl.value.trim().length < 15) {
                showError(
                    "zakres_strony",
                    "Opisz czego oczekujesz na stronie (min. 15 znaków).",
                );
                valid = false;
            } else {
                clearError("zakres_strony");
            }
        }

        if (step === 4) {
            // Email lub Telefon (przynajmniej jedno musi być wypełnione)
            const emailEl = document.getElementById(
                "email",
            ) as HTMLInputElement | null;
            const telEl = document.getElementById(
                "telefon",
            ) as HTMLInputElement | null;
            const email = emailEl ? emailEl.value.trim() : "";
            const tel = telEl ? telEl.value.trim() : "";

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if (!email && !tel) {
                showError(
                    "email",
                    "Proszę podać adres e-mail lub numer telefonu.",
                );
                showError(
                    "telefon",
                    "Proszę podać numer telefonu lub adres e-mail.",
                );
                valid = false;
            } else {
                clearError("email");
                clearError("telefon");

                if (email && !emailRegex.test(email)) {
                    showError("email", "Podaj poprawny adres e-mail.");
                    valid = false;
                }
            }

            // RODO
            const rodoEl = document.getElementById(
                "rodo",
            ) as HTMLInputElement | null;
            if (!rodoEl || !rodoEl.checked) {
                showError(
                    "rodo",
                    "Wymagana jest zgoda na przetwarzanie danych.",
                );
                valid = false;
            } else {
                clearError("rodo");
            }

            // ZASADY WSPÓŁPRACY
            const zasadyEl = document.getElementById(
                "zasady",
            ) as HTMLInputElement | null;
            if (!zasadyEl || !zasadyEl.checked) {
                showError(
                    "zasady",
                    "Wymagana jest akceptacja zasad współpracy.",
                );
                valid = false;
            } else {
                clearError("zasady");
            }
        }

        return valid;
    }

    // Czyszczenie błędów na bieżąco
    [
        "imie",
        "branza",
        "opis_firmy",
        "zakres_strony",
        "email",
        "telefon",
    ].forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener("input", () => {
                clearError(id);
                if (id === "email" || id === "telefon") {
                    clearError("email");
                    clearError("telefon");
                }
            });
        }
    });

    const rodoCheckbox = document.getElementById("rodo");
    if (rodoCheckbox) {
        rodoCheckbox.addEventListener("change", () => clearError("rodo"));
    }

    const zasadyCheckbox = document.getElementById("zasady");
    if (zasadyCheckbox) {
        zasadyCheckbox.addEventListener("change", () => clearError("zasady"));
    }

    // ============================================================
    // NAWIGACJA WIZARDA
    // ============================================================

    function updateStepUI() {
        // Panele formularza
        panels.forEach((panel) => {
            const p = panel as HTMLElement;
            const stepNum = parseInt(p.getAttribute("data-panel") || "1", 10);

            if (stepNum === currentStep) {
                p.style.display = "block";
                setTimeout(() => {
                    p.classList.add("active");
                }, 10);
            } else {
                p.classList.remove("active");
                p.style.display = "none";
            }
        });

        // Wskaźniki kroków na pasku bocznym (desktop)
        stepItems.forEach((item) => {
            const btn = item as HTMLButtonElement;
            const stepNum = parseInt(btn.getAttribute("data-step") || "1", 10);

            btn.classList.remove("active", "completed");

            if (stepNum === currentStep) {
                btn.classList.add("active");
            } else if (stepNum < currentStep) {
                btn.classList.add("completed");
            }

            // Odblokuj etapy, do których użytkownik ma już dostęp
            if (stepNum <= maxStepReached) {
                btn.disabled = false;
            } else {
                btn.disabled = true;
            }
        });

        // Wypełnienie linii postępu globalnego paska postępu (desktop i mobile)
        const percentage = ((currentStep - 1) / (totalSteps - 1)) * 100;

        if (globalProgressFill) {
            globalProgressFill.style.width = `${percentage}%`;
        }

        if (globalProgressStepText) {
            globalProgressStepText.textContent = stepNames[currentStep - 1];
        }

        if (globalProgressPercent) {
            globalProgressPercent.textContent = `Krok ${currentStep} z ${totalSteps}`;
        }

        // Wypełnienie linii postępu pionowej w sidebarze na desktopie
        if (progressFill) {
            progressFill.style.height = `${percentage}%`;
        }

        // Przyciski stopki
        if (prevBtn) {
            prevBtn.style.display = currentStep > 1 ? "inline-flex" : "none";
        }

        if (nextBtn) {
            nextBtn.style.display =
                currentStep < totalSteps ? "inline-flex" : "none";
        }

        if (submitBtn) {
            submitBtn.style.display =
                currentStep === totalSteps ? "inline-flex" : "none";
        }

        // Scroll do formularza (przydatne na telefonie)
        const wizardEl = document.getElementById("order-wizard");
        if (wizardEl && currentStep > 1) {
            const offset = 80;
            const bodyRect = document.body.getBoundingClientRect().top;
            const elementRect = wizardEl.getBoundingClientRect().top;
            const elementPosition = elementRect - bodyRect;
            const offsetPosition = elementPosition - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: "smooth",
            });
        }
    }

    // Kliknięcie w przyciski Dalej / Powrót
    if (nextBtn) {
        nextBtn.addEventListener("click", () => {
            if (validateStep(currentStep)) {
                currentStep++;
                if (currentStep > maxStepReached) {
                    maxStepReached = currentStep;
                }
                updateStepUI();
            }
        });
    }

    if (prevBtn) {
        prevBtn.addEventListener("click", () => {
            if (currentStep > 1) {
                currentStep--;
                updateStepUI();
            }
        });
    }

    // Bezpośrednie kliknięcia w numery kroków na pasku bocznym
    stepItems.forEach((item) => {
        item.addEventListener("click", () => {
            const targetStep = parseInt(
                item.getAttribute("data-step") || "1",
                10,
            );

            // Waliduj kroki pośrednie, jeśli idziemy do przodu
            if (targetStep > currentStep) {
                let canNavigate = true;
                for (let i = currentStep; i < targetStep; i++) {
                    if (!validateStep(i)) {
                        canNavigate = false;
                        currentStep = i; // Pokaż krok z błędem
                        break;
                    }
                }
                if (canNavigate) {
                    currentStep = targetStep;
                }
            } else {
                currentStep = targetStep;
            }
            updateStepUI();
        });
    });

    // ============================================================
    // WYSYŁANIE FORMULARZA EMAILJS
    // ============================================================

    function showNotification(type: "success" | "error", message: string) {
        if (!notification) return;
        const icon = notification.querySelector(
            ".notification__icon",
        ) as HTMLElement | null;
        const text = notification.querySelector(
            ".notification__text",
        ) as HTMLElement | null;
        if (!icon || !text) return;

        notification.className = "form__notification " + type;
        icon.className =
            "notification__icon fa-solid " +
            (type === "success" ? "fa-check-circle" : "fa-circle-exclamation");
        text.textContent = message;
        notification.style.display = "flex";

        setTimeout(() => {
            notification.style.display = "none";
        }, 6000);
    }

    function setLoading(loading: boolean) {
        if (!submitBtn) return;
        const text = submitBtn.querySelector(
            ".btn__text",
        ) as HTMLElement | null;
        const icon = submitBtn.querySelector(
            ".btn__icon",
        ) as HTMLElement | null;
        const spinner = submitBtn.querySelector(
            ".btn__loading",
        ) as HTMLElement | null;

        if (!text || !icon || !spinner) return;

        if (loading) {
            text.style.display = "none";
            icon.style.display = "none";
            spinner.style.display = "inline-flex";
            submitBtn.disabled = true;
            if (prevBtn) prevBtn.disabled = true;
        } else {
            text.style.display = "inline";
            icon.style.display = "inline";
            spinner.style.display = "none";
            submitBtn.disabled = false;
            if (prevBtn) prevBtn.disabled = false;
        }
    }

    form?.addEventListener("submit", async function (e) {
        e.preventDefault();

        const lastSentTime = localStorage.getItem("lastEmailSentTime");
        const cooldownTime = 2 * 60 * 1000; // 2 minuty cooldownu

        if (lastSentTime) {
            const timeElapsed = Date.now() - parseInt(lastSentTime, 10);
            if (timeElapsed < cooldownTime) {
                const timeLeft = Math.ceil((cooldownTime - timeElapsed) / 1000);
                const minutesLeft = Math.floor(timeLeft / 60);
                const secondsLeft = timeLeft % 60;
                const timeString =
                    minutesLeft > 0
                        ? `${minutesLeft}m ${secondsLeft}s`
                        : `${secondsLeft}s`;
                showNotification(
                    "error",
                    `⏳ Odczekaj jeszcze ${timeString} przed wysłaniem kolejnej wiadomości.`,
                );
                return;
            }
        }

        // Walidacja ostatniego kroku i całości
        let isAllValid = true;
        for (let i = 1; i <= totalSteps; i++) {
            if (!validateStep(i)) {
                isAllValid = false;
                currentStep = i;
                updateStepUI();
                break;
            }
        }

        if (!isAllValid) return;

        setLoading(true);

        // Przygotowanie danych
        const imieEl = document.getElementById(
            "imie",
        ) as HTMLInputElement | null;
        const firmaEl = document.getElementById(
            "firma",
        ) as HTMLInputElement | null;
        const branzaEl = document.getElementById(
            "branza",
        ) as HTMLInputElement | null;
        const opisEl = document.getElementById(
            "opis_firmy",
        ) as HTMLTextAreaElement | null;
        const zakresEl = document.getElementById(
            "zakres_strony",
        ) as HTMLTextAreaElement | null;
        const emailEl = document.getElementById(
            "email",
        ) as HTMLInputElement | null;
        const telEl = document.getElementById(
            "telefon",
        ) as HTMLInputElement | null;

        const nameVal = imieEl ? imieEl.value.trim() : "";
        const firmaVal = firmaEl ? firmaEl.value.trim() : "";
        const serviceVal = inputUsluga ? inputUsluga.value : "";
        const budgetVal = inputBudzet ? inputBudzet.value : "";
        const branzaVal = branzaEl ? branzaEl.value.trim() : "";
        const opisVal = opisEl ? opisEl.value.trim() : "";
        const zakresVal = zakresEl ? zakresEl.value.trim() : "";
        const emailVal = emailEl ? emailEl.value.trim() : "";
        const telVal = telEl ? telEl.value.trim() : "";

        const templateParams = {
            imie: `${nameVal}${firmaVal ? ` (Firma: ${firmaVal})` : ""}`,
            nazwisko: ` — Usługa: ${serviceVal} | Budżet: ${budgetVal}`,
            kontakt: `E-mail: ${emailVal || "brak"} | Telefon: ${telVal || "brak"}`,
            tresc: `BRANŻA:\n${branzaVal}\n\nOPIS FIRMY:\n${opisVal}\n\nZAKRES WITRYNY:\n${zakresVal}`,
        };

        const triggerErrorPopup = () => {
            const popup = document.getElementById("email-error-popup");
            const mailtoBtn = document.getElementById(
                "email-error-mailto-btn",
            ) as HTMLAnchorElement | null;

            if (popup && mailtoBtn) {
                const subject = encodeURIComponent(
                    "Zapytanie ofertowe ze strony web2sell.pl",
                );
                const body = encodeURIComponent(
                    `Imię i Nazwisko: ${templateParams.imie}\n` +
                        `${templateParams.nazwisko}\n` +
                        `Kontakt: ${templateParams.kontakt}\n\n` +
                        `${templateParams.tresc}`,
                );
                mailtoBtn.href = `mailto:kontakt@web2sell.pl?subject=${subject}&body=${body}`;
                popup.classList.add("active");
                document.body.style.overflow = "hidden"; // block body scrolling
            }
        };

        try {
            // Upewniamy się, że EmailJS jest załadowany
            await loadEmailJS();

            if (!(window as any).emailjs) {
                throw new Error("Biblioteka EmailJS nie została załadowana.");
            }

            (window as any).emailjs
                .send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams, {
                    publicKey: EMAILJS_PUBLIC_KEY,
                })
                .then(() => {
                    setLoading(false);
                    localStorage.setItem(
                        "lastEmailSentTime",
                        Date.now().toString(),
                    );
                    window.location.href = "/dziekujemy";
                })
                .catch((error: any) => {
                    setLoading(false);
                    console.error("EmailJS sending error:", error);
                    triggerErrorPopup();
                });
        } catch (error: any) {
            setLoading(false);
            console.error("EmailJS submit error:", error);
            triggerErrorPopup();
        }
    });

    // Dynamiczne pozycjonowanie paska postępu na mobile
    const header = document.getElementById("main-header");
    const progressBar = document.getElementById("wizard-progress-bar");

    function positionMobileProgressBar() {
        if (header && progressBar) {
            const isMobile = window.matchMedia("(max-width: 1023px)").matches;
            if (isMobile) {
                const headerHeight = header.offsetHeight;
                progressBar.style.top = `${headerHeight}px`;
            } else {
                progressBar.style.top = ""; // reset na desktopie
            }
        }
    }

    // Uruchomienie przy załadowaniu, resize i scrollu (w przypadku zmiany wysokości headera)
    positionMobileProgressBar();
    window.addEventListener("resize", positionMobileProgressBar);
    window.addEventListener("scroll", positionMobileProgressBar, {
        passive: true,
    });

    // Zamykanie popupa błędu i przeniesienie do body
    const errorPopup = document.getElementById("email-error-popup");
    const errorPopupClose = document.getElementById("email-error-close");

    if (errorPopup) {
        document.body.appendChild(errorPopup);
    }

    if (errorPopupClose && errorPopup) {
        errorPopupClose.addEventListener("click", (e) => {
            e.preventDefault();
            errorPopup.classList.remove("active");
            document.body.style.overflow = ""; // restore body scrolling
        });
    }

    // Inicjalizacja widoku
    updateStepUI();
</script>
