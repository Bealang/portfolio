---
// OrderWizard component - Multi-step interactive ordering survey (ankieta)
---

<section id="order-wizard" class="wizard-section">
    <div class="wizard-container">
        <!-- LEWY PANEL: ETAPY (DESKTOP ONLY) -->
        <aside class="wizard-sidebar">
            <div class="wizard-steps-list">
                <!-- KROK 1 -->
                <button
                    class="wizard-step-item active"
                    data-step="1"
                    type="button"
                    aria-label="Krok 1: O Tobie"
                >
                    <span class="step-num">
                        <span class="num-text">01</span>
                        <i class="fa-solid fa-check check-icon"></i>
                    </span>
                    <div class="step-details">
                        <span class="step-title">Przedstaw się</span>
                    </div>
                </button>

                <!-- KROK 2 -->
                <button
                    class="wizard-step-item"
                    data-step="2"
                    type="button"
                    aria-label="Krok 2: Twój projekt"
                    disabled
                >
                    <span class="step-num">
                        <span class="num-text">02</span>
                        <i class="fa-solid fa-check check-icon"></i>
                    </span>
                    <div class="step-details">
                        <span class="step-title">Twój projekt</span>
                    </div>
                </button>

                <!-- KROK 3 -->
                <button
                    class="wizard-step-item"
                    data-step="3"
                    type="button"
                    aria-label="Krok 3: O firmie"
                    disabled
                >
                    <span class="step-num">
                        <span class="num-text">03</span>
                        <i class="fa-solid fa-check check-icon"></i>
                    </span>
                    <div class="step-details">
                        <span class="step-title">Twój biznes</span>
                    </div>
                </button>

                <!-- KROK 4 -->
                <button
                    class="wizard-step-item"
                    data-step="4"
                    type="button"
                    aria-label="Krok 4: Kontakt"
                    disabled
                >
                    <span class="step-num">
                        <span class="num-text">04</span>
                        <i class="fa-solid fa-check check-icon"></i>
                    </span>
                    <div class="step-details">
                        <span class="step-title">Kontakt</span>
                    </div>
                </button>
            </div>
        </aside>

        <!-- PRAWY PANEL: FORMULARZ Z KARTAMI -->
        <div class="wizard-form-wrapper">
            <!-- PASEK POSTĘPU NA URZĄDZENIACH MOBILNYCH (STICKY) ORAZ DESKTOP -->
            <div class="wizard-header-progress" id="wizard-progress-bar">
                <div class="progress-bar-wrapper">
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" id="global-progress-fill"></div>
                    </div>
                    <div class="progress-bar-info">
                        <span class="progress-step-text" id="global-progress-step-text"
                            >Przedstaw się nam</span
                        >
                        <span class="progress-percent" id="global-progress-percent"
                            >Krok 1 z 4</span
                        >
                    </div>
                </div>
            </div>

            <form id="wizard-form" novalidate>
                <!-- KROK 1 PANEL -->
                <div class="wizard-panel active" data-panel="1">
                    <div class="panel-header">
                        <h2>
                            Przedstaw się <span class="gradient__text">nam</span
                            >
                        </h2>
                        <p>
                            Zaczynamy! Powiedz nam, jak się nazywasz i dla kogo
                            będziemy tworzyć projekt.
                        </p>
                    </div>

                    <div class="panel-body">
                        <div class="form__group">
                            <label for="imie" class="wizard-label">
                                Imię i Nazwisko <span class="required">*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-user input-icon"></i>
                                <input
                                    type="text"
                                    id="imie"
                                    name="imie"
                                    placeholder="np. Jan Kowalski"
                                    autocomplete="name"
                                />
                            </div>
                            <span class="form__error" id="imie__error"></span>
                        </div>

                        <div class="form__group">
                            <label for="firma" class="wizard-label">
                                Pełna nazwa firmy (KRS/CEIDG) <span
                                    class="optional">(opcjonalnie)</span
                                >
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-building input-icon"></i>
                                <input
                                    type="text"
                                    id="firma"
                                    name="firma"
                                    placeholder="Nazwa firmy lub NIP"
                                />
                            </div>
                            <span class="form__error" id="firma__error"></span>
                        </div>
                    </div>
                </div>

                <!-- KROK 2 PANEL -->
                <div class="wizard-panel" data-panel="2">
                    <div class="panel-header">
                        <h2>
                            Szczegóły <span class="gradient__text">usługi</span>
                        </h2>
                        <p>
                            Wybierz najbardziej odpowiadający Ci pakiet oraz
                            określ swój budżet.
                        </p>
                    </div>

                    <div class="panel-body">
                        <div class="form__group">
                            <label class="wizard-label">
                                Wybierz wstępną usługę <span class="required"
                                    >*</span
                                >
                            </label>

                            <!-- UKRYTY SELECT DLA ZGODNOŚCI Z PRZESYŁANIEM -->
                            <select
                                id="usluga"
                                name="usluga"
                                style="display: none;"
                            >
                                <option
                                    value="Nie wiem. Chcę to ustalić"
                                    selected>Nie wiem. Chcę to ustalić</option
                                >
                                <option value="OnePage (Szybki start w sieci)"
                                    >OnePage (Szybki start w sieci)</option
                                >
                                <option
                                    value="Wizytówka Multi-Page (Budowa autorytetu)"
                                    >Wizytówka Multi-Page (Budowa autorytetu)</option
                                >
                                <option
                                    value="Wizytówka + CMS (Dynamiczne treści)"
                                    >Wizytówka + CMS (Dynamiczne treści)</option
                                >
                                <option
                                    value='System Dedykowany (Rozwiązania "Full Custom")'
                                    >System Dedykowany (Rozwiązania "Full
                                    Custom")</option
                                >
                                <option value="Potrzebuję pomocy doradcy"
                                    >Potrzebuję pomocy doradcy</option
                                >
                            </select>

                            <!-- WIZUALNE KAFELKI -->
                            <div class="service-tiles-grid">
                                <!-- OnePage -->
                                <div
                                    class="service-tile"
                                    data-value="OnePage (Szybki start w sieci)"
                                >
                                    <div class="tile-header">
                                        <span class="tile-title">OnePage</span>
                                        <span class="tile-badge"
                                            >od 1000 zł</span
                                        >
                                    </div>
                                    <p class="tile-desc">
                                        Szybka i prosta jednostronicowa
                                        wizytówka. Doskonała dla jednoosobowych
                                        działalności, freelancerów czy małych
                                        firm. Znajduje się na niej wszystko, co
                                        niezbędne, by skutecznie zaprezentować
                                        ofertę i zdobyć pierwszych klientów z
                                        Google.
                                    </p>
                                    <div class="tile-select-indicator">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                </div>

                                <!-- MultiPage -->
                                <div
                                    class="service-tile"
                                    data-value="Wizytówka Multi-Page (Budowa autorytetu)"
                                >
                                    <div class="tile-header">
                                        <span class="tile-title"
                                            >Multi-Page</span
                                        >
                                        <span class="tile-badge"
                                            >od 1500 zł</span
                                        >
                                    </div>
                                    <p class="tile-desc">
                                        Pełnoprawna strona internetowa
                                        podzielona na kilka dedykowanych
                                        podstron (o nas, oferta, galeria,
                                        kontakt). Idealna dla firm, które chcą
                                        zbudować silniejszą pozycję w Google i
                                        zaoferować klientom bardziej rozbudowaną
                                        prezentację swojej oferty niż Onepage.
                                    </p>
                                    <div class="tile-select-indicator">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                </div>

                                <!-- Wizytówka + CMS -->
                                <div
                                    class="service-tile"
                                    data-value="Wizytówka + CMS (Dynamiczne treści)"
                                >
                                    <div class="tile-header">
                                        <span class="tile-title"
                                            >Wizytówka + CMS</span
                                        >
                                        <span class="tile-badge"
                                            >od 2500 zł</span
                                        >
                                    </div>
                                    <p class="tile-desc">
                                        Strona z autorskim, panel
                                        administracyjnym. Samodzielnie i
                                        błyskawicznie edytujesz ofertę,
                                        portfolio czy bloga bez pisania kodu. To
                                        doskonały wybór dla firm, które chcą
                                        mieć pełną kontrolę nad swoją stroną i
                                        regularnie aktualizować treści.
                                    </p>
                                    <div class="tile-select-indicator">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                </div>

                                <!-- System Dedykowany -->
                                <div
                                    class="service-tile"
                                    data-value='System Dedykowany (Rozwiązania "Full Custom")'
                                >
                                    <div class="tile-header">
                                        <span class="tile-title"
                                            >System Dedykowany</span
                                        >
                                        <span class="tile-badge"
                                            >od 4000 zł</span
                                        >
                                    </div>
                                    <p class="tile-desc">
                                        Dedykowane rozwiązanie dla najbardziej
                                        wymagających klientów. Strona idealnie
                                        dopasowana do potrzeb Twojego biznesu, z
                                        rozbudowanymi funkcjonalnościami
                                        (rezerwacje, interaktywne cenniki,
                                        integracje z systemami zewnętrznymi).
                                    </p>
                                    <div class="tile-select-indicator">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                </div>

                                <!-- Pomoc doradcy -->
                                <div
                                    class="service-tile"
                                    data-value="Potrzebuję pomocy doradcy"
                                >
                                    <div class="tile-header">
                                        <span class="tile-title"
                                            >Potrzebuję pomocy doradcy</span
                                        >
                                        <span class="tile-badge font-normal"
                                            >Konsultacja</span
                                        >
                                    </div>
                                    <p class="tile-desc">
                                        Wybierz tę opcję, jeśli nie jesteś
                                        pewien, który pakiet będzie najlepszy
                                        dla Twojej firmy. Jesteśmy w stanie po
                                        krótkiej rozmowie wspólnie dobrać
                                        optymalne i dopasowane dla Ciebie
                                        rozwiązanie.
                                    </p>
                                    <div class="tile-select-indicator">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                </div>
                            </div>
                            <span class="form__error" id="usluga__error"></span>
                        </div>

                        <!-- BUDŻET Z WYBOREM WALUTY -->
                        <div class="form__group">
                            <label for="budzet_kwota" class="wizard-label">
                                Twój budżet <span class="required">*</span>
                            </label>

                            <!-- Ukryte pole na ostateczną wartość przesyłaną -->
                            <input
                                type="hidden"
                                id="budzet"
                                name="budzet"
                                value=""
                            />

                            <div class="budget-input-group">
                                <div class="number-input-wrapper">
                                    <i class="fa-solid fa-wallet input-icon"
                                    ></i>
                                    <input
                                        type="number"
                                        id="budzet_kwota"
                                        name="budzet_kwota"
                                        placeholder="np. 2500"
                                        min="1000"
                                    />
                                </div>
                                <select
                                    id="waluta"
                                    name="waluta"
                                    class="currency-select"
                                    aria-label="Waluta"
                                >
                                    <option value="zł">zł (PLN)</option>
                                    <option value="EUR">EUR (€)</option>
                                </select>
                            </div>
                            <p class="budget-tip">
                                Minimalny budżet projektu to 1000 zł / EUR.
                            </p>
                            <span class="form__error" id="budzet_kwota__error"
                            ></span>
                        </div>
                    </div>
                </div>

                <!-- KROK 3 PANEL -->
                <div class="wizard-panel" data-panel="3">
                    <div class="panel-header">
                        <h2>
                            O Twoim <span class="gradient__text">biznesie</span>
                        </h2>
                        <p>
                            Przybliż nam specyfikę swojej działalności, co
                            pozwoli nam lepiej dopasować ofertę.
                        </p>
                    </div>

                    <div class="panel-body">
                        <div class="form__group">
                            <label for="branza" class="wizard-label">
                                Branża Twojej firmy <span class="required"
                                    >*</span
                                >
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-tags input-icon"></i>
                                <input
                                    type="text"
                                    id="branza"
                                    name="branza"
                                    placeholder="np. Budownictwo, Kosmetyka, Gastronomia, Prawo"
                                />
                            </div>
                            <span class="form__error" id="branza__error"></span>
                        </div>

                        <div class="form__group">
                            <label for="opis_firmy" class="wizard-label">
                                Krótki opis czym zajmuje się firma <span
                                    class="required">*</span
                                >
                            </label>
                            <textarea
                                id="opis_firmy"
                                name="opis_firmy"
                                placeholder="Napisz krótko czym zajmuje się Twoja firma, jakie usługi świadczysz i kto jest Twoim głównym klientem..."
                            ></textarea>
                            <span class="form__error" id="opis_firmy__error"
                            ></span>
                        </div>

                        <div class="form__group">
                            <label for="zakres_strony" class="wizard-label">
                                Co chcesz aby znalazło się na stronie
                                internetowej? <span class="required">*</span>
                            </label>
                            <textarea
                                id="zakres_strony"
                                name="zakres_strony"
                                placeholder="np. podstrona z galerią, formularz kontaktowy, integracja z mapą Google, cennik usług, blog..."
                            ></textarea>
                            <span class="form__error" id="zakres_strony__error"
                            ></span>
                        </div>
                    </div>
                </div>

                <!-- KROK 4 PANEL -->
                <div class="wizard-panel" data-panel="4">
                    <div class="panel-header">
                        <h2>
                            Dane <span class="gradient__text">kontaktowe</span>
                        </h2>
                        <p>
                            To już ostatni krok! Podaj nam kontakt do siebie,
                            abyśmy mogli przesłać gotową wycenę.
                        </p>
                    </div>

                    <div class="panel-body">
                        <div class="contact-validation-notice">
                            <i class="fa-solid fa-circle-info"></i>
                            <span
                                >Wymagane jest podanie przynajmniej jednej z
                                poniższych form kontaktu (Telefon lub E-mail).</span
                            >
                        </div>

                        <div class="form__grid-2">
                            <div class="form__group">
                                <label for="telefon" class="wizard-label"
                                    >Telefon</label
                                >
                                <div class="input-wrapper">
                                    <i class="fa-solid fa-phone input-icon"></i>
                                    <input
                                        type="tel"
                                        id="telefon"
                                        name="telefon"
                                        placeholder="np. +48 123 456 789"
                                        autocomplete="tel"
                                    />
                                </div>
                                <span class="form__error" id="telefon__error"
                                ></span>
                            </div>

                            <div class="form__group">
                                <label for="email" class="wizard-label"
                                    >Adres e-mail</label
                                >
                                <div class="input-wrapper">
                                    <i class="fa-solid fa-envelope input-icon"
                                    ></i>
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        placeholder="np. twoj@email.com"
                                        autocomplete="email"
                                    />
                                </div>
                                <span class="form__error" id="email__error"
                                ></span>
                            </div>
                        </div>

                        <div class="form__group rodo__group">
                            <label class="rodo__label">
                                <input
                                    type="checkbox"
                                    id="rodo"
                                    name="rodo"
                                    required
                                />
                                <span class="rodo__checkmark"></span>
                                <span class="rodo__text">
                                    Wyrażam zgodę na przetwarzanie moich danych
                                    osobowych w celu udzielenia odpowiedzi na
                                    zapytanie.
                                    <a href="/polityka" target="_blank"
                                        >Polityka prywatności</a
                                    >
                                </span>
                            </label>
                            <span class="form__error" id="rodo__error"></span>
                        </div>

                        <div class="form__group rodo__group">
                            <label class="rodo__label">
                                <input
                                    type="checkbox"
                                    id="zasady"
                                    name="zasady"
                                    required
                                />
                                <span class="rodo__checkmark"></span>
                                <span class="rodo__text">
                                    Zapoznałem się z
                                    <a href="/zasady-wspolpracy" target="_blank"
                                        >zasadami współpracy</a
                                    > i akceptuję ich postanowienia. <span class="required">*</span>
                                </span>
                            </label>
                            <span class="form__error" id="zasady__error"></span>
                        </div>
                    </div>
                </div>

                <!-- STOPKA WIZARDA - NAWIGACJA -->
                <div class="wizard-footer">
                    <button
                        type="button"
                        id="prev-btn"
                        class="wizard-btn btn-secondary"
                        style="display: none;"
                    >
                        <i class="fa-solid fa-arrow-left"></i> Powrót
                    </button>

                    <button
                        type="button"
                        id="next-btn"
                        class="wizard-btn btn-primary"
                    >
                        Dalej <i class="fa-solid fa-arrow-right"></i>
                    </button>

                    <button
                        type="submit"
                        id="submit-btn"
                        class="wizard-btn btn-submit"
                        style="display: none;"
                    >
                        <span class="btn__text">Wyślij zapytanie</span>
                        <i class="fa-solid fa-paper-plane btn__icon"></i>
                        <span class="btn__loading" style="display:none;">
                            <i class="fa-solid fa-spinner fa-spin"></i> Wysyłanie...
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- POWIADOMIENIE (SUCCESS / ERROR) -->
    <div
        id="form__notification"
        class="form__notification"
        style="display:none;"
    >
        <i class="notification__icon"></i>
        <span class="notification__text"></span>
    </div>

    <!-- ERROR EMAIL POPUP -->
    <div id="email-error-popup" class="email-error-popup">
        <div class="email-error-content">
            <button
                class="email-error-close"
                id="email-error-close"
                aria-label="Zamknij popup"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="email-error-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3>Wystąpił błąd!</h3>
            <p>
                Niestety wystąpił błąd przy wysyłaniu maila. Wyślij do nas maila
                klikając przycisk niżej. Wszystkie dane zostaną automatycznie
                uzupełnione.
            </p>
            <a
                href="#"
                id="email-error-mailto-btn"
                class="wizard-btn btn-primary"
                >Otwórz email <i class="fa-solid fa-envelope"></i></a
            >
        </div>
    </div>
</section>

<style>
    /* ==========================================================================
       GŁÓWNE STYLE STRUKTURALNE WIZARDA
       ========================================================================== */
    .wizard-section {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 24px;
        box-sizing: border-box;
    }

    .wizard-container {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 32px;
        align-items: start;
        width: 100%;
    }

    /* ==========================================================================
       GLOBALNY PASEK POSTĘPU (WIDOCZNY ZAWSZE NA GÓRZE W FORMULARZU)
       ========================================================================== */
    .wizard-header-progress {
        width: 100%;
        margin-bottom: 24px;
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0;
        padding: 0 0 20px 0;
        box-sizing: border-box;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }

    html[data-theme="light"] .wizard-header-progress {
        border-bottom-color: rgba(0, 0, 0, 0.06);
    }

    .progress-bar-wrapper {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .progress-bar-container {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        overflow: hidden;
    }

    html[data-theme="light"] .progress-bar-container {
        background: rgba(0, 0, 0, 0.06);
    }

    .progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(
            90deg,
            var(--accent-blue),
            var(--accent-cyan)
        );
        transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.35);
    }

    .progress-bar-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        font-weight: 600;
    }

    .progress-step-text {
        color: var(--text-primary);
    }

    .progress-percent {
        color: var(--accent-blue);
    }

    /* ==========================================================================
       LEWY PANEL - ETAPY (DESKTOP)
       ========================================================================== */
    .wizard-sidebar {
        position: sticky;
        top: 100px;
        display: flex;
        gap: 20px;
        padding-left: 0;
        user-select: none;
    }

    .wizard-progress-track {
        display: none !important;
    }

    .progress-track-fill {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 0%;
        background: linear-gradient(
            to bottom,
            var(--accent-blue),
            var(--accent-cyan)
        );
        transition: height 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.4);
    }

    .wizard-steps-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
    }

    .wizard-step-item {
        display: flex;
        align-items: center;
        gap: 16px;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        text-align: left;
        cursor: pointer;
        width: 100%;
        color: inherit;
        font-family: inherit;
        transition: var(--transition-smooth);
    }

    .wizard-step-item:disabled {
        cursor: not-allowed;
    }

    .step-num {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 14px;
        position: relative;
        background: var(--bg-color);
