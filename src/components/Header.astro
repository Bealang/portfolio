---
interface Props {
    activePage?: string;
}

const { activePage = "" } = Astro.props;
const isHome = activePage === "home";
---

<header id="main-header">
    <!-- DESKTOP NAGŁÓWEK (FLOATING PILL NAVBAR) -->
    <div class="header-desktop-pill">
        <a href={isHome ? "#" : "/"} class="logo-text" aria-label="Strona główna">
            web2<span class="gradient__text">sell</span>
        </a>

        <nav id="nav-menu">
            <a href={isHome ? "#o-nas" : "/#o-nas"} class="nav-link">O nas</a>
            <a href={isHome ? "#projekty" : "/#projekty"} class="nav-link">Realizacje</a>
            <a href="/cennik" class:list={["nav-link", { active: activePage === "cennik" }]}>Cennik</a>
            <a href="/jak-dzialamy" class:list={["nav-link", { active: activePage === "jak-dzialamy" }]}>Jak działamy?</a>
            <a href="/jak-dzialamy#faq" class="nav-link">FAQ</a>

            <!-- Dedykowane szczegóły kontaktu wyświetlane na dole rozwijanego drawer menu na mobile -->
            <div class="mobile-menu-footer">
                <div class="mobile-menu-theme-row">
                    <span class="theme-label">Motyw:</span>
                    <button class="theme-switch-pill" aria-label="Zmień motyw">
                        <span class="pill-track">
                            <span class="pill-thumb">
                                <i class="fa-solid fa-sun sun-icon"></i>
                                <i class="fa-solid fa-moon moon-icon"></i>
                            </span>
                        </span>
                    </button>
                </div>
                <a href="tel:+48530315860" class="mobile-menu-phone">
                    <i class="fa-solid fa-phone"></i> +48 530 315 860
                </a>
                <a href="/zamow" class="mobile-menu-cta">Bezpłatna wycena</a>
            </div>
        </nav>

        <div class="header-desktop-actions">
            <a href="/zamow" class="header-cta">Bezpłatna wycena</a>
        </div>
    </div>

    <!-- 3. MOBILNY NAGŁÓWEK (COMPACT SINGLE ROW) -->
    <div class="header-mobile-row">
        <a href={isHome ? "#" : "/"} class="logo-text"
            >web2<span class="gradient__text">sell</span></a
        >

        <div class="header-mobile-actions">
            <!-- Widoczny przycisk Zamów wycenę od razu na mobile (chowa się przy open menu) -->
            <a href="/zamow" class="mobile-visible-cta">Bezpłatna wycena</a>

            <!-- Hamburger menu -->
            <div class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</header>

<!-- 4. MOBILNE PŁYWAJĄCE MENU (FLOATING BOTTOM NAV) -->
<div class="mobile-floating-nav" id="mobileFloatingNav">
    <a
        href="/cennik"
        class:list={[
            "floating-nav-item",
            { active: activePage === "cennik" },
        ]}
        aria-label="Cennik"
    >
        <i class="fa-solid fa-dollar-sign"></i>
        <span>Cennik</span>
    </a>
    <a
        href="/zamow"
        class:list={[
            "floating-nav-item",
            { active: activePage === "zamow" },
        ]}
        aria-label="Wycena"
    >
        <i class="fa-solid fa-file-invoice-dollar"></i>
        <span>Wycena</span>
    </a>
    <a href="tel:+48530315860" class="floating-nav-item" aria-label="Zadzwoń">
        <i class="fa-solid fa-phone"></i>
        <span>Zadzwoń</span>
    </a>
</div>

<script>
    (function () {
        var header = document.getElementById("main-header");
        if (!header) return;

        // ──────────────────────────────────────────────────
        // Theme Toggle Handler (Syncing both Desktop & Mobile Toggles)
        // ──────────────────────────────────────────────────
        var themeToggles = document.querySelectorAll(".theme-switch-pill");
        var isTransitioning = false;

        themeToggles.forEach(function (toggle) {
            toggle.addEventListener("click", function (event) {
                if (isTransitioning) return;
                isTransitioning = true;

                var currentTheme = document.documentElement.getAttribute("data-theme") || "light";
                var newTheme = currentTheme === "dark" ? "light" : "dark";

                // Get click coordinates (or center of the toggle if keyboard triggered)
                var x = event.clientX;
                var y = event.clientY;
                if (x === undefined || y === undefined) {
                    var rect = toggle.getBoundingClientRect();
                    x = rect.left + rect.width / 2;
                    y = rect.top + rect.height / 2;
                }

                // Create full-screen overlay container
                var overlay = document.createElement("div");
                overlay.className = "theme-transition-overlay";

                // Create the scaling circle element
                var circle = document.createElement("div");
                circle.className = "theme-transition-circle";
                circle.style.left = (x - 50) + "px";
                circle.style.top = (y - 50) + "px";

                // Create the cross-fading background layers inside the circle
                var currentBg = document.createElement("div");
                currentBg.className = "theme-transition-circle-bg current-bg";
                currentBg.style.backgroundColor = currentTheme === "dark" ? "#000000" : "#f5f6f8";

                var targetBg = document.createElement("div");
                targetBg.className = "theme-transition-circle-bg target-bg";
                targetBg.style.backgroundColor = newTheme === "dark" ? "#000000" : "#f5f6f8";

                circle.appendChild(currentBg);
                circle.appendChild(targetBg);
                overlay.appendChild(circle);
                document.body.appendChild(overlay);

                // Calculate scale factor to cover the screen from point (x, y)
                var maxDist = Math.max(
                    Math.hypot(x, y),
                    Math.hypot(window.innerWidth - x, y),
                    Math.hypot(x, window.innerHeight - y),
                    Math.hypot(window.innerWidth - x, window.innerHeight - y)
                );
                var targetScale = (maxDist / 50) + 0.5;

                // Force DOM reflow
                overlay.offsetWidth;

                // Phase 1: Expand circle via GPU-accelerated transform scale (Slow & premium)
                circle.animate([
                    { transform: "scale(0)" },
                    { transform: "scale(" + targetScale + ")" }
                ], {
                    duration: 550,
                    easing: "cubic-bezier(0.76, 0, 0.24, 1)",
                    fill: "forwards"
                });

                // Phase 2: Snappy fade of target background color
                // (Starts exactly after circle expands, at 550ms)
                setTimeout(function() {
                    // We only animate the target layer from 0 to 1 opacity.
                    // The current layer remains solid (opacity 1) underneath, preventing transparency issues.
                    targetBg.animate([
                        { opacity: 0 },
                        { opacity: 1 }
                    ], {
                        duration: 150, // Snappy 150ms transition for eye comfort
                        easing: "ease-out",
                        fill: "forwards"
                    });
                }, 550);

                // Phase 3: Switch theme under the hood when the screen is fully masked
                // (Starts at 700ms, right after background fade completes)
                setTimeout(function() {
                    document.documentElement.setAttribute("data-theme", newTheme);
                    localStorage.setItem("theme", newTheme);
                    var metaTheme = document.querySelector('meta[name="theme-color"]');
                    if (metaTheme) {
                        metaTheme.setAttribute("content", newTheme === "dark" ? "#000000" : "#f5f6f8");
                    }
                }, 700);

                // Phase 4: Shrink circle back to click point to reveal the page
                // (Starts at 750ms, allowing a short 50ms pause for visual pacing)
                setTimeout(function() {
                    var shrinkAnimation = circle.animate([
                        { transform: "scale(" + targetScale + ")" },
                        { transform: "scale(0)" }
                    ], {
                        duration: 550, // Slow & premium contraction
                        easing: "cubic-bezier(0.76, 0, 0.24, 1)",
                        fill: "forwards"
                    });

                    shrinkAnimation.onfinish = function() {
                        overlay.remove();
                        isTransitioning = false;
                    };
                }, 750);
            });
        });

        // ──────────────────────────────────────────────────
        // 1. Scroll Handler — Smooth Morphing Desktop Pill & Mobile Sticky
        // ──────────────────────────────────────────────────
        var isTicking = false;

        function updateScroll() {
            var currentScrollY = window.scrollY;

            if (window.innerWidth > 995) {
                if (currentScrollY > 30) {
                    header.classList.add("is-scrolled");
                    header.classList.add("is-sticky");
                } else {
                    header.classList.remove("is-scrolled");
                    header.classList.remove("is-sticky");
                }
            } else {
                if (currentScrollY > 20) {
                    header.classList.add("is-sticky");
                    header.classList.add("is-scrolled");
                } else {
                    header.classList.remove("is-sticky");
                    header.classList.remove("is-scrolled");
                }
            }
            
            isTicking = false;
        }

        function handleScroll() {
            if (!isTicking) {
                window.requestAnimationFrame(updateScroll);
                isTicking = true;
            }
        }

        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleScroll, { passive: true });
        updateScroll();

        // ──────────────────────────────────────────────────
        // 2. Hamburger menu (mobile)
        // ──────────────────────────────────────────────────
        var hamburger = document.getElementById("hamburger");
        var navMenu = document.getElementById("nav-menu");

        if (hamburger && navMenu) {
            hamburger.addEventListener("click", function (e) {
                e.stopPropagation();
                hamburger.classList.toggle("active");
                navMenu.classList.toggle("active");
                header.classList.toggle("menu-open");
            });

            document
                .querySelectorAll(".nav-link, .nav-cta-mobile")
                .forEach(function (link) {
                    link.addEventListener("click", function () {
                        hamburger.classList.remove("active");
                        navMenu.classList.remove("active");
                        header.classList.remove("menu-open");
                    });
                });

            // Close menu when clicking outside the menu panel or hamburger
            document.addEventListener("click", function (event) {
                var isClickInsideMenu = navMenu.contains(event.target);
                var isClickOnHamburger = hamburger.contains(event.target);

                if (
                    !isClickInsideMenu &&
                    !isClickOnHamburger &&
                    navMenu.classList.contains("active")
                ) {
                    hamburger.classList.remove("active");
                    navMenu.classList.remove("active");
                    header.classList.remove("menu-open");
                }
            });

            // Fullscreen mobile navigation DOM positioning (synchronized with CSS media query at 995px)
            var headerDesktopPill = document.querySelector(".header-desktop-pill");
            var headerActions = document.querySelector(".header-desktop-actions");

            var moveNav = function () {
                if (window.innerWidth <= 995) {
                    var wrapper = document.querySelector(".app-wrapper") || document.body;
                    if (navMenu.parentElement !== wrapper)
                        wrapper.appendChild(navMenu);
                } else {
                    if (headerDesktopPill && navMenu.parentElement !== headerDesktopPill) {
                        if (headerActions) {
                            headerDesktopPill.insertBefore(navMenu, headerActions);
                        } else {
                            headerDesktopPill.appendChild(navMenu);
                        }
                    }
                }
            };
            window.addEventListener("resize", moveNav, { passive: true });

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    function () {
                        requestAnimationFrame(moveNav);
                    },
                    { once: true },
                );
            } else {
                requestAnimationFrame(moveNav);
            }
        }

        // ──────────────────────────────────────────────────
        // 3. Mobile Floating Navigation Scroll Observer (Interactive Scroll Tracking)
        // ──────────────────────────────────────────────────
        var floatNav = document.getElementById("mobileFloatingNav");
        if (floatNav) {
            // Apply a fast transition to make the tracking extremely responsive and organic
            floatNav.style.transition = 'transform 0.15s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.15s ease';

            var lastScrollY = window.scrollY;
            var translateY = 0;

            var checkScroll = function () {
                var scrollHeight = document.documentElement.scrollHeight;
                var clientHeight = document.documentElement.clientHeight;
                var scrollTop = window.scrollY || document.documentElement.scrollTop;
                
                // Calculate floating nav height + bottom margin dynamically (approx 100px)
                var maxTranslate = (floatNav.offsetHeight || 60) + 32;
                
                // Scroll difference
                var currentScrollY = window.scrollY;
                var delta = currentScrollY - lastScrollY;
                lastScrollY = currentScrollY;

                // 1. Force hide at the bottom (within 80px threshold) to clear the footer
                if (scrollHeight - clientHeight - scrollTop < 80) {
                    floatNav.classList.add("floating-nav--hidden");
                    translateY = maxTranslate; // Reset offset so it doesn't pop up instantly when scrolling up
                } else {
                    floatNav.classList.remove("floating-nav--hidden");
                    
                    if (currentScrollY <= 0) {
                        translateY = 0; // Fully visible at the top
                    } else {
                        // Proportional scroll tracking
                        translateY = Math.max(0, Math.min(maxTranslate, translateY + delta));
                    }

                    // Apply proportional transformation and opacity
                    floatNav.style.transform = 'translateX(-50%) translateY(' + translateY + 'px)';
                    var opacity = 1 - (translateY / maxTranslate);
                    floatNav.style.opacity = opacity.toString();
                    floatNav.style.pointerEvents = opacity < 0.1 ? 'none' : 'auto';
                }
            };

            window.addEventListener("scroll", checkScroll, { passive: true });
            // Initial check
            requestAnimationFrame(checkScroll);
        }
    })();
</script>
