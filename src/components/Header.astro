---
interface Props {
    activePage?: string;
}

const { activePage = "" } = Astro.props;
const isHome = activePage === "home";
---

<header id="main-header">
    <!-- 1. DESKTOP NAGŁÓWEK: GÓRNA CZĘŚĆ (TOP TIER) -->
    <div class="header-top">
        <div class="header-top-container">
            <a href={isHome ? "#" : "/"} class="logo-text"
                >web2<span class="gradient__text">sell</span></a
            >
            <div class="header-top-right">
                <a href="tel:+48530315860" class="header-phone">
                    <i class="fa-solid fa-phone"></i>
                    <span>+48 530 315 860</span>
                </a>

                <!-- PRESTIŻOWY PRZEŁĄCZNIK MOTYWU (PASTYLKA Z SUWAKIEM) -->
                <button class="theme-switch-pill" aria-label="Zmień motyw">
                    <span class="pill-track">
                        <span class="pill-thumb">
                            <i class="fa-solid fa-sun sun-icon"></i>
                            <i class="fa-solid fa-moon moon-icon"></i>
                        </span>
                    </span>
                </button>

                <a href="/zamow" class="header-cta">Bezpłatna wycena</a>
            </div>
        </div>
    </div>

    <!-- 2. DESKTOP NAGŁÓWEK: DOLNA CZĘŚĆ (BOTTOM TIER) -->
    <div class="header-bottom">
        <div class="header-bottom-container">
            <!-- Dynamiczne Logo po scrollu, domyślnie ukryte na samej górze -->
            <a href={isHome ? "#" : "/"} class="logo-text-scrolled"
                >web2<span class="gradient__text">sell</span></a
            >

            <nav id="nav-menu">
                <a
                    href={isHome ? "#o-nas" : "/#o-nas"}
                    class="nav-link"
                    >O nas</a
                >
                <a href={isHome ? "#projekty" : "/#projekty"} class="nav-link"
                    >Realizacje</a
                >
                <a
                    href="/cennik"
                    class:list={[
                        "nav-link",
                        { active: activePage === "cennik" },
                    ]}>Cennik</a
                >
                <a
                    href="/jak-dzialamy"
                    class:list={[
                        "nav-link",
                        { active: activePage === "jak-dzialamy" },
                    ]}>Jak działamy?</a
                >
                <a href="/jak-dzialamy#faq" class="nav-link">FAQ</a>
                <a
                    href="/blog"
                    class:list={["nav-link", { active: activePage === "blog" }]}
                    >Blog</a
                >

                <!-- Dedykowane szczegóły kontaktu wyświetlane na dole rozwijanego drawer menu na mobile -->
                <div class="mobile-menu-footer">
                    <div class="mobile-menu-theme-row">
                        <span class="theme-label">Motyw:</span>
                        <button
                            class="theme-switch-pill"
                            aria-label="Zmień motyw"
                        >
                            <span class="pill-track">
                                <span class="pill-thumb">
                                    <i class="fa-solid fa-sun sun-icon"></i>
                                    <i class="fa-solid fa-moon moon-icon"></i>
                                </span>
                            </span>
                        </button>
                    </div>
                    <a href="tel:+48530315860" class="mobile-menu-phone">
                        <i class="fa-solid fa-phone"></i> +48 530 315 860
                    </a>
                    <a href="/zamow" class="mobile-menu-cta">Bezpłatna wycena</a
                    >
                </div>
            </nav>

            <!-- Dynamiczna prawa sekcja po scrollu (theme + CTA) -->
            <div class="header-right-scrolled">
                <button class="theme-switch-pill" aria-label="Zmień motyw">
                    <span class="pill-track">
                        <span class="pill-thumb">
                            <i class="fa-solid fa-sun sun-icon"></i>
                            <i class="fa-solid fa-moon moon-icon"></i>
                        </span>
                    </span>
                </button>
                <a href="/zamow" class="header-cta-scrolled">Bezpłatna wycena</a
                >
            </div>
        </div>
    </div>

    <!-- 3. MOBILNY NAGŁÓWEK (COMPACT SINGLE ROW) -->
    <div class="header-mobile-row">
        <a href={isHome ? "#" : "/"} class="logo-text"
            >web2<span class="gradient__text">sell</span></a
        >

        <div class="header-mobile-actions">
            <!-- Widoczny przycisk Zamów wycenę od razu na mobile (chowa się przy open menu) -->
            <a href="/zamow" class="mobile-visible-cta">Bezpłatna wycena</a>

            <!-- Hamburger menu -->
            <div class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</header>

<!-- 4. MOBILNE PŁYWAJĄCE MENU (FLOATING BOTTOM NAV) -->
<div class="mobile-floating-nav" id="mobileFloatingNav">
    <a
        href="/cennik"
        class:list={[
            "floating-nav-item",
            { active: activePage === "cennik" },
        ]}
        aria-label="Cennik"
    >
        <i class="fa-solid fa-dollar-sign"></i>
        <span>Cennik</span>
    </a>
    <a
        href="/zamow"
        class:list={[
            "floating-nav-item",
            { active: activePage === "zamow" },
        ]}
        aria-label="Wycena"
    >
        <i class="fa-solid fa-file-invoice-dollar"></i>
        <span>Wycena</span>
    </a>
    <a href="tel:+48530315860" class="floating-nav-item" aria-label="Zadzwoń">
        <i class="fa-solid fa-phone"></i>
        <span>Zadzwoń</span>
    </a>
</div>

<script>
    (function () {
        var header = document.getElementById("main-header");
        if (!header) return;

        // ──────────────────────────────────────────────────
        // Theme Toggle Handler (Syncing both Desktop & Mobile Toggles)
        // ──────────────────────────────────────────────────
        var themeToggles = document.querySelectorAll(".theme-switch-pill");
        themeToggles.forEach(function (toggle) {
            toggle.addEventListener("click", function () {
                var currentTheme =
                    document.documentElement.getAttribute("data-theme");
                var newTheme = currentTheme === "dark" ? "light" : "dark";
                document.documentElement.setAttribute("data-theme", newTheme);
                localStorage.setItem("theme", newTheme);
            });
        });

        // ──────────────────────────────────────────────────
        // 1. Scroll Handler — Directional Smart Show/Hide Top Tier
        //    Uses a delta threshold so navbar doesn't react to 1px changes
        // ──────────────────────────────────────────────────
        var lastScrollY = window.scrollY;
        var isTicking = false;
        var unstickyTimeout = null;
        var entranceTimeout = null;

        function updateScroll() {
            var currentScrollY = window.scrollY;

            if (window.innerWidth > 995) {
                if (currentScrollY <= 200) {
                    if (header.classList.contains("is-sticky") && !header.classList.contains("unsticky-animating")) {
                        header.classList.add("unsticky-animating");
                        
                        if (unstickyTimeout) clearTimeout(unstickyTimeout);
                        unstickyTimeout = setTimeout(function () {
                            header.classList.remove("is-sticky");
                            header.classList.remove("unsticky-animating");
                            unstickyTimeout = null;
                            
                            header.classList.add("top-header-entrance");
                            if (entranceTimeout) clearTimeout(entranceTimeout);
                            entranceTimeout = setTimeout(function () {
                                header.classList.remove("top-header-entrance");
                                entranceTimeout = null;
                            }, 200);
                        }, 200);
                    }
                } else {
                    if (unstickyTimeout) {
                        clearTimeout(unstickyTimeout);
                        unstickyTimeout = null;
                    }
                    if (entranceTimeout) {
                        clearTimeout(entranceTimeout);
                        entranceTimeout = null;
                    }
                    header.classList.remove("top-header-entrance");
                    header.classList.remove("unsticky-animating");
                    header.classList.add("is-sticky");
                }
            } else {
                if (currentScrollY <= 200) {
                    header.classList.remove("is-sticky");
                } else {
                    header.classList.add("is-sticky");
                }
                header.classList.remove("unsticky-animating");
                header.classList.remove("top-header-entrance");
                if (unstickyTimeout) {
                    clearTimeout(unstickyTimeout);
                    unstickyTimeout = null;
                }
                if (entranceTimeout) {
                    clearTimeout(entranceTimeout);
                    entranceTimeout = null;
                }
            }
            
            isTicking = false;
        }

        function handleScroll() {
            if (!isTicking) {
                window.requestAnimationFrame(updateScroll);
                isTicking = true;
            }
        }

        window.addEventListener("scroll", handleScroll, { passive: true });
        updateScroll();

        // ──────────────────────────────────────────────────
        // 2. Hamburger menu (mobile)
        // ──────────────────────────────────────────────────
        var hamburger = document.getElementById("hamburger");
        var navMenu = document.getElementById("nav-menu");

        if (hamburger && navMenu) {
            hamburger.addEventListener("click", function (e) {
                e.stopPropagation();
                hamburger.classList.toggle("active");
                navMenu.classList.toggle("active");
                header.classList.toggle("menu-open");
            });

            document
                .querySelectorAll(".nav-link, .nav-cta-mobile")
                .forEach(function (link) {
                    link.addEventListener("click", function () {
                        hamburger.classList.remove("active");
                        navMenu.classList.remove("active");
                        header.classList.remove("menu-open");
                    });
                });

            // Close menu when clicking outside the menu panel or hamburger
            document.addEventListener("click", function (event) {
                var isClickInsideMenu = navMenu.contains(event.target);
                var isClickOnHamburger = hamburger.contains(event.target);

                if (
                    !isClickInsideMenu &&
                    !isClickOnHamburger &&
                    navMenu.classList.contains("active")
                ) {
                    hamburger.classList.remove("active");
                    navMenu.classList.remove("active");
                    header.classList.remove("menu-open");
                }
            });

            // Fullscreen mobile navigation DOM positioning (synchronized with CSS media query at 995px)
            var headerBottomContainer = document.querySelector(
                ".header-bottom-container",
            );
            var moveNav = function () {
                if (window.innerWidth <= 995) {
                    if (navMenu.parentElement !== document.body)
                        document.body.appendChild(navMenu);
                } else {
                    if (
                        headerBottomContainer &&
                        navMenu.parentElement !== headerBottomContainer
                    ) {
                        headerBottomContainer.appendChild(navMenu);
                    }
                }
            };
            window.addEventListener("resize", moveNav, { passive: true });

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    function () {
                        requestAnimationFrame(moveNav);
                    },
                    { once: true },
                );
            } else {
                requestAnimationFrame(moveNav);
            }
        }

        // ──────────────────────────────────────────────────
        // 3. Mobile Floating Navigation Scroll Observer (Hides at the bottom of the page)
        // ──────────────────────────────────────────────────
        var floatNav = document.getElementById("mobileFloatingNav");
        if (floatNav) {
            var checkScrollBottom = function () {
                var scrollHeight = document.documentElement.scrollHeight;
                var clientHeight = document.documentElement.clientHeight;
                var scrollTop = window.scrollY || document.documentElement.scrollTop;
                
                // If we are at the very bottom (within 80px threshold)
                if (scrollHeight - clientHeight - scrollTop < 80) {
                    floatNav.classList.add("floating-nav--hidden");
                } else {
                    floatNav.classList.remove("floating-nav--hidden");
                }
            };

            window.addEventListener("scroll", checkScrollBottom, { passive: true });
            // Initial check
            requestAnimationFrame(checkScrollBottom);
        }
    })();
</script>
