---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  image: string;
  imageAlt?: string;
  author?: string;
}

import { Image } from 'astro:assets';

const { slug, title, description, pubDate, image, imageAlt = '', author = 'web2sell' } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('pl-PL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
};

// Obliczamy szacowany czas czytania na podstawie opisu (zakładając średnią prędkość czytania)
const calculateReadTime = (descText: string) => {
  const words = descText.split(/\s+/).length;
  const minutes = Math.max(2, Math.round(words / 15) + 1);
  return `${minutes} min czytania`;
};

const readTime = calculateReadTime(description);
---

<article class="blog-card">
    <!-- Górny pasek dekoracyjny świecący przy hoverze -->
    <div class="blog-card__accent-bar"></div>

    <div class="blog-card__image-container">
        <a href={`/blog/${slug}`} class="blog-card__image-link" aria-label={`Przeczytaj artykuł: ${title}`}>
            <Image src={image} alt={imageAlt} width={600} height={400} class="blog-card__image" loading="lazy" />
            <div class="blog-card__image-overlay"></div>
        </a>
        <div class="blog-card__badge">
            <i class="fa-regular fa-user"></i> {author}
        </div>
    </div>

    <div class="blog-card__content">
        <div class="blog-card__meta">
            <time datetime={pubDate.toISOString()} class="blog-card__meta-item">
                <i class="fa-regular fa-calendar-days"></i> {formatDate(pubDate)}
            </time>
            <span class="blog-card__meta-divider">•</span>
            <span class="blog-card__meta-item">
                <i class="fa-regular fa-clock"></i> {readTime}
            </span>
        </div>

        <h3 class="blog-card__title">
            <a href={`/blog/${slug}`}>{title}</a>
        </h3>

        <p class="blog-card__desc">
            {description.length > 180 ? `${description.slice(0, 180)}...` : description}
        </p>

        <div class="blog-card__footer">
            <a href={`/blog/${slug}`} class="blog-card__link" aria-label={`Dowiedz się więcej o: ${title}`}>
                <span>Czytaj więcej</span>
                <i class="fa-solid fa-arrow-right-long"></i>
            </a>
        </div>
    </div>
</article>

<style>
    .blog-card {
        background: var(--card-grad-glass);
        border: 1px solid var(--glass-border);
        border-radius: 12px; /* Eleganckie, miękkie krawędzie premium */
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: var(--glass-shadow);
        transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), 
                    border-color 0.4s ease, 
                    box-shadow 0.4s ease;
        position: relative;
    }

    /* Górna luksusowa linia gradientu, która rozjaśnia się na hoverze */
    .blog-card__accent-bar {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        opacity: 0.15;
        transition: opacity 0.4s ease;
        z-index: 5;
    }

    .blog-card:hover {
        transform: translateY(-8px);
        border-color: var(--card-hover-border);
        box-shadow: 0 20px 40px rgba(139, 92, 246, 0.08), var(--glass-shadow);
    }

    .blog-card:hover .blog-card__accent-bar {
        opacity: 1;
    }

    .blog-card__image-container {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
        border-bottom: 1px solid var(--glass-border);
        border-top-left-radius: 11px; /* Dopasowane do krawędzi karty */
        border-top-right-radius: 11px;
    }

    .blog-card__image-link {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
    }

    .blog-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1), filter 0.6s ease;
    }

    .blog-card__image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(16, 16, 16, 0.4) 0%, rgba(16, 16, 16, 0) 100%);
        opacity: 0.8;
        transition: opacity 0.4s ease;
    }

    .blog-card:hover .blog-card__image {
        transform: scale(1.04);
        filter: brightness(1.05);
    }

    .blog-card:hover .blog-card__image-overlay {
        opacity: 0.3;
    }

    .blog-card__badge {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(16, 16, 16, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 30px; /* Elegancki, zaokrąglony kształt pastylki */
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        z-index: 2;
    }

    html[data-theme="light"] .blog-card__badge {
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(0, 0, 0, 0.06);
    }

    .blog-card__content {
        padding: 28px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        position: relative;
    }

    .blog-card__meta {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .blog-card__meta-item {
        font-size: 0.8rem;
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 400;
        opacity: 0.85;
    }

    .blog-card__meta-item i {
        color: var(--accent-cyan);
        font-size: 0.85rem;
    }

    .blog-card__meta-divider {
        color: var(--text-secondary);
        opacity: 0.4;
        font-size: 0.8rem;
    }

    .blog-card__title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.45rem;
        font-weight: 800;
        line-height: 1.35;
        margin: 0 0 14px;
        letter-spacing: -0.5px;
        text-align: left;
    }

    .blog-card__title a {
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.3s ease;
        position: relative;
        display: inline-block;
    }

    /* Podkreślenie tytułu przy hoverze całej karty */
    .blog-card:hover .blog-card__title a {
        color: var(--text-primary);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }

    .blog-card__desc {
        color: var(--text-secondary);
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0 0 24px;
        flex-grow: 1;
        font-weight: 300;
        opacity: 0.9;
        /* Bez overlay - tekst jest w pełni zaznaczalny */
        user-select: text;
    }

    .blog-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid var(--glass-border);
    }

    .blog-card__link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        border-radius: 30px;
        border: 1px solid var(--glass-border);
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-primary);
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: var(--glass-shadow);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    html[data-theme="light"] .blog-card__link {
        background: rgba(0, 0, 0, 0.02);
    }

    .blog-card__link i {
        font-size: 0.85rem;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        color: var(--accent-cyan);
    }

    .blog-card:hover .blog-card__link {
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
        border-color: transparent;
        color: #fff;
        box-shadow: 0 8px 20px rgba(6, 182, 212, 0.2);
    }

    .blog-card:hover .blog-card__link i {
        transform: translateX(4px);
        color: #fff;
    }

    @media (max-width: 600px) {
        .blog-card__content {
            padding: 22px;
        }
        .blog-card__title {
            font-size: 1.3rem;
            text-align: left;
        }
        .blog-card__image-container {
            height: 180px;
        }
        .blog-card__desc {
            text-align: left;
        }
    }
</style>
