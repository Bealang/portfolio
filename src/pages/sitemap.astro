---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import { getCollection } from "astro:content";

// Pobieranie dynamicznych kolekcji
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

const blogPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title="Mapa Witryny | web2sell"
    description="Przejrzysty spis treści serwisu web2sell. Znajdź wszystkie strony główne, realizacje oraz artykuły z bloga w jednym prostym miejscu."
    robots="noindex, follow"
>
    <Header activePage="sitemap" />

    <main class="sitemap-container">
        <HeroBg behindContent={true} />

        <div class="sitemap__header">
            <h1>Mapa <span class="gradient__text">Witryny</span></h1>
        </div>

        <div class="sitemap__simple-list">
            <ol>
                <li>
                    <a href="/">Strona główna</a>
                    <ol>
                        <li><a href="/#o-nas">O nas</a></li>
                        <li><a href="/#projekty">Nasze realizacje</a></li>
                        <li>
                            <a href="/jak-dzialamy"
                                >Jak działamy (Proces współpracy)</a>
                        </li>
                        <li>
                            <a href="/jak-dzialamy#faq"
                                >Najczęściej zadawane pytania (FAQ)</a>
                        </li>
                    </ol>
                </li>
                <li><a href="/cennik">Cennik usług</a></li>
                <li><a href="/zamow">Zamów bezpłatną wycenę</a></li>
                <li>
                    <a href="/#projekty">Nasze realizacje</a>
                    {
                        projects.length > 0 && (
                            <ol>
                                {projects.map((project) => (
                                    <li>
                                        <a href="/#projekty">
                                            {project.data.title}
                                        </a>
                                    </li>
                                ))}
                            </ol>
                        )
                    }
                </li>
                <li>
                    <a href="/blog">Nasz Blog</a>
                    {
                        blogPosts.length > 0 && (
                            <ol>
                                {blogPosts.map((post) => (
                                    <li>
                                        <a href={`/blog/${post.id}`}>
                                            {post.data.title}
                                        </a>
                                    </li>
                                ))}
                            </ol>
                        )
                    }
                </li>
                <li><a href="/polityka">Polityka prywatności i Cookies</a></li>
                <li><a href="/zasady-wspolpracy">Zasady współpracy</a></li>
                <li><a href="/sitemap">Mapa witryny</a></li>
            </ol>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .sitemap-container {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
        padding: 160px 20px 80px;
        min-height: 85vh;
        z-index: 2;
    }

    .sitemap__header {
        text-align: center;
        margin-bottom: 50px;
    }

    .sitemap__header h1 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -1px;
        margin: 0;
    }

    .sitemap__simple-list {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 50px;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
    }

    /* Prosta lista ol/li bez customowych styli */
    .sitemap__simple-list ol {
        padding-left: 24px;
        margin: 0;
    }

    .sitemap__simple-list li {
        margin-bottom: 8px;
        color: var(--text-primary);
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .sitemap__simple-list a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: var(--transition-smooth);
    }

    .sitemap__simple-list a:hover {
        color: var(--text-primary);
        text-decoration: underline;
    }

    .sitemap__simple-list ol ol {
        margin-top: 6px;
    }

    @media (max-width: 768px) {
        .sitemap-container {
            padding-top: 130px;
        }
        .sitemap__simple-list {
            padding: 30px 20px;
            border-radius: 16px;
        }
    }
</style>
