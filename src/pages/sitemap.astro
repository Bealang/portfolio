---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import { getCollection } from "astro:content";

// Pobieranie i sortowanie dynamicznych kolekcji
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

const blogPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) => {
    return date.toLocaleDateString("pl-PL", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};
---

<Layout
    title="Mapa Witryny | web2sell"
    description="Przejrzysty spis treści serwisu web2sell. Znajdź wszystkie strony główne, realizacje oraz artykuły z bloga w jednym miejscu."
    robots="noindex, follow"
>
    <Header activePage="sitemap" />

    <main class="sitemap-container">
        <HeroBg behindContent={true} />

        <div class="sitemap__header">
            <h1>Mapa <span class="gradient__text">Witryny</span></h1>
        </div>

        <div class="sitemap__grid">
            <!-- Karta 1: Strony Główne -->
            <section
                class="sitemap__card"
                data-aos="fade-up"
                data-aos-duration="600"
            >
                <h2 class="sitemap__card-title">
                    <i class="fa-solid fa-compass" aria-hidden="true"></i>
                    <span>Strony główne</span>
                </h2>
                <ul class="sitemap__list">
                    <li class="sitemap__item">
                        <a href="/" class="sitemap__link">
                            <i
                                class="fa-solid fa-chevron-right"
                                aria-hidden="true"></i>
                            <span>Strona główna</span>
                        </a>
                        <ul class="sitemap__sublist">
                            <li>
                                <a href="/#onas" class="sitemap__sublink"
                                    >O nas</a>
                            </li>
                            <li>
                                <a href="/#projekty" class="sitemap__sublink"
                                    >Nasze realizacje</a>
                            </li>
                            <li>
                                <a href="/#kontakt" class="sitemap__sublink"
                                    >Kontakt z nami</a>
                            </li>
                        </ul>
                    </li>
                    <li class="sitemap__item">
                        <a href="/cennik" class="sitemap__link">
                            <i
                                class="fa-solid fa-chevron-right"
                                aria-hidden="true"></i>
                            <span>Cennik usług</span>
                        </a>
                    </li>
                    <li class="sitemap__item">
                        <a href="/zamow" class="sitemap__link">
                            <i
                                class="fa-solid fa-chevron-right"
                                aria-hidden="true"></i>
                            <span>Zamów darmową wycenę</span>
                        </a>
                    </li>
                    <li class="sitemap__item">
                        <a href="/blog" class="sitemap__link">
                            <i
                                class="fa-solid fa-chevron-right"
                                aria-hidden="true"></i>
                            <span>Nasz Blog</span>
                        </a>
                    </li>
                    <li class="sitemap__item">
                        <a href="/polityka" class="sitemap__link">
                            <i
                                class="fa-solid fa-chevron-right"
                                aria-hidden="true"></i>
                            <span>Polityka prywatności i Cookies</span>
                        </a>
                    </li>
                </ul>
            </section>

            <!-- Karta 2: Nasze Realizacje -->
            <section
                class="sitemap__card"
                data-aos="fade-up"
                data-aos-duration="600"
                data-aos-delay="100"
            >
                <h2 class="sitemap__card-title">
                    <i class="fa-solid fa-laptop-code" aria-hidden="true"></i>
                    <span>Nasze realizacje</span>
                </h2>
                <ul class="sitemap__list">
                    {
                        projects.map((project) => (
                            <li class="sitemap__item">
                                <a
                                    href={`/#projekty`}
                                    class="sitemap__link"
                                    title={`Otwórz projekt: ${project.data.title}`}
                                >
                                    <i
                                        class="fa-solid fa-chevron-right"
                                        aria-hidden="true"
                                    />
                                    <span>{project.data.title}</span>
                                </a>
                                <span class="sitemap__tag">
                                    {project.data.tag}
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <!-- Karta 3: Artykuły na Blogu -->
            <section
                class="sitemap__card"
                data-aos="fade-up"
                data-aos-duration="600"
                data-aos-delay="200"
            >
                <h2 class="sitemap__card-title">
                    <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
                    <span>Artykuły na blogu</span>
                </h2>
                <ul class="sitemap__list">
                    {
                        blogPosts.map((post) => (
                            <li class="sitemap__item">
                                <a
                                    href={`/blog/${post.id}`}
                                    class="sitemap__link"
                                >
                                    <i
                                        class="fa-solid fa-chevron-right"
                                        aria-hidden="true"
                                    />
                                    <span>{post.data.title}</span>
                                </a>
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                    class="sitemap__date"
                                >
                                    {formatDate(post.data.pubDate)}
                                </time>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .sitemap-container {
        position: relative;
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 160px 20px 80px;
        min-height: 85vh;
        z-index: 2;
    }

    .sitemap__header {
        text-align: center;
        margin-bottom: 60px;
    }

    .sitemap__header h1 {
        font-family: "Figtree", sans-serif;
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -1px;
        margin: 0 0 15px;
    }

    .sitemap__header p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .sitemap__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        align-items: stretch;
    }

    .sitemap__card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 35px 30px;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        transition:
            transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
            border-color 0.3s ease,
            box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .sitemap__card-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: "Figtree", sans-serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        border-bottom: 1px solid var(--glass-border);
        padding-bottom: 15px;
    }

    .sitemap__card-title i {
        color: var(--accent-blue);
        font-size: 20px;
    }

    .sitemap__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .sitemap__item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .sitemap__link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.98rem;
        font-weight: 500;
        transition: var(--transition-smooth);
        width: fit-content;
    }

    .sitemap__link i {
        font-size: 12px;
        color: var(--accent-cyan);
        transition:
            transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
            color 0.3s ease;
    }

    .sitemap__link:hover {
        color: var(--text-primary);
        transform: translateX(4px);
    }

    .sitemap__link:hover i {
        transform: translateX(3px);
        color: var(--accent-blue);
    }

    /* Sublinks for anchors */
    .sitemap__sublist {
        list-style: none;
        padding-left: 22px;
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-left: 1px solid var(--glass-border);
    }

    .sitemap__sublink {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: var(--transition-smooth);
    }

    .sitemap__sublink:hover {
        color: var(--text-primary);
        transform: translateX(3px);
    }

    .sitemap__date {
        font-size: 0.8rem;
        color: var(--text-muted);
        display: block;
        margin-left: 22px;
    }

    .sitemap__tag {
        font-size: 0.78rem;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 600;
        background: rgba(167, 139, 250, 0.08);
        color: var(--accent-blue);
        border: 1px solid rgba(167, 139, 250, 0.15);
        margin-left: 22px;
        width: fit-content;
    }

    @media (max-width: 992px) {
        .sitemap__grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .sitemap-container {
            padding-top: 130px;
        }
        .sitemap__grid {
            grid-template-columns: 1fr;
        }
        .sitemap__card {
            padding: 30px 24px;
        }
    }
</style>
