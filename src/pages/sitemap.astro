---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import { getCollection } from "astro:content";

// Pobieranie dynamicznych kolekcji
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

const blogPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title="Mapa Witryny | web2sell"
    description="Przejrzysty spis treści serwisu web2sell. Znajdź wszystkie strony główne, realizacje oraz artykuły z bloga w jednym prostym miejscu."
    robots="noindex, follow"
>
    <Header activePage="sitemap" />

    <main class="sitemap-container">
        <HeroBg behindContent={true} />

        <div class="sitemap__header">
            <h1>Mapa <span class="gradient__text">Witryny</span></h1>
        </div>

        <div class="sitemap__simple-list reveal-element">
            <ul class="sitemap-root">
                <li>
                    <a href="/" class="sitemap-main-link">Strona główna</a>
                    <ul>
                        <li><a href="/o-nas">O nas</a></li>
                        <li><a href="/#projekty">Nasze realizacje</a></li>
                        <li><a href="/jak-dzialamy">Jak działamy (Proces współpracy)</a></li>
                        <li><a href="/jak-dzialamy#faq">Najczęściej zadawane pytania (FAQ)</a></li>
                    </ul>
                </li>
                <li>
                    <a href="/cennik" class="sitemap-main-link">Cennik usług</a>
                </li>
                <li>
                    <a href="/zamow" class="sitemap-main-link">Zamów bezpłatną wycenę</a>
                </li>
                <li>
                    <a href="/#projekty" class="sitemap-main-link">Nasze realizacje</a>
                    {projects.length > 0 && (
                        <ul>
                            {projects.map((project) => (
                                <li><a href="/#projekty">{project.data.title}</a></li>
                            ))}
                        </ul>
                    )}
                </li>
                <li>
                    <a href="/blog" class="sitemap-main-link">Nasz Blog</a>
                    {blogPosts.length > 0 && (
                        <ul>
                            {blogPosts.map((post) => (
                                <li><a href={`/blog/${post.id}`}>{post.data.title}</a></li>
                            ))}
                        </ul>
                    )}
                </li>
                <li>
                    <a href="/polityka" class="sitemap-main-link">Polityka prywatności i Cookies</a>
                </li>
            </ul>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .sitemap-container {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
        padding: 160px 20px 80px;
        min-height: 85vh;
        z-index: 2;
    }

    .sitemap__header {
        text-align: center;
        margin-bottom: 50px;
    }

    .sitemap__header h1 {
        font-family: "Figtree", sans-serif;
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -1px;
        margin: 0;
    }

    .sitemap__simple-list {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 50px;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
    }

    /* Simple ul li styling */
    .sitemap-root {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .sitemap-root li {
        position: relative;
    }

    .sitemap-root a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 1.05rem;
        font-weight: 500;
        transition: var(--transition-smooth);
        display: inline-block;
        padding: 2px 0;
    }

    .sitemap-root a:hover {
        color: var(--text-primary);
        transform: translateX(4px);
    }

    /* Main links style */
    .sitemap-main-link {
        font-size: 1.2rem !important;
        font-weight: 700 !important;
        color: var(--text-primary) !important;
        border-bottom: 2px solid transparent;
    }

    .sitemap-main-link:hover {
        color: var(--accent-blue) !important;
    }

    /* Nested ul li */
    .sitemap-root ul {
        list-style: none;
        padding-left: 24px;
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        border-left: 1px solid var(--glass-border);
    }

    .sitemap-root ul li {
        position: relative;
    }

    .sitemap-root ul li::before {
        content: "";
        position: absolute;
        left: -24px;
        top: 14px;
        width: 12px;
        height: 1px;
        background: var(--glass-border);
    }

    .sitemap-root ul a {
        font-size: 0.98rem;
        color: var(--text-muted);
    }

    .sitemap-root ul a:hover {
        color: var(--text-primary);
    }

    @media (max-width: 768px) {
        .sitemap-container {
            padding-top: 130px;
        }
        .sitemap__simple-list {
            padding: 30px 20px;
            border-radius: 16px;
        }
    }
</style>
