---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
    title="Kontakt & Bezpłatna Wycena | web2sell"
    description="Chcesz zamówić nową stronę internetową? Skontaktuj się z nami! Wypełnij formularz kontaktowy, a bezpłatną wycenę otrzymasz w ciągu 24 godzin."
>
    <Header activePage="kontakt" />

    <main class="kontakt-page">
        <HeroBg behindContent={true} />

        <section class="kontakt-sekcja reveal-element">
            <div class="kontakt-sekcja__container">
                <ContactForm />
            </div>
            
            <div class="google-map-embed kontakt-map reveal-element">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d489350.3443682875!2d19.536384132661276!3d49.958665938616434!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6447d991c045ed81%3A0x80337cb291998748!2sweb2sell!5e1!3m2!1spl!2spl!4v1779286812460!5m2!1spl!2spl"
                    width="100%"
                    height="400"
                    style="border:0; display:block;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Lokalizacja web2sell na mapie Google"></iframe>
            </div>
        </section>
    </main>

    <Footer />

    <!-- Scroll Reveal Animations Script -->
    <script is:inline>
        (function () {
            var revealElements = document.querySelectorAll(".reveal-element");
            if ("IntersectionObserver" in window && revealElements.length > 0) {
                var verticalObserver = new IntersectionObserver(
                    function (entries, observer) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("reveal--visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    {
                        rootMargin: "0px 0px -80px 0px",
                        threshold: 0.05,
                    },
                );

                revealElements.forEach(function (el) {
                    verticalObserver.observe(el);
                });
            } else {
                revealElements.forEach(function (el) {
                    el.classList.add("reveal--visible");
                });
            }
        })();
    </script>
</Layout>
