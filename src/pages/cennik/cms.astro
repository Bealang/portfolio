---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HeroBg from "../../components/HeroBg.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<Layout
    title="Wizytówka + CMS – Cennik, Zakres i Korzyści | web2sell"
    description="Poznaj pakiet Wizytówka + CMS od web2sell. Nowoczesna strona wielopodstronowa z autorskim, prostym panelem administracyjnym bez WordPressa. Sprawdź szczegóły!"
>
    <Header activePage="cennik" />

    <main class="cennik-page service-detail-page">
        <HeroBg behindContent={true} />

        <div class="service-container">
            <!-- HERO SEKCYJNE -->
            <header class="service-hero reveal-element">
                <h1 class="service-hero__title">
                    Wizytówka + CMS – <span class="gradient__text">pełna niezależność</span> i kontrola nad Twoją stroną
                </h1>
                <p class="service-hero__lead">
                    Pełnowymiarowa strona podzielona na 2-5 dedykowanych podstron z autorskim, banalnie prostym panelem do zarządzania treścią. Samodzielnie edytujesz ofertę, cenniki i zdjęcia w kilka sekund bez pomocy programisty.
                </p>

                <div class="service-hero__actions">
                    <a href="/zamow?pakiet=cms" class="pricing-btn primary hero-cta-btn">
                        <span>Wybierz pakiet CMS</span>
                        <i class="fa-solid fa-arrow-right icon-slide"></i>
                    </a>
                    <a href="/cennik" class="pricing-btn secondary hero-back-btn">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Wróć do pełnego cennika</span>
                    </a>
                </div>
            </header>

            <!-- CZYM JEST CMS OD WEB2SELL? -->
            <section class="service-section reveal-element" id="dlaczego-nasz-cms">
                <h2 class="section-title">Dlaczego autorski CMS deklasuje ociężałego WordPressa?</h2>
                <div class="concept-grid">
                    <div class="concept-card concept-card--highlight">
                        <div class="concept-card__icon">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <h3>Banalnie prosty panel stworzony pod Ciebie</h3>
                        <p>
                            Zamiast skomplikowanego, przeładowanego panelu WordPressa z tysiącem niepotrzebnych opcji, otrzymujesz <strong>czysty, intuicyjny panel po polsku</strong>. Zmiana ceny, dodanie nowego zdjęcia z telefonu czy publikacja nowości zajmuje dosłownie 15 sekund.
                        </p>
                        <p>
                            Dostęp jest zabezpieczony szyfrowaniem, a interfejs działa bezawaryjnie na komputerze i smartfonie.
                        </p>
                    </div>
                    <div class="concept-card">
                        <div class="concept-card__icon">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <h3>Zero psujących się wtyczek i 100% bezpieczeństwa</h3>
                        <p>
                            Klasyczny WordPress wymaga ciągłych aktualizacji wtyczek, które często psują wygląd strony lub stają się furtką dla hakerów.
                        </p>
                        <p>
                            W web2sell budujemy panel w nowoczesnej architekturze – Twoja strona jest <strong>ultraszybka, odporna na ataki</strong> i nie wymaga comiesięcznych płatnych napraw informatycznych.
                        </p>
                    </div>
                </div>
            </section>

            <!-- CO ZNAJDUJE SIĘ W PAKIECIE CMS? (ANATOMIA KROK PO KROKU) -->
            <section class="service-section reveal-element" id="anatomia-cms">
                <h2 class="section-title">Co realnie znajduje się w pakiecie Wizytówka + CMS?</h2>
                <p class="section-subtitle">
                    To kompleksowe narzędzie wizerunkowo-sprzedażowe, które buduje pozycję lidera w Twojej branży:
                </p>

                <div class="anatomy-grid">
                    <!-- Punkt 1 -->
                    <div class="anatomy-card">
                        <div class="anatomy-step">01</div>
                        <div class="anatomy-icon-wrap">
                            <i class="fa-solid fa-sitemap"></i>
                        </div>
                        <div class="anatomy-body">
                            <h3>1. Od 2 do 5 dedykowanych podstron</h3>
                            <p>
                                Profesjonalnie zaprojektowana architektura informacji: Strona Główna, O nas, Osobne podstrony dla kluczowych usług, Galeria / Realizacje oraz Kontakt. Każda podstrona posiada własną, staranną optymalizację pod wyszukiwarkę Google.
                            </p>
                        </div>
                    </div>

                    <!-- Punkt 2 -->
                    <div class="anatomy-card">
                        <div class="anatomy-step">02</div>
                        <div class="anatomy-icon-wrap">
                            <i class="fa-solid fa-sliders"></i>
                        </div>
                        <div class="anatomy-body">
                            <h3>2. Autorski panel administracyjny (CMS)</h3>
                            <p>
                                Bezpieczny panel z dedykowanym logowaniem. Zmieniaj numery telefonów, godziny otwarcia, cenniki, opisy usług oraz dodawaj nowe wpisy lub zdjęcia jednym kliknięciem.
                            </p>
                        </div>
                    </div>

                    <!-- Punkt 3 -->
                    <div class="anatomy-card">
                        <div class="anatomy-step">03</div>
                        <div class="anatomy-icon-wrap">
                            <i class="fa-solid fa-images"></i>
                        </div>
                        <div class="anatomy-body">
                            <h3>3. Interaktywna galeria realizacji i portfolio</h3>
                            <p>
                                Prezentacja Twoich prac z filtrowaniem kategorii, zoomem zdjęć i automatyczną kompresją do formatów nowej generacji (WebP/AVIF), by strona ładowała się natychmiastowo.
                            </p>
                        </div>
                    </div>

                    <!-- Punkt 4 -->
                    <div class="anatomy-card">
                        <div class="anatomy-step">04</div>
                        <div class="anatomy-icon-wrap">
                            <i class="fa-solid fa-server"></i>
                        </div>
                        <div class="anatomy-body">
                            <h3>4. Darmowy hosting + domena .pl na 1 rok</h3>
                            <p>
                                W cenie pakietu otrzymujesz szybki serwer SSD oraz rejestrację polskiej domeny .pl na pierwsze 12 miesięcy. Wszystko konfigurujemy za Ciebie.
                            </p>
                        </div>
                    </div>

                    <!-- Punkt 5 -->
                    <div class="anatomy-card">
                        <div class="anatomy-step">05</div>
                        <div class="anatomy-icon-wrap">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <div class="anatomy-body">
                            <h3>5. Aż 6 miesięcy bezpłatnej opieki technicznej</h3>
                            <p>
                                Przez pół roku po wdrożeniu masz naszą pełną gwarancję i wsparcie techniczne. Masz pytanie lub potrzebujesz podpowiedzi? Pomagamy od ręki.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- KORZYŚCI DLA FIRMY -->
            <section class="service-section reveal-element" id="korzysci-cms">
                <h2 class="section-title">Jakie realne korzyści zyskuje Twoja firma?</h2>
                <p class="section-subtitle">
                    Pakiet CMS to idealny balans pomiędzy potężnymi możliwościami a prostotą obsługi:
                </p>

                <div class="benefits-grid">
                    <div class="benefit-box">
                        <div class="benefit-box__header">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <h3>100% niezależności</h3>
                        </div>
                        <p>
                            Nie musisz płacić informatykowi ani czekać dniami na zmianę numeru telefonu czy dodanie nowego zdjęcia. Wchodzisz do panelu i zmieniasz to sam w kilkanaście sekund.
                        </p>
                    </div>

                    <div class="benefit-box">
                        <div class="benefit-box__header">
                            <i class="fa-solid fa-chart-line"></i>
                            <h3>Silniejsza pozycja w Google</h3>
                        </div>
                        <p>
                            Osobne podstrony dla każdej usługi pozwalają zdobywać wysokie pozycje na dziesiątki zapytań lokalnych klientów, budując stały dopływ zleceń.
                        </p>
                    </div>

                    <div class="benefit-box">
                        <div class="benefit-box__header">
                            <i class="fa-solid fa-building-circle-check"></i>
                            <h3>Wizerunek stabilnego lidera</h3>
                        </div>
                        <p>
                            Rozbudowana witryna z historią firmy, certyfikatami i obszernym portfolio buduje autorytet i pozwala wygrywać przetargi oraz zlecenia premium.
                        </p>
                    </div>

                    <div class="benefit-box">
                        <div class="benefit-box__header">
                            <i class="fa-solid fa-gift"></i>
                            <h3>Hosting i domena w cenie</h3>
                        </div>
                        <p>
                            Przez pierwszy rok nie martwisz się żadnymi opłatami serwerowymi ani domenowymi. Wszystko jest wliczone w jednorazowy koszt wdrożenia.
                        </p>
                    </div>

                    <div class="benefit-box">
                        <div class="benefit-box__header">
                            <i class="fa-solid fa-user-shield"></i>
                            <h3>Pół roku spokoju i opieki</h3>
                        </div>
                        <p>
                            6 miesięcy dedykowanej opieki w pakiecie. Jeśli będziesz mieć jakiekolwiek pytania, nasz zespół jest do Twojej stałej dyspozycji.
                        </p>
                    </div>

                    <div class="benefit-box">
                        <div class="benefit-box__header">
                            <i class="fa-solid fa-gauge-high"></i>
                            <h3>Maksymalna wydajność kodu</h3>
                        </div>
                        <p>
                            Pomimo wielu podstron i panelu CMS, strona ładuje się błyskawicznie dzięki nowoczesnemu silnikowi, zachowując zielone wyniki w Google PageSpeed.
                        </p>
                    </div>
                </div>
            </section>

            <!-- DLA KOGO CMS? -->
            <section class="service-section reveal-element" id="dla-kogo-cms">
                <h2 class="section-title">Dla kogo pakiet Wizytówka + CMS to najlepszy wybór?</h2>
                <div class="audience-grid">
                    <div class="audience-card">
                        <div class="audience-icon">
                            <i class="fa-solid fa-hammer"></i>
                        </div>
                        <h4>Firmy z bogatą ofertą</h4>
                        <p>
                            Przedsiębiorstwa oferujące wiele zróżnicowanych usług, które wymagają szczegółowego opisu na dedykowanych podstronach.
                        </p>
                    </div>

                    <div class="audience-card">
                        <div class="audience-icon">
                            <i class="fa-solid fa-camera-retro"></i>
                        </div>
                        <h4>Branże bazujące na zdjęciach</h4>
                        <p>
                            Projektanci wnętrz, producenci mebli, salony meblowe, wykonawcy remontów i firmy pokazujące regularnie nowe realizacje.
                        </p>
                    </div>

                    <div class="audience-card">
                        <div class="audience-icon">
                            <i class="fa-solid fa-hotel"></i>
                        </div>
                        <h4>Turystyka, gastronomia i eventy</h4>
                        <p>
                            Restauracje ze zmieniającym się menu, pensjonaty, apartamenty i sale weselne aktualizujące cenniki sezonowe.
                        </p>
                    </div>

                    <div class="audience-card">
                        <div class="audience-icon">
                            <i class="fa-solid fa-newspaper"></i>
                        </div>
                        <h4>Firmy stawiające na blog i SEO</h4>
                        <p>
                            Marki, które chcą budować widoczność organiczną w wyszukiwarce za pomocą wartościowych artykułów i poradników.
                        </p>
                    </div>
                </div>
            </section>

            <!-- PODSUMOWANIE PAKIETU I CENA -->
            <section class="service-section reveal-element" id="cennik-box-cms">
                <div class="pricing-summary-card">
                    <div class="summary-left">
                        <h2 class="summary-title">Wizytówka + CMS – Najpopularniejszy wybór</h2>
                        <div class="summary-price">
                            od <span class="price-big">2 290</span> <span class="currency">zł netto</span>
                            <span class="price-gross">/ 2 817 zł brutto</span>
                        </div>
                        <a href="/zamow?pakiet=cms" class="pricing-btn primary highlight-cta">
                            <span>Wybierz pakiet CMS</span>
                            <i class="fa-solid fa-chevron-right icon-slide"></i>
                        </a>
                    </div>
                    <div class="summary-right">
                        <h3 class="included-title">Co dokładnie otrzymujesz w cenie:</h3>
                        <ul class="included-list">
                            <li><i class="fa-solid fa-circle-check"></i> Podział na 2-5 unikalnie zaprojektowanych podstron</li>
                            <li><i class="fa-solid fa-circle-check"></i> Autorski, prosty panel CMS po polsku (edycja tekstów i zdjęć)</li>
                            <li><i class="fa-solid fa-circle-check"></i> Darmowy hosting SSD i polska domena .pl na 1 rok</li>
                            <li><i class="fa-solid fa-circle-check"></i> Aż 6 miesięcy bezpłatnej opieki technicznej i gwarancji</li>
                            <li><i class="fa-solid fa-circle-check"></i> Wizytówka Google Maps w cenie</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- SEKCJA FAQ (SPÓJNA ZE STRONĄ JAK DZIAŁAMY) -->
            <section id="faq" class="zamow-faq">
                <div class="zamow-faq__header reveal-element">
                    <h2>
                        Najczęściej zadawane <span class="gradient__text">pytania</span>
                    </h2>
                </div>

                <div class="faq-list reveal-element">
                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            <span>Czy poradzę sobie z obsługą panelu bez wiedzy informatycznej?</span>
                            <i class="fa-solid fa-chevron-down faq-item__chevron"></i>
                        </button>
                        <div class="faq-item__answer">
                            <p>
                                <strong>Jak najbardziej.</strong> Projektujemy panel tak, by był maksymalnie intuicyjny – przypomina edycję prostego dokumentu tekstowego. Po wdrożeniu przygotowujemy dla Ciebie krótką instrukcję i pokazujemy, jak w kilka sekund dodać zdjęcie czy zmienić treść.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            <span>Czy mogę edytować stronę ze smartfona?</span>
                            <i class="fa-solid fa-chevron-down faq-item__chevron"></i>
                        </button>
                        <div class="faq-item__answer">
                            <p>
                                <strong>Tak.</strong> Panel administracyjny jest w 100% dostosowany do urządzeń mobilnych. Możesz zrobić zdjęcie telefonem i od razu wrzucić je do galerii realizacji na stronie.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            <span>Ile trwa realizacja strony w pakiecie CMS?</span>
                            <i class="fa-solid fa-chevron-down faq-item__chevron"></i>
                        </button>
                        <div class="faq-item__answer">
                            <p>
                                Standardowy czas realizacji pakietu Wizytówka + CMS wynosi <strong>od 1 do 2 tygodni</strong> od momentu zatwierdzenia materiałów i układu.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            <span>Czy w przyszłości mogę dodać kolejne podstrony?</span>
                            <i class="fa-solid fa-chevron-down faq-item__chevron"></i>
                        </button>
                        <div class="faq-item__answer">
                            <p>
                                <strong>Oczywiście.</strong> Strona rośnie razem z Twoją firmą. W dowolnym momencie możemy dołożyć kolejne podstrony usług, moduł sklepu czy system rezerwacji online.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- FORMULARZ KONTAKTOWY ZAMIAST GENERYCZNEGO CTA -->
    <ContactForm />

    <Footer />

    <!-- FAQ Accordion Script -->
    <script is:inline>
        (function () {
            var questions = document.querySelectorAll(".faq-item__question");
            questions.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var item = btn.closest(".faq-item");
                    var isOpen = item.classList.contains("is-open");

                    // Close all others
                    document
                        .querySelectorAll(".faq-item.is-open")
                        .forEach(function (openItem) {
                            openItem.classList.remove("is-open");
                            openItem
                                .querySelector(".faq-item__question")
                                .setAttribute("aria-expanded", "false");
                        });

                    // Toggle current
                    if (!isOpen) {
                        item.classList.add("is-open");
                        btn.setAttribute("aria-expanded", "true");
                    }
                });
            });
        })();
    </script>

    <!-- Scroll Reveal Script -->
    <script is:inline>
        (function () {
            var revealElements = document.querySelectorAll(".reveal-element");
            if ("IntersectionObserver" in window && revealElements.length > 0) {
                var observer = new IntersectionObserver(
                    function (entries, obs) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("reveal--visible");
                                obs.unobserve(entry.target);
                            }
                        });
                    },
                    {
                        rootMargin: "0px 0px -60px 0px",
                        threshold: 0.05,
                    }
                );

                revealElements.forEach(function (el) {
                    observer.observe(el);
                });
            } else {
                revealElements.forEach(function (el) {
                    el.classList.add("reveal--visible");
                });
            }
        })();
    </script>
</Layout>

<style>
    .service-detail-page {
        padding-top: 140px;
        padding-bottom: 80px;
    }

    .service-container {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    /* SERVICE HERO */
    .service-hero {
        text-align: center;
        max-width: 920px;
        margin: 20px auto 70px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .service-hero__title {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(32px, 5vw, 52px);
        font-weight: 800;
        line-height: 1.18;
        color: var(--text-primary);
        margin: 0 0 22px;
    }

    .service-hero__lead {
        font-size: clamp(16px, 2vw, 19px);
        color: var(--text-secondary);
        line-height: 1.65;
        margin: 0 0 35px;
        max-width: 780px;
    }

    .service-hero__actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        font-size: 17px;
        font-weight: 700;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(var(--accent-blue-rgb), 0.25);
    }

    .hero-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 28px;
        font-size: 16px;
        border-radius: 14px;
        background: var(--card-grad-glass);
        border: 1px solid var(--glass-border);
        color: var(--text-primary);
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .hero-back-btn:hover {
        transform: translateY(-2px);
        border-color: var(--accent-blue);
    }

    /* COMMON SECTIONS */
    .service-section {
        margin-bottom: 75px;
    }

    .section-title {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(26px, 3.5vw, 38px);
        font-weight: 800;
        color: var(--text-primary);
        margin: 0 0 16px;
        line-height: 1.2;
        text-align: left;
    }

    .section-subtitle {
        font-size: 17px;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 35px;
        max-width: 800px;
        text-align: left;
    }

    /* CONCEPT GRID */
    .concept-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .concept-card {
        background: var(--card-grad-glass);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 35px;
        box-shadow: var(--glass-shadow);
        text-align: left;
    }

    .concept-card--highlight {
        border-color: rgba(var(--accent-blue-rgb), 0.35);
        background: linear-gradient(135deg, rgba(var(--accent-blue-rgb), 0.04) 0%, rgba(var(--accent-cyan-rgb), 0.02) 100%), var(--card-grad-glass);
    }

    .concept-card__icon {
        font-size: 32px;
        color: var(--accent-blue);
        margin-bottom: 20px;
    }

    .concept-card h3 {
        font-size: 22px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 14px;
    }

    .concept-card p {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.65;
        margin: 0 0 12px;
    }

    .concept-card p:last-child {
        margin-bottom: 0;
    }

    /* ANATOMY GRID */
    .anatomy-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .anatomy-card {
        display: grid;
        grid-template-columns: 60px 50px 1fr;
        align-items: center;
        gap: 20px;
        background: var(--card-grad-glass);
        border: 1px solid var(--glass-border);
        border-radius: 18px;
        padding: 24px 30px;
        box-shadow: var(--glass-shadow);
        text-align: left;
    }

    .anatomy-step {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 28px;
        font-weight: 850;
        color: rgba(var(--accent-blue-rgb), 0.35);
        line-height: 1;
    }

    .anatomy-icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: rgba(var(--accent-blue-rgb), 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: var(--accent-blue);
    }

    .anatomy-body h3 {
        font-size: 19px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 6px;
    }

    .anatomy-body p {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
    }

    /* BENEFITS GRID */
    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
