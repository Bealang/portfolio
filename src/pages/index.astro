---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectModal from "../components/ProjectModal.astro";
import ContactForm from "../components/ContactForm.astro";
import { getCollection, render } from "astro:content";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

const renderedProjects = await Promise.all(
    projects.map(async (project) => {
        const { Content } = await render(project);
        return { ...project, Content };
    }),
);
---

<Layout
    title="Web2Sell | Tworzenie stron www Myślenice"
    description="Web2Sell - profesjonalne tworzenie stron www Myślenice. Nowoczesne, szybkie i responsywne strony internetowe dla firm. Zobacz nasze portfolio projektów i skontaktuj się!"
>
    <Header activePage="home" />

    <main id="onas" class="hero-section">
        <HeroBg />

        <div id="main__text" class="hero-content">
            <div class="hero-text-reveal">
                <h1
                    class="hero-seo-title"
                    data-aos="fade-down"
                    data-aos-duration="800"
                >
                    web2sell - Tworzenie stron internetowych Myślenice
                </h1>
                <h2 class="hero-title typing-stack">
                    <span id="type-title-ghost" class="ghost-layer"
                        >Zaprojektujemy.<br /><span
                            class="gradient__text text-glow"
                            data-text="Zbudujemy">Zbudujemy.</span
                        ><br />Od zera.<br />Dla Twojej firmy.</span
                    >
                    <span id="type-title" class="visible-layer"></span>
                </h2>
                <p class="hero-desc typing-stack">
                    <span id="type-desc-ghost" class="ghost-layer"
                        >W web2sell porzucamy popularne, obciążające systemy
                        zarządzania treścią na rzecz nowoczesnych rozwiązań
                        programistycznych. Budujemy witryny od podstaw,
                        wykorzystując autorski kod, który gwarantuje najwyższą
                        szybkość działania, bezpieczeństwo oraz pełną
                        optymalizację pod wyszukiwarki. Dzięki eliminacji
                        zbędnych wtyczek i szablonów, Twoja lokalna firma zyska
                        unikalne narzędzie, które zapewnia użytkownikom
                        błyskawiczny dostęp do informacji i realnie wspiera Twój
                        rozwój w sieci.</span
                    >
                    <span id="type-desc" class="visible-layer"></span>
                </p>
                <div
                    id="main__buttons"
                    class="hero-buttons"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                    data-aos-delay="2500"
                >
                    <a href="#projekty"
                        ><button class="btn-glass btn-primary"
                            >Nasze realizacje</button
                        ></a
                    >
                    <a href="#kontakt"
                        ><button class="btn-glass btn-secondary"
                            >Skontaktuj się</button
                        ></a
                    >
                </div>
            </div>
        </div>

