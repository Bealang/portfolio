---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { getCollection } from "astro:content";
import ONasTxt from "../components/o-nas-txt.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<Layout
    title="Web2Sell | Tworzenie stron www Myślenice"
    description="Web2Sell - profesjonalne tworzenie stron www Myślenice. Nowoczesne, szybkie i responsywne strony internetowe dla firm. Zobacz nasze portfolio projektów i skontaktuj się!"
>
    <Header activePage="home" />

    <main id="onas" class="hero-section">
        <HeroBg />

        <div id="main__text" class="hero-content">
            <div class="hero-text-reveal">
                <h1
                    class="hero-seo-title"
                    data-aos="fade-down"
                    data-aos-duration="800"
                >
                    Tworzenie stron internetowych Myślenice
                </h1>
                <h2 class="hero-title typing-stack">
                    <span id="type-title-ghost" class="ghost-layer"
                        >Zaprojektujemy.
                        <br /><span
                            class="gradient__text text-glow"
                            data-text="Zbudujemy">Zbudujemy.</span
                        >
                        <br />Od zera.
                        <br />Dla Twojej firmy.
                    </span>
                    <span id="type-title" class="visible-layer"></span>
                </h2>
                <div
                    id="main__buttons"
                    class="hero-buttons"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                    data-aos-delay="1800"
                >
                    <a href="#o-nas" class="btn-about">
                        <span>Poznaj nas</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a
                        href="tel:+48530315860"
                        class="btn-glass btn-secondary btn-call"
                    >
                        <i class="fa-solid fa-phone" style="margin-right: 8px;"
                        ></i>
                        <span
                            >Zadzwoń<span class="phone-number-desktop"
                                >: +48 530 315 860</span
                            ></span
                        >
                    </a>
                </div>

                <div
                    class="hero-badges"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                    data-aos-delay="2000"
                >
                    <div class="badge-item">
                        <span class="badge-value">&lt;1s</span>
                        <span class="badge-label">CZASU ŁADOWANIA</span>
                    </div>
                    <div class="badge-item">
                        <span class="badge-value">od 7 dni</span>
                        <span class="badge-label">SZYBKI CZAS REALIZACJI</span>
                    </div>
                    <div class="badge-item">
                        <span class="badge-value">20zł/mies.</span>
                        <span class="badge-label"
                            >NISKIE KOSZTY UTRZYMANIA*</span
                        >
                    </div>
                </div>

                <p
                    class="hero-disclaimer"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                    data-aos-delay="2100"
                >
                    * W rozliczeniu rocznym. Cena obejmuje koszty hostingu i
                    domeny .pl
                </p>
            </div>
        </div>

        <div
            class="hero-visual"
            data-aos="fade-left"
            data-aos-duration="1500"
            data-aos-delay="300"
        >
            <div class="abstract-composition">
                <!-- React (Foreground, crisp) -->
                <div class="tech-icon-wrapper tech-react depth-front float-1">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/React.avif"
                            alt="React logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">React</span>
                    </div>
                </div>

                <!-- Astro (Midground, slightly blurred, large focal point) -->
                <div class="tech-icon-wrapper tech-astro depth-mid float-2">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/astro-icon-light-gradient.avif"
                            alt="Astro logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">Astro</span>
                    </div>
                </div>

                <!-- Vite (Foreground, crisp, active) -->
                <div class="tech-icon-wrapper tech-vite depth-front float-3">
                    <div class="tech-icon-glass">
                        <svg viewBox="0 0 24 24" fill="none" class="tech-svg">
                            <path
                                d="M22.5 3.75L12.75 22.5L1.5 3.75H22.5Z"
                                fill="url(#viteGradient)"></path>
                            <path
                                d="M16.5 1.5L9 8.25L14.25 9.75L6.75 18L18.75 7.5L13.5 6L16.5 1.5Z"
                                fill="url(#lightningGradient)"></path>
                            <defs>
                                <linearGradient
                                    id="viteGradient"
                                    x1="1.5"
                                    y1="3.75"
                                    x2="19.5"
                                    y2="19.5"
                                    gradientUnits="userSpaceOnUse"
                                >
                                    <stop stop-color="#41D1FF"></stop>
                                    <stop offset="1" stop-color="#BD34FE"
                                    ></stop>
                                </linearGradient>
                                <linearGradient
                                    id="lightningGradient"
                                    x1="6.75"
                                    y1="1.5"
                                    x2="18.75"
                                    y2="18"
                                    gradientUnits="userSpaceOnUse"
                                >
                                    <stop stop-color="#FF8F3E"></stop>
                                    <stop offset="1" stop-color="#FFEB3B"
                                    ></stop>
                                </linearGradient>
                            </defs>
                        </svg>
                        <span class="tech-name">Vite</span>
                    </div>
                </div>

                <!-- TypeScript (Midground, slightly blurred) -->
                <div class="tech-icon-wrapper tech-ts depth-mid float-4">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/Typescript.avif"
                            alt="TypeScript logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">TypeScript</span>
                    </div>
                </div>

                <!-- Node.js (Background, blurred, slower float) -->
                <div class="tech-icon-wrapper tech-node depth-back float-5">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/node.avif"
                            alt="Node.js logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">Node.js</span>
                    </div>
                </div>

                <!-- JavaScript (Foreground, crisp) -->
                <div class="tech-icon-wrapper tech-js depth-front float-6">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/JavaScript.avif"
                            alt="JavaScript logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">JavaScript</span>
                    </div>
                </div>

                <!-- HTML (Background, blurred) -->
                <div class="tech-icon-wrapper tech-html depth-back float-7">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/HTML5.avif"
                            alt="HTML5 logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">HTML5</span>
                    </div>
                </div>

                <!-- CSS (Midground, slightly blurred) -->
                <div class="tech-icon-wrapper tech-css depth-mid float-8">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/CSS3.avif"
                            alt="CSS3 logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">CSS3</span>
                    </div>
                </div>
            </div>
        </div>
        <a href="#o-nas" class="hero-scroll-arrow" aria-label="Przewiń w dół">
            <i class="fa-solid fa-chevron-down"></i>
        </a>
    </main>

    <ONasTxt />

    <section id="projekty" class="projekty-section">
        <div
            class="projekty__heading"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>Przykładowe <span class="gradient__text">realizacje</span></h2>
        </div>
        <div
            class="projects-grid"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
        >
            {
                projects.map((project) => (
                    <ProjectCard
                        slug={project.id}
                        title={project.data.title}
                        date={project.data.date}
                        url={project.data.url}
                        color={project.data.color}
                        accent={project.data.accent}
                        thumbnail={project.data.thumbnail}
                        thumbnailAlt={project.data.thumbnailAlt}
                        mockup={project.data.mockup}
                    />
                ))
            }
        </div>
    </section>
    <ContactForm />

    <div class="google-map-embed" id="mapContainer">
        <div class="map-skeleton" id="mapSkeleton">
            <div class="map-skeleton__inner">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span>Ładowanie mapy google...</span>
            </div>
        </div>
    </div>

    <style>
        .google-map-embed {
            position: relative;
            width: 100%;
            height: 400px;
            background: var(--bg-color);
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
            overflow: hidden;
        }
        .map-skeleton {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(
                    circle at center,
                    rgba(139, 92, 246, 0.03) 0%,
                    rgba(0, 0, 0, 0) 80%
                ),
                var(--bg-color);
            transition: opacity 0.6s ease;
            z-index: 2;
        }
        .map-skeleton__inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        .map-skeleton__inner i {
            font-size: 1.8rem;
            color: var(--accent-blue);
        }
        .google-map-embed :global(iframe) {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
            z-index: 1;
            opacity: 0;
            transition: opacity 0.8s ease;
            transform: translateZ(0); /* Hardware acceleration */
            pointer-events: none; /* Zapobiega przejmowaniu scrolla */
        }
        .google-map-embed.loaded :global(iframe) {
            opacity: 1;
        }
        .google-map-embed.loaded:hover :global(iframe),
        .google-map-embed.loaded:active :global(iframe) {
            pointer-events: auto;
        }
    </style>

    <script>
        (function () {
            const mapContainer = document.getElementById("mapContainer");
            const mapSkeleton = document.getElementById("mapSkeleton");
            let loaded = false;

            if (mapContainer && mapSkeleton) {
                const loadMap = () => {
                    if (loaded) return;
                    loaded = true;

                    // Warm up DNS / Preconnect
                    const preconnect1 = document.createElement("link");
                    preconnect1.rel = "preconnect";
                    preconnect1.href = "https://maps.googleapis.com";
                    const preconnect2 = document.createElement("link");
                    preconnect2.rel = "preconnect";
                    preconnect2.href = "https://maps.gstatic.com";
                    document.head.appendChild(preconnect1);
                    document.head.appendChild(preconnect2);

                    // Create iframe
                    const iframe = document.createElement("iframe");
                    iframe.src =
                        "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d164316.23301606337!2d19.874760544328527!3d49.947282428156846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6447d991c045ed81%3A0x80337cb291998748!2sweb2sell!5e0!3m2!1spl!2spl!4v1779291902227!5m2!1spl!2spl";
                    iframe.width = "100%";
                    iframe.height = "400";
                    iframe.style.border = "0";
                    iframe.style.display = "block";
                    iframe.title = "Lokalizacja web2sell na mapie Google";
                    iframe.setAttribute("allowfullscreen", "");
                    iframe.setAttribute(
                        "referrerpolicy",
                        "no-referrer-when-downgrade",
                    );

                    // Once iframe loads, fade it in and fade out the skeleton
                    iframe.addEventListener("load", () => {
                        mapContainer.classList.add("loaded");
                        mapSkeleton.style.opacity = "0";
                        setTimeout(() => {
                            mapSkeleton.style.display = "none";
                        }, 600);
                    });

                    mapContainer.appendChild(iframe);
                };

                // Use IntersectionObserver to load map when close to viewport
                if ("IntersectionObserver" in window) {
                    const observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    loadMap();
                                    observer.disconnect();
                                }
                            });
                        },
                        { rootMargin: "150px" },
                    );
                    observer.observe(mapContainer);
                } else {
                    // Fallback for older browsers
                    loadMap();
                }
            }
        })();
    </script>

    <Footer isHome={true} />

    <!-- Typing animation -->
    <script>
        (function () {
            const titleGhost = document.getElementById("type-title-ghost");
            const titleElement = document.getElementById("type-title");

            const titleHTML =
                "Zaprojektujemy.<br><span class='gradient__text text-glow' data-text='Zbudujemy'>Zbudujemy.</span><br>Od zera.<br>Dla Twojej firmy.";

            if (titleGhost) titleGhost.innerHTML = titleHTML;

            function typeWriter(element, html, speed, callback) {
                let i = 0;
                let currentHTML = "";
                function type() {
                    if (i < html.length) {
                        if (html[i] === "<") {
                            let endTag = html.indexOf(">", i);
                            currentHTML += html.substring(i, endTag + 1);
                            i = endTag + 1;
                        } else {
                            currentHTML += html[i];
                            i++;
                        }
                        element.innerHTML = currentHTML;
                        setTimeout(type, speed);
                    } else if (callback) {
                        callback();
                    }
                }
                type();
            }

            setTimeout(() => {
                if (titleElement) {
                    const isLighthouse =
                        navigator.userAgent.includes("Chrome-Lighthouse") ||
                        navigator.userAgent.includes("Speed Insights") ||
                        window.matchMedia("(prefers-reduced-motion: reduce)")
                            .matches;
                    if (isLighthouse) {
                        titleElement.innerHTML = titleHTML;
                    } else {
                        typeWriter(titleElement, titleHTML, 40);
                    }
                }
            }, 600);
        })();
    </script>

    <!-- Realizations Intersection Observer for Mobile -->
    <script>
        (function () {
            if ("IntersectionObserver" in window) {
                const cards = document.querySelectorAll(
                    ".project-card.has-mockup",
                );
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-in-view");
                            } else {
                                entry.target.classList.remove("is-in-view");
                            }
                        });
                    },
                    {
                        rootMargin: "-15% 0px -15% 0px", // Trigger when 15% inside the screen
                        threshold: 0.1,
                    },
                );
                cards.forEach((card) => observer.observe(card));
            }
        })();
    </script>
</Layout>
