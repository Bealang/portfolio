    </main>

    <section id="projekty">
        <div
            class="projekty__heading"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>Nasze <span class="gradient__text">realizacje</span></h2>
        </div>
        <div
            class="c3d__scene"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
        >
            <div class="c3d__track" id="c3dTrack">
                {
                    renderedProjects.map((project) => (
                        <ProjectCard
                            slug={project.id}
                            title={project.data.title}
                            tag={project.data.tag}
                            color={project.data.color}
                            accent={project.data.accent}
                            thumbnail={project.data.thumbnail}
                            thumbnailAlt={project.data.thumbnailAlt}
                        />
                    ))
                }
            </div>
            <button
                class="c3d__nav c3d__nav--prev"
                id="c3dPrev"
                aria-label="Poprzedni"
                ><i class="fa-solid fa-chevron-left"></i></button
            >
            <button
                class="c3d__nav c3d__nav--next"
                id="c3dNext"
                aria-label="Następny"
                ><i class="fa-solid fa-chevron-right"></i></button
            >
        </div>
        <div class="c3d__dots" id="c3dDots"></div>
    </section>

    <section
        id="cennik-teaser"
        class="cennik-teaser"
        data-aos="fade-up"
        data-aos-duration="1000"
    >
        <div class="cennik-teaser__box">
            <div class="cennik-teaser__content">
                <h2>Chcesz poznać koszt swojej nowej strony?</h2>
                <p>
                    Sprawdź nasz przejrzysty cennik pakietów lub skontaktuj się
                    z nami, aby otrzymać bezpłatną, indywidualną wycenę
                    dopasowaną do Twoich potrzeb.
                </p>
            </div>
            <div class="cennik-teaser__action">
                <a href="/cennik" class="cennik-btn-glow">
                    <span>Przejdź do cennika</span>
                </a>
            </div>
        </div>
    </section>

    <ContactForm />

    <div class="google-map-embed" id="mapContainer">
        <div class="map-skeleton" id="mapSkeleton">
            <div class="map-skeleton__inner">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span>Ładowanie mapy google...</span>
            </div>
        </div>
    </div>

    <style>
        .google-map-embed {
            position: relative;
            width: 100%;
            height: 400px;
            background: var(--bg-color);
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
            overflow: hidden;
        }
        .map-skeleton {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(
                    circle at center,
                    rgba(139, 92, 246, 0.03) 0%,
                    rgba(0, 0, 0, 0) 80%
                ),
                var(--bg-color);
            transition: opacity 0.6s ease;
            z-index: 2;
        }
        .map-skeleton__inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        .map-skeleton__inner i {
            font-size: 1.8rem;
            color: var(--accent-blue);
        }
        .google-map-embed :global(iframe) {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
            z-index: 1;
            opacity: 0;
            transition: opacity 0.8s ease;
        }
        .google-map-embed.loaded :global(iframe) {
            opacity: 1;
        }
    </style>

    <script>
        (function () {
            const mapContainer = document.getElementById("mapContainer");
            const mapSkeleton = document.getElementById("mapSkeleton");
            let loaded = false;

            if (mapContainer && mapSkeleton) {
                const loadMap = () => {
                    if (loaded) return;
                    loaded = true;

                    // Warm up DNS / Preconnect
                    const preconnect1 = document.createElement("link");
                    preconnect1.rel = "preconnect";
                    preconnect1.href = "https://maps.googleapis.com";
                    const preconnect2 = document.createElement("link");
                    preconnect2.rel = "preconnect";
                    preconnect2.href = "https://maps.gstatic.com";
                    document.head.appendChild(preconnect1);
                    document.head.appendChild(preconnect2);

                    // Create iframe
                    const iframe = document.createElement("iframe");
                    iframe.src =
                        "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d164316.23301606337!2d19.874760544328527!3d49.947282428156846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6447d991c045ed81%3A0x80337cb291998748!2sweb2sell!5e0!3m2!1spl!2spl!4v1779291902227!5m2!1spl!2spl";
                    iframe.width = "100%";
                    iframe.height = "400";
                    iframe.style.border = "0";
                    iframe.style.display = "block";
                    iframe.title = "Lokalizacja web2sell na mapie Google";
                    iframe.setAttribute("allowfullscreen", "");
                    iframe.setAttribute(
                        "referrerpolicy",
                        "no-referrer-when-downgrade",
                    );

                    // Once iframe loads, fade it in and fade out the skeleton
                    iframe.addEventListener("load", () => {
                        mapContainer.classList.add("loaded");
                        mapSkeleton.style.opacity = "0";
                        setTimeout(() => {
                            mapSkeleton.style.display = "none";
                        }, 600);
                    });

                    mapContainer.appendChild(iframe);

                    // Clean up global listeners
                    window.removeEventListener("scroll", checkScroll);
                    window.removeEventListener("touchstart", checkScroll);
                };

                const checkScroll = () => {
                    if (window.scrollY > 200) {
                        loadMap();
                    }
                };

                // Listen to scroll and touchstart
                window.addEventListener("scroll", checkScroll, {
                    passive: true,
                });
                window.addEventListener("touchstart", checkScroll, {
                    passive: true,
                });

                // Also use IntersectionObserver as a backup/proximity detector
                if ("IntersectionObserver" in window) {
                    const observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    loadMap();
                                    observer.disconnect();
                                }
                            });
                        },
                        { rootMargin: "600px" },
                    );
                    observer.observe(mapContainer);
                }

                // Fallback check in case page is already scrolled on load
                if (window.scrollY > 200) {
                    loadMap();
                }
            }
        })();
    </script>

    <Footer isHome={true} />

    <!-- Pre-rendered project modals (hidden, opened via JS) -->
    {
        renderedProjects.map((project) => (
            <ProjectModal
                slug={project.id}
                title={project.data.title}
                tag={project.data.tag}
                color={project.data.color}
                url={project.data.url}
                gallery={project.data.gallery}
                Content={project.Content}
            />
        ))
    }

    <!-- Typing animation -->
    <script>
        (function () {
            const titleGhost = document.getElementById("type-title-ghost");
            const titleElement = document.getElementById("type-title");

            const titleHTML =
                "Zaprojektujemy.<br><span class='gradient__text text-glow' data-text='Zbudujemy'>Zbudujemy.</span><br>Od zera.<br>Dla Twojej firmy.";

            if (titleGhost) titleGhost.innerHTML = titleHTML;

            function typeWriter(element, html, speed, callback) {
                let i = 0;
                let currentHTML = "";
                function type() {
                    if (i < html.length) {
                        if (html[i] === "<") {
                            let endTag = html.indexOf(">", i);
                            currentHTML += html.substring(i, endTag + 1);
                            i = endTag + 1;
                        } else {
                            currentHTML += html[i];
                            i++;
                        }
                        element.innerHTML = currentHTML;
                        setTimeout(type, speed);
                    } else if (callback) {
                        callback();
                    }
                }
                type();
            }

            setTimeout(() => {
                if (titleElement) {
                    typeWriter(titleElement, titleHTML, 40);
                }
            }, 600);
        })();
    </script>

    <!-- 3D Slider -->
    <script>
        (function () {
            var cards = Array.from(document.querySelectorAll(".c3d__card"));
            var dotsEl = document.getElementById("c3dDots");
            var prevBtn = document.getElementById("c3dPrev");
            var nextBtn = document.getElementById("c3dNext");
            var total = cards.length;
            var current = 0;
            var autoTimer = null;
            var CARD_W = 320;
            var GAP = 360;

            function updateDimensions() {
                var w = window.innerWidth;
                if (w <= 600) {
                    CARD_W = 240;
                    GAP = 260;
                } else if (w <= 900) {
                    CARD_W = 270;
                    GAP = 300;
                } else {
                    CARD_W = 320;
                    GAP = 360;
                }
            }

            window.addEventListener(
                "resize",
                function () {
                    updateDimensions();
                    applyLayout(false);
                },
                { passive: true },
            );

            // Handle card clicks → open modal
            var currentDragDelta = 0;
            cards.forEach(function (card) {
                card.addEventListener("click", function (e) {
                    if (Math.abs(currentDragDelta) > 5) {
                        e.preventDefault();
                        return;
                    }
                    var slug = card.dataset.slug;
                    if (slug) {
                        var modal = document.getElementById("modal-" + slug);
                        if (modal) openModal(modal);
                    }
                });
            });

            function applyLayout(dragging, dragOffset) {
                if (dragOffset === undefined) dragOffset = 0;
                cards.forEach(function (card, i) {
                    var rel = i - current;
                    var abs = Math.abs(rel);
                    var tx = rel * GAP - CARD_W / 2 + dragOffset;
                    var ty = -50 + (abs === 0 ? -10 : 0);
                    var scale = abs === 0 ? 1 : abs === 1 ? 0.78 : 0.62;
                    var opacity =
                        abs === 0
                            ? 1
                            : abs === 1
                              ? 0.55
                              : abs === 2
                                ? 0.3
                                : 0.15;
                    var brightness = abs === 0 ? 1 : abs === 1 ? 0.55 : 0.3;
                    var zIndex = abs === 0 ? 20 : abs === 1 ? 15 : 5;
                    var shadow =
                        abs === 0
                            ? "0 50px 100px rgba(0,0,0,0.35), 0 20px 40px rgba(139,92,246,0.2)"
                            : "0 15px 35px rgba(0,0,0,0.15)";

                    card.style.transform =
                        "translate(" +
                        tx +
                        "px, " +
                        ty +
                        "%) scale(" +
                        scale +
                        ")";
                    card.style.opacity = opacity;
                    card.style.filter = "brightness(" + brightness + ")";
                    card.style.zIndex = zIndex;
                    card.style.boxShadow = shadow;

                    if (!dragging)
                        card.classList.toggle("is-active", i === current);
                    card.style.transition = dragging
                        ? "transform 0.1s ease-out"
                        : "transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease, filter 0.6s ease, box-shadow 0.6s ease";
                });

                if (!dragging) {
                    var dots = dotsEl.querySelectorAll(".c3d__dot");
                    dots.forEach(function (d, i) {
                        d.classList.toggle("is-active", i === current);
                    });
                }
            }

            function goTo(idx) {
                if (idx < 0) idx = total - 1;
                else if (idx >= total) idx = 0;
                current = idx;
                applyLayout(false, 0);
                resetAuto();
            }

            function resetAuto() {
                if (autoTimer) clearInterval(autoTimer);
                if (document.querySelector(".project-modal.is-open")) return;
                autoTimer = setInterval(function () {
                    goTo(current + 1);
                }, 3500);
            }
            window.sliderResetAuto = resetAuto;
            window.sliderStopAuto = function () {
                if (autoTimer) clearInterval(autoTimer);
            };

            prevBtn.addEventListener("click", function () {
                goTo(current - 1);
            });
            nextBtn.addEventListener("click", function () {
                goTo(current + 1);
            });

            // Drag
            var startX = 0;
            var isDragging = false;
            var scene = document.querySelector(".c3d__scene");

            scene.addEventListener("mousedown", function (e) {
                if (e.target.closest('.c3d__nav') || e.target.closest('.c3d__dots') || e.target.closest('.c3d__cta')) {
                    return;
                }
                isDragging = true;
                startX = e.clientX;
                currentDragDelta = 0;
                scene.classList.add("is-dragging");
                if (autoTimer) clearInterval(autoTimer);
            });
            window.addEventListener("mousemove", function (e) {
                if (!isDragging) return;
                currentDragDelta = e.clientX - startX;
                if (current === 0 && currentDragDelta > 0)
                    currentDragDelta *= 0.3;
                else if (current === total - 1 && currentDragDelta < 0)
                    currentDragDelta *= 0.3;
                applyLayout(true, currentDragDelta);
            });
            window.addEventListener("mouseup", function () {
                if (!isDragging) return;
                isDragging = false;
                scene.classList.remove("is-dragging");
                if (Math.abs(currentDragDelta) > 55)
                    goTo(currentDragDelta < 0 ? current + 1 : current - 1);
                else {
                    applyLayout(false, 0);
                    resetAuto();
                }
                setTimeout(function () {
                    currentDragDelta = 0;
                }, 0);
            });

            scene.addEventListener(
                "touchstart",
                function (e) {
                    if (e.target.closest('.c3d__nav') || e.target.closest('.c3d__dots') || e.target.closest('.c3d__cta')) {
                        return;
                    }
                    isDragging = true;
                    startX = e.touches[0].clientX;
                    currentDragDelta = 0;
                    if (autoTimer) clearInterval(autoTimer);
                    scene.classList.add("is-dragging");
                },
                { passive: true },
            );
            scene.addEventListener(
                "touchmove",
                function (e) {
                    if (!isDragging) return;
                    currentDragDelta = e.touches[0].clientX - startX;
                    if (current === 0 && currentDragDelta > 0)
                        currentDragDelta *= 0.3;
                    else if (current === total - 1 && currentDragDelta < 0)
                        currentDragDelta *= 0.3;
                    applyLayout(true, currentDragDelta);
                },
                { passive: true },
            );
            scene.addEventListener("touchend", function () {
                if (!isDragging) return;
                isDragging = false;
                scene.classList.remove("is-dragging");
                if (Math.abs(currentDragDelta) > 50)
                    goTo(currentDragDelta < 0 ? current + 1 : current - 1);
                else {
                    applyLayout(false, 0);
                    resetAuto();
                }
                setTimeout(function () {
                    currentDragDelta = 0;
                }, 0);
            });

            function initSlider() {
                updateDimensions();

                // Build dots
                cards.forEach(function (_, i) {
                    var d = document.createElement("button");
                    d.className = "c3d__dot";
                    d.setAttribute("aria-label", "Slajd " + (i + 1));
                    d.addEventListener("click", function () {
                        goTo(i);
                    });
                    dotsEl.appendChild(d);
                });

                applyLayout(false, 0);
                resetAuto();
            }

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    function () {
                        requestAnimationFrame(initSlider);
                    },
                    { once: true },
                );
            } else {
                requestAnimationFrame(initSlider);
            }
        })();
    </script>

    <!-- Modal Manager (Bundled & Defer, with dynamic Swiper load on-demand) -->
    <script>
        (function () {
            var activeSwipers = [];
            var swiperLoaded = false;

            window.openModal = async function (modal) {
                modal.setAttribute("aria-hidden", "false");
                modal.classList.add("is-open");
                document.body.style.overflow = "hidden";
                if (window.sliderStopAuto) window.sliderStopAuto();

                // Dynamic lazy loading for images in the opened modal
                var lazyImgs = modal.querySelectorAll(".modal-lazy-img");
                lazyImgs.forEach(function (img) {
                    if (img.dataset.src) {
                        img.src = img.dataset.src;
                        img.removeAttribute("data-src");

                        var handleLoad = function () {
                            img.style.opacity = "1";
                            var parentSlide = img.closest(
                                ".swiper-slide-shimmer",
                            );
                            if (parentSlide) {
                                parentSlide.classList.remove(
                                    "swiper-slide-shimmer",
                                );
                            }
                        };

                        img.addEventListener("load", handleLoad);

                        // Check if already cached/completed by browser
                        if (img.complete) {
                            handleLoad();
                        }
                    }
                });

                // Init Swiper for gallery
                var swiperEl = modal.querySelector(".project-gallery-swiper");
                if (swiperEl) {
                    if (!swiperLoaded) {
                        // Dynamically inject Swiper CSS
                        var link = document.createElement("link");
                        link.rel = "stylesheet";
                        link.href =
                            "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css";
                        document.head.appendChild(link);

                        // Dynamically inject Swiper JS
                        await new Promise(function (resolve) {
                            var script = document.createElement("script");
                            script.src =
                                "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js";
                            script.onload = resolve;
                            document.body.appendChild(script);
                        });
                        swiperLoaded = true;
                    }

                    var swiper = new Swiper(swiperEl, {
                        loop:
                            swiperEl.querySelectorAll(".swiper-slide").length >
                            1,
                        pagination: {
                            el: swiperEl.querySelector(".swiper-pagination"),
                            clickable: true,
                        },
                        navigation: {
                            nextEl: swiperEl.querySelector(
                                ".swiper-button-next",
                            ),
                            prevEl: swiperEl.querySelector(
                                ".swiper-button-prev",
                            ),
                        },
                        keyboard: { enabled: true },
                        grabCursor: true,
                        observer: true,
                        observeParents: true,
                    });
                    activeSwipers.push(swiper);
                }
            };

            window.closeModal = function (modal) {
                modal.classList.remove("is-open");
                modal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
                if (window.sliderResetAuto) window.sliderResetAuto();

                // Destroy Swiper instances
                activeSwipers.forEach(function (s) {
                    s.destroy(true, true);
                });
                activeSwipers = [];
            };

            // Close button
            document
                .querySelectorAll(".project-modal__close")
                .forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        closeModal(btn.closest(".project-modal"));
                    });
                });

            // Backdrop click
            document
                .querySelectorAll(".project-modal__backdrop")
                .forEach(function (backdrop) {
                    backdrop.addEventListener("click", function () {
                        closeModal(backdrop.closest(".project-modal"));
                    });
                });

            // Escape key
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    var openModal = document.querySelector(
                        ".project-modal.is-open",
                    );
                    if (openModal) closeModal(openModal);
                }
            });
        })();
    </script>

    <!-- Technology Interactive Drag Controller -->
    <script>
        (function () {
            var glasses = document.querySelectorAll(".tech-icon-glass");
            var isDragging = false;
            var startX = 0,
                startY = 0;
            var activeGlass = null;

            glasses.forEach(function (glass) {
                glass.addEventListener("pointerdown", function (e) {
                    if (e.button !== 0) return;
                    e.preventDefault();
                    isDragging = true;
                    startX = e.clientX;
                    startY = e.clientY;
                    activeGlass = glass;

                    glass.classList.add("is-dragging");
                    glass.setPointerCapture(e.pointerId);
                });

                glass.addEventListener("pointermove", function (e) {
                    if (!isDragging || activeGlass !== glass) return;
                    var dx = e.clientX - startX;
                    var dy = e.clientY - startY;

                    // Dynamic drag with 1.2x scale and visual Z displacement
                    glass.style.transform =
                        "translate(" +
                        dx +
                        "px, " +
                        dy +
                        "px) scale(1.2) translateZ(40px)";
                });

                var handleRelease = function (e) {
                    if (!isDragging || activeGlass !== glass) return;
                    glass.releasePointerCapture(e.pointerId);
                    glass.classList.remove("is-dragging");

                    // Reset transform; the CSS transition on .tech-icon-glass will smoothly animate it back to original place
                    glass.style.transform = "";

                    isDragging = false;
                    activeGlass = null;
                };

                glass.addEventListener("pointerup", handleRelease);
                glass.addEventListener("pointercancel", handleRelease);
            });
        })();
    </script>
</Layout>
