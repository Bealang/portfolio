---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { getCollection } from "astro:content";
import ONasTxt from "../components/o-nas-txt.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<Layout
    title="Web2Sell | Tworzenie stron www Myślenice"
    description="Web2Sell - profesjonalne tworzenie stron www Myślenice. Nowoczesne, szybkie i responsywne strony internetowe dla firm. Zobacz nasze portfolio projektów i skontaktuj się!"
>
    <Header activePage="home" />

    <main id="onas" class="hero-section">
        <HeroBg />

        <div id="main__text" class="hero-content">
            <div class="hero-text-reveal">
                <h1
                    class="hero-seo-title"
                    data-aos="fade-down"
                    data-aos-duration="800"
                >
                    Tworzenie stron internetowych Myślenice
                </h1>
                <h2 class="hero-title typing-stack">
                    <span id="type-title-ghost" class="ghost-layer"
                        >Zaprojektujemy.
                        <br /><span
                            class="gradient__text text-glow"
                            data-text="Zbudujemy">Zbudujemy.</span
                        >
                        <br />Od zera.
                        <br />Dla Twojej firmy.
                    </span>
                    <span id="type-title" class="visible-layer"></span>
                </h2>
                <div
                    id="main__buttons"
                    class="hero-buttons"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                    data-aos-delay="1800"
                >
                    <a href="#o-nas" class="btn-about">
                        <span>Poznaj nas</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a
                        href="tel:+48530315860"
                        class="btn-glass btn-secondary btn-call"
                    >
                        <i class="fa-solid fa-phone" style="margin-right: 8px;"
                        ></i>
                        <span>Zadzwoń: +48 530 315 860</span>
                    </a>
                </div>
            </div>
        </div>

        <div
            class="hero-visual"
            data-aos="fade-left"
            data-aos-duration="1500"
            data-aos-delay="300"
        >
            <div class="abstract-composition">
                <!-- React (Foreground, crisp) -->
                <div class="tech-icon-wrapper tech-react depth-front float-1">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/React.avif"
                            alt="React logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">React</span>
                    </div>
                </div>

                <!-- Astro (Midground, slightly blurred, large focal point) -->
                <div class="tech-icon-wrapper tech-astro depth-mid float-2">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/astro-icon-light-gradient.avif"
                            alt="Astro logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">Astro</span>
                    </div>
                </div>

                <!-- Vite (Foreground, crisp, active) -->
                <div class="tech-icon-wrapper tech-vite depth-front float-3">
                    <div class="tech-icon-glass">
                        <svg viewBox="0 0 24 24" fill="none" class="tech-svg">
                            <path
                                d="M22.5 3.75L12.75 22.5L1.5 3.75H22.5Z"
                                fill="url(#viteGradient)"></path>
                            <path
                                d="M16.5 1.5L9 8.25L14.25 9.75L6.75 18L18.75 7.5L13.5 6L16.5 1.5Z"
                                fill="url(#lightningGradient)"></path>
                            <defs>
                                <linearGradient
                                    id="viteGradient"
                                    x1="1.5"
                                    y1="3.75"
                                    x2="19.5"
                                    y2="19.5"
                                    gradientUnits="userSpaceOnUse"
                                >
                                    <stop stop-color="#41D1FF"></stop>
                                    <stop offset="1" stop-color="#BD34FE"
                                    ></stop>
                                </linearGradient>
                                <linearGradient
                                    id="lightningGradient"
                                    x1="6.75"
                                    y1="1.5"
                                    x2="18.75"
                                    y2="18"
                                    gradientUnits="userSpaceOnUse"
                                >
                                    <stop stop-color="#FF8F3E"></stop>
                                    <stop offset="1" stop-color="#FFEB3B"
                                    ></stop>
                                </linearGradient>
                            </defs>
                        </svg>
                        <span class="tech-name">Vite</span>
                    </div>
                </div>

                <!-- TypeScript (Midground, slightly blurred) -->
                <div class="tech-icon-wrapper tech-ts depth-mid float-4">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/Typescript.avif"
                            alt="TypeScript logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">TypeScript</span>
                    </div>
                </div>

                <!-- Node.js (Background, blurred, slower float) -->
                <div class="tech-icon-wrapper tech-node depth-back float-5">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/node.avif"
                            alt="Node.js logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">Node.js</span>
                    </div>
                </div>

                <!-- JavaScript (Foreground, crisp) -->
                <div class="tech-icon-wrapper tech-js depth-front float-6">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/JavaScript.avif"
                            alt="JavaScript logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">JavaScript</span>
                    </div>
                </div>

                <!-- HTML (Background, blurred) -->
                <div class="tech-icon-wrapper tech-html depth-back float-7">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/HTML5.avif"
                            alt="HTML5 logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">HTML5</span>
                    </div>
                </div>

                <!-- CSS (Midground, slightly blurred) -->
                <div class="tech-icon-wrapper tech-css depth-mid float-8">
                    <div class="tech-icon-glass">
                        <img
                            src="/assets/frameworks/CSS3.avif"
                            alt="CSS3 logo"
                            width="48"
                            height="48"
                            loading="eager"
                            decoding="async"
                            class="tech-svg"
                        />
                        <span class="tech-name">CSS3</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <ONasTxt />

    <section id="projekty">
        <div
            class="projekty__heading"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <h2>Nasze <span class="gradient__text">realizacje</span></h2>
        </div>
        <div
            class="c3d__scene"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
        >
            <div class="c3d__track" id="c3dTrack">
                {
                    projects.map((project) => (
                        <ProjectCard
                            slug={project.id}
                            title={project.data.title}
                            date={project.data.date}
                            url={project.data.url}
                            color={project.data.color}
                            accent={project.data.accent}
                            thumbnail={project.data.thumbnail}
                            thumbnailAlt={project.data.thumbnailAlt}
                        />
                    ))
                }
            </div>
            <button
                class="c3d__nav c3d__nav--prev"
                id="c3dPrev"
                aria-label="Poprzedni"
                ><i class="fa-solid fa-chevron-left"></i></button
            >
            <button
                class="c3d__nav c3d__nav--next"
                id="c3dNext"
                aria-label="Następny"
                ><i class="fa-solid fa-chevron-right"></i></button
            >
        </div>
        <div class="c3d__dots" id="c3dDots"></div>
    </section>
    <ContactForm />

    <div class="google-map-embed" id="mapContainer">
        <div class="map-skeleton" id="mapSkeleton">
            <div class="map-skeleton__inner">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span>Ładowanie mapy google...</span>
            </div>
        </div>
    </div>

    <style>
        .google-map-embed {
            position: relative;
            width: 100%;
            height: 400px;
            background: var(--bg-color);
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
            overflow: hidden;
        }
        .map-skeleton {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(
                    circle at center,
                    rgba(139, 92, 246, 0.03) 0%,
                    rgba(0, 0, 0, 0) 80%
                ),
                var(--bg-color);
            transition: opacity 0.6s ease;
            z-index: 2;
        }
        .map-skeleton__inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        .map-skeleton__inner i {
            font-size: 1.8rem;
            color: var(--accent-blue);
        }
        .google-map-embed :global(iframe) {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
            z-index: 1;
            opacity: 0;
            transition: opacity 0.8s ease;
            transform: translateZ(0); /* Hardware acceleration */
            pointer-events: none; /* Zapobiega przejmowaniu scrolla */
        }
        .google-map-embed.loaded :global(iframe) {
            opacity: 1;
        }
        .google-map-embed.loaded:hover :global(iframe),
        .google-map-embed.loaded:active :global(iframe) {
            pointer-events: auto;
        }
    </style>

    <script>
        (function () {
            const mapContainer = document.getElementById("mapContainer");
            const mapSkeleton = document.getElementById("mapSkeleton");
            let loaded = false;

            if (mapContainer && mapSkeleton) {
                const loadMap = () => {
                    if (loaded) return;
                    loaded = true;

                    // Warm up DNS / Preconnect
                    const preconnect1 = document.createElement("link");
                    preconnect1.rel = "preconnect";
                    preconnect1.href = "https://maps.googleapis.com";
                    const preconnect2 = document.createElement("link");
                    preconnect2.rel = "preconnect";
                    preconnect2.href = "https://maps.gstatic.com";
                    document.head.appendChild(preconnect1);
                    document.head.appendChild(preconnect2);

                    // Create iframe
                    const iframe = document.createElement("iframe");
                    iframe.src =
                        "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d164316.23301606337!2d19.874760544328527!3d49.947282428156846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6447d991c045ed81%3A0x80337cb291998748!2sweb2sell!5e0!3m2!1spl!2spl!4v1779291902227!5m2!1spl!2spl";
                    iframe.width = "100%";
                    iframe.height = "400";
                    iframe.style.border = "0";
                    iframe.style.display = "block";
                    iframe.title = "Lokalizacja web2sell na mapie Google";
                    iframe.setAttribute("allowfullscreen", "");
                    iframe.setAttribute(
                        "referrerpolicy",
                        "no-referrer-when-downgrade",
                    );

                    // Once iframe loads, fade it in and fade out the skeleton
                    iframe.addEventListener("load", () => {
                        mapContainer.classList.add("loaded");
                        mapSkeleton.style.opacity = "0";
                        setTimeout(() => {
                            mapSkeleton.style.display = "none";
                        }, 600);
                    });

                    mapContainer.appendChild(iframe);
                };

                // Use IntersectionObserver to load map when close to viewport
                if ("IntersectionObserver" in window) {
                    const observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    loadMap();
                                    observer.disconnect();
                                }
                            });
                        },
                        { rootMargin: "150px" },
                    );
                    observer.observe(mapContainer);
                } else {
                    // Fallback for older browsers
                    loadMap();
                }
            }
        })();
    </script>

    <Footer isHome={true} />

    <!-- Typing animation -->
    <script>
        (function () {
            const titleGhost = document.getElementById("type-title-ghost");
            const titleElement = document.getElementById("type-title");

            const titleHTML =
                "Zaprojektujemy.<br><span class='gradient__text text-glow' data-text='Zbudujemy'>Zbudujemy.</span><br>Od zera.<br>Dla Twojej firmy.";

            if (titleGhost) titleGhost.innerHTML = titleHTML;

            function typeWriter(element, html, speed, callback) {
                let i = 0;
                let currentHTML = "";
                function type() {
                    if (i < html.length) {
                        if (html[i] === "<") {
                            let endTag = html.indexOf(">", i);
                            currentHTML += html.substring(i, endTag + 1);
                            i = endTag + 1;
                        } else {
                            currentHTML += html[i];
                            i++;
                        }
                        element.innerHTML = currentHTML;
                        setTimeout(type, speed);
                    } else if (callback) {
                        callback();
                    }
                }
                type();
            }

            setTimeout(() => {
                if (titleElement) {
                    const isLighthouse = navigator.userAgent.includes("Chrome-Lighthouse") || navigator.userAgent.includes("Speed Insights") || window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                    if (isLighthouse) {
                        titleElement.innerHTML = titleHTML;
                    } else {
                        typeWriter(titleElement, titleHTML, 40);
                    }
                }
            }, 600);
        })();
    </script>

    <!-- 3D Slider -->
    <script>
        (function () {
            var cards = Array.from(document.querySelectorAll(".c3d__card"));
            var dotsEl = document.getElementById("c3dDots");
            var prevBtn = document.getElementById("c3dPrev");
            var nextBtn = document.getElementById("c3dNext");
            var total = cards.length;
            var current = 0;
            var autoTimer = null;
            var CARD_W = 320;
            var GAP = 360;

            function updateDimensions() {
                var w = window.innerWidth;
                if (w <= 600) {
                    CARD_W = 240;
                    GAP = 260;
                } else if (w <= 900) {
                    CARD_W = 270;
                    GAP = 300;
                } else {
                    CARD_W = 320;
                    GAP = 360;
                }
            }

            window.addEventListener(
                "resize",
                function () {
                    updateDimensions();
                    applyLayout(false);
                },
                { passive: true },
            );
            // Handle card clicks → prevent navigation if dragging
            var currentDragDelta = 0;
            cards.forEach(function (card) {
                card.addEventListener("click", function (e) {
                    if (Math.abs(currentDragDelta) > 5) {
                        e.preventDefault();
                    }
                });
            });

            function applyLayout(dragging, dragOffset) {
                if (dragOffset === undefined) dragOffset = 0;
                cards.forEach(function (card, i) {
                    var rel = i - current;
                    var abs = Math.abs(rel);
                    var tx = rel * GAP - CARD_W / 2 + dragOffset;
                    var ty = -50 + (abs === 0 ? -10 : 0);
                    var scale = abs === 0 ? 1 : abs === 1 ? 0.78 : 0.62;
                    var opacity =
                        abs === 0
                            ? 1
                            : abs === 1
                              ? 0.55
                              : abs === 2
                                ? 0.3
                                : 0.15;
                    var brightness = abs === 0 ? 1 : abs === 1 ? 0.55 : 0.3;
                    var zIndex = abs === 0 ? 20 : abs === 1 ? 15 : 5;
                    card.style.transform =
                        "translate(" +
                        tx +
                        "px, " +
                        ty +
                        "%) scale(" +
                        scale +
                        ")";
                    card.style.opacity = opacity;

                    // GPU-optimized overlay opacity instead of expensive CSS filter: brightness
                    var overlay = card.querySelector(".c3d__card-overlay");
                    if (overlay) {
                        overlay.style.opacity = 1 - brightness;
                    }

                    card.style.zIndex = zIndex;
                    card.style.boxShadow = "none";

                    if (!dragging)
                        card.classList.toggle("is-active", i === current);
                    card.style.transition = dragging
                        ? "none"
                        : "transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease, box-shadow 0.6s ease";

                    if (overlay) {
                        overlay.style.transition = dragging
                            ? "none"
                            : "opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1)";
                    }
                });

                if (!dragging) {
                    var dots = dotsEl.querySelectorAll(".c3d__dot");
                    dots.forEach(function (d, i) {
                        d.classList.toggle("is-active", i === current);
                    });
                }
            }

            function goTo(idx) {
                if (idx < 0) idx = total - 1;
                else if (idx >= total) idx = 0;
                current = idx;
                applyLayout(false, 0);
                resetAuto();
            }

            function resetAuto() {
                if (autoTimer) clearInterval(autoTimer);
                if (document.querySelector(".project-modal.is-open")) return;
                autoTimer = setInterval(function () {
                    goTo(current + 1);
                }, 3500);
            }
            window.sliderResetAuto = resetAuto;
            window.sliderStopAuto = function () {
                if (autoTimer) clearInterval(autoTimer);
            };

            prevBtn.addEventListener("click", function () {
                goTo(current - 1);
            });
            nextBtn.addEventListener("click", function () {
                goTo(current + 1);
            });

            // Drag
            var startX = 0;
            var isDragging = false;
            var rafPending = false;
            var scene = document.querySelector(".c3d__scene");

            scene.addEventListener("mousedown", function (e) {
                if (
                    e.target.closest(".c3d__nav") ||
                    e.target.closest(".c3d__dots") ||
                    e.target.closest(".c3d__cta")
                ) {
                    return;
                }
                isDragging = true;
                startX = e.clientX;
                currentDragDelta = 0;
                scene.classList.add("is-dragging");
                if (autoTimer) clearInterval(autoTimer);
            });
            window.addEventListener(
                "mousemove",
                function (e) {
                    if (!isDragging) return;
                    currentDragDelta = e.clientX - startX;
                    if (current === 0 && currentDragDelta > 0)
                        currentDragDelta *= 0.3;
                    else if (current === total - 1 && currentDragDelta < 0)
                        currentDragDelta *= 0.3;

                    if (!rafPending) {
                        rafPending = true;
                        requestAnimationFrame(function () {
                            rafPending = false;
                            if (!isDragging) return;
                            applyLayout(true, currentDragDelta);
                        });
                    }
                },
                { passive: true },
            );
            window.addEventListener("mouseup", function () {
                if (!isDragging) return;
                isDragging = false;
                scene.classList.remove("is-dragging");
                if (Math.abs(currentDragDelta) > 55)
                    goTo(currentDragDelta < 0 ? current + 1 : current - 1);
                else {
                    applyLayout(false, 0);
                    resetAuto();
                }
                setTimeout(function () {
                    currentDragDelta = 0;
                }, 0);
            });

            scene.addEventListener(
                "touchstart",
                function (e) {
                    if (
                        e.target.closest(".c3d__nav") ||
                        e.target.closest(".c3d__dots") ||
                        e.target.closest(".c3d__cta")
                    ) {
                        return;
                    }
                    isDragging = true;
                    startX = e.touches[0].clientX;
                    currentDragDelta = 0;
                    if (autoTimer) clearInterval(autoTimer);
                    scene.classList.add("is-dragging");
                },
                { passive: true },
            );
            scene.addEventListener(
                "touchmove",
                function (e) {
                    if (!isDragging) return;
                    currentDragDelta = e.touches[0].clientX - startX;
                    if (current === 0 && currentDragDelta > 0)
                        currentDragDelta *= 0.3;
                    else if (current === total - 1 && currentDragDelta < 0)
                        currentDragDelta *= 0.3;

                    if (!rafPending) {
                        rafPending = true;
                        requestAnimationFrame(function () {
                            rafPending = false;
                            if (!isDragging) return;
                            applyLayout(true, currentDragDelta);
                        });
                    }
                },
                { passive: true },
            );
            scene.addEventListener("touchend", function () {
                if (!isDragging) return;
                isDragging = false;
                scene.classList.remove("is-dragging");
                if (Math.abs(currentDragDelta) > 50)
                    goTo(currentDragDelta < 0 ? current + 1 : current - 1);
                else {
                    applyLayout(false, 0);
                    resetAuto();
                }
                setTimeout(function () {
                    currentDragDelta = 0;
                }, 0);
            });

            function initSlider() {
                updateDimensions();

                // Build dots
                cards.forEach(function (_, i) {
                    var d = document.createElement("button");
                    d.className = "c3d__dot";
                    d.setAttribute("aria-label", "Slajd " + (i + 1));
                    d.addEventListener("click", function () {
                        goTo(i);
                    });
                    dotsEl.appendChild(d);
                });

                applyLayout(false, 0);
                resetAuto();
            }

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    function () {
                        requestAnimationFrame(initSlider);
                    },
                    { once: true },
                );
            } else {
                requestAnimationFrame(initSlider);
            }
        })();
    </script>
</Layout>
