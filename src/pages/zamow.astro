---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBg from "../components/HeroBg.astro";
import OrderWizard from "../components/OrderWizard.astro";
---

<Layout
    title="Zamów stronę WWW - darmowa konsultacja | web2sell"
    description="Chcesz zamówić nową, nowoczesną i zoptymalizowaną stronę internetową? Skonfiguruj swój projekt i wyślij formularz, a darmową wycenę otrzymasz w 24 godziny!"
>
    <Header activePage="zamow" />

    <main class="kontakt-page">
        <HeroBg behindContent={true} />

        <section
            class="kontakt-sekcja reveal-element"
            style="max-width: 1920px;"
        >
            <div class="kontakt-sekcja__container">
                <OrderWizard />
            </div>
        </section>
    </main>

    <Footer />

    <!-- Scroll Reveal Animations Script -->
    <script is:inline>
        (function () {
            var revealElements = document.querySelectorAll(".reveal-element");
            if ("IntersectionObserver" in window && revealElements.length > 0) {
                var verticalObserver = new IntersectionObserver(
                    function (entries, observer) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("reveal--visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    {
                        rootMargin: "0px 0px -80px 0px",
                        threshold: 0.05,
                    },
                );

                revealElements.forEach(function (el) {
                    verticalObserver.observe(el);
                });
            } else {
                revealElements.forEach(function (el) {
                    el.classList.add("reveal--visible");
                });
            }
        })();
    </script>

    <style is:global>
        @media (max-width: 995px) {
            main.kontakt-page {
                padding-top: 0 !important;
            }
            .kontakt-sekcja {
                padding-top: 100px !important;
                padding-left: 12px !important;
                padding-right: 12px !important;
                gap: 24px !important;
            }
        }
        @media (max-width: 480px) {
            .kontakt-sekcja {
                padding-left: 8px !important;
                padding-right: 8px !important;
            }
        }
    </style>
</Layout>
