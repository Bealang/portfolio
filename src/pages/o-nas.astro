---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="O nas | web2sell - Tworzenie stron www Myślenice"
    description="Poznaj web2sell. Strona w trakcie budowy."
>
    <Header activePage="o-nas" />

    <main class="o-nas-page">
        <section
            class="under-construction"
            data-aos="fade-up"
            data-aos-duration="800"
        >
            <div class="uc-icon">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>
            <h1>Strona w trakcie budowy</h1>
            <div class="uc-actions">
                <a href="/" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i> Wróć do strony głównej
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .o-nas-page {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 160px 5% 100px;
    }

    .under-construction {
        text-align: center;
        max-width: 500px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 25px;
    }

    .uc-icon {
        font-size: 5rem;
        background: linear-gradient(
            135deg,
            var(--accent-cyan),
            var(--accent-blue)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
        animation: float-wrench 4s infinite ease-in-out;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .uc-icon:hover {
        transform: scale(1.12) rotate(15deg);
    }

    .under-construction h1 {
        font-size: clamp(1.8rem, 4.5vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -1px;
        margin: 0;
        line-height: 1.2;
    }

    .uc-actions {
        margin-top: 10px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(139, 92, 246, 0.15);
        border-radius: 50px;
        text-decoration: none !important;
        transition: var(--transition-smooth);
    }

    html[data-theme="dark"] .btn-back {
        background: rgba(255, 255, 255, 0.02);
        border-color: rgba(255, 255, 255, 0.06);
    }

    .btn-back:hover {
        color: var(--text-primary);
        background: rgba(139, 92, 246, 0.1);
        border-color: rgba(139, 92, 246, 0.35);
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(139, 92, 246, 0.1);
    }

    html[data-theme="dark"] .btn-back:hover {
        background: rgba(167, 139, 250, 0.1);
        border-color: rgba(167, 139, 250, 0.3);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .btn-back i {
        font-size: 0.85rem;
        transition: transform 0.3s ease;
    }

    .btn-back:hover i {
        transform: translateX(-4px);
    }

    @keyframes float-wrench {
        0%,
        100% {
            transform: translateY(0) rotate(0deg);
        }
        50% {
            transform: translateY(-10px) rotate(8deg);
        }
    }

    @media (max-width: 600px) {
        .o-nas-page {
            padding-top: 140px;
            padding-bottom: 80px;
        }
        .uc-icon {
            font-size: 4rem;
        }
    }
</style>
