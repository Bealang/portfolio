---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HeroBg from "../../components/HeroBg.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
    const posts = (await getCollection("blog")).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );
    // Pokazujemy po 6 wpisów na stronę dla idealnego rozkładu siatki 3x2 na dużych ekranach
    return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
---

<Layout
    title={`Blog (${page.currentPage} str.) | web2sell`}
    description="Nasz blog to baza wiedzy o tworzeniu super szybkich stron www, lokalnym SEO i nowoczesnych technologiach takich jak Astro czy React."
    robots="noindex, follow"
>
    <Header activePage="blog" />

    <main class="blog-container">
        <HeroBg behindContent={true} />

        <div class="blog__header">
            <h1>
                Blog web2<span class="gradient__text">sell</span>
            </h1>
        </div>

        <section class="blog__content">
            <div class="blog__grid">
                {
                    page.data.map((post) => (
                        <BlogCard
                            slug={post.id}
                            title={post.data.title}
                            description={post.data.description}
                            pubDate={post.data.pubDate}
                            image={post.data.image}
                            imageAlt={post.data.imageAlt}
                            author={post.data.author}
                        />
                    ))
                }
            </div>

            {
                page.lastPage > 1 && (
                    <nav
                        class="pagination"
                        aria-label="Nawigacja po stronach bloga"
                    >
                        {page.url.prev ? (
                            <a
                                href={page.url.prev}
                                class="pagination__btn pagination__btn--prev"
                                aria-label="Poprzednia strona"
                            >
                                <i class="fa-solid fa-chevron-left" />{" "}
                                Poprzednia
                            </a>
                        ) : (
                            <span class="pagination__btn pagination__btn--disabled">
                                <i class="fa-solid fa-chevron-left" />{" "}
                                Poprzednia
                            </span>
                        )}

                        <div class="pagination__selector">
                            <span class="pagination__label">Strona:</span>
                            <div class="pagination__select-wrapper">
                                <select
                                    onchange="window.location.href = this.value"
                                    class="pagination__select"
                                >
                                    {Array.from(
                                        { length: page.lastPage },
                                        (_, i) => {
                                            const pageNum = i + 1;
                                            const href =
                                                pageNum === 1
                                                    ? "/blog"
                                                    : `/blog/${pageNum}`;
                                            return (
                                                <option
                                                    value={href}
                                                    selected={
                                                        page.currentPage ===
                                                        pageNum
                                                    }
                                                >
                                                    {pageNum}
                                                </option>
                                            );
                                        },
                                    )}
                                </select>
                                <i class="fa-solid fa-chevron-down pagination__select-icon" />
                            </div>
                            <span class="pagination__total">
                                z {page.lastPage}
                            </span>
                        </div>

                        {page.url.next ? (
                            <a
                                href={page.url.next}
                                class="pagination__btn pagination__btn--next"
                                aria-label="Następna strona"
                            >
                                Następna <i class="fa-solid fa-chevron-right" />
                            </a>
                        ) : (
                            <span class="pagination__btn pagination__btn--disabled">
                                Następna <i class="fa-solid fa-chevron-right" />
                            </span>
                        )}
                    </nav>
                )
            }
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .blog-container {
        position: relative;
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 160px 5% 80px;
        min-height: 80vh;
    }

    .blog__header {
        text-align: center;
        margin-bottom: 60px;
        position: relative;
        z-index: 2;
    }

    .blog__badge {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--accent-cyan);
        background: rgba(var(--accent-cyan-rgb), 0.08);
        border: 1px solid rgba(var(--accent-cyan-rgb), 0.2);
        padding: 6px 16px;
        border-radius: 30px;
        margin-bottom: 20px;
    }

    .blog__header h1 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(32px, 4.5vw, 54px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.15;
        margin: 0 0 20px;
        letter-spacing: -1px;
    }

    .blog__header p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
        font-weight: 300;
    }

    .blog__content {
        position: relative;
        z-index: 2;
    }

    .blog__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-bottom: 60px;
    }

    @media (max-width: 1024px) {
        .blog__grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }
    }

    @media (max-width: 768px) {
        .blog__grid {
            grid-template-columns: 1fr;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
            gap: 28px;
        }
    }

    /* Paginacja */
    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        margin-top: 50px;
        padding-top: 40px;
        border-top: 1px solid var(--glass-border);
    }

    .pagination__btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 50px;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: var(--transition-smooth);
        border: 1px solid var(--glass-border);
        background: var(--card-bg);
        color: var(--text-primary);
        box-shadow: var(--glass-shadow);
        cursor: pointer;
    }

    .pagination__btn i {
        font-size: 0.8rem;
    }

    .pagination__btn:not(.pagination__btn--disabled):hover {
        transform: translateY(-2px);
        border-color: var(--card-hover-border);
        box-shadow: 0 5px 15px rgba(var(--accent-blue-rgb), 0.1);
        color: var(--accent-cyan);
    }

    .pagination__btn--disabled {
        opacity: 0.35;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* Selector */
    .pagination__selector {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 600;
        font-size: 1rem;
    }

    .pagination__label {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .pagination__select-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .pagination__select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        padding: 8px 36px 8px 16px;
        color: var(--text-primary);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        outline: none;
        transition: var(--transition-smooth);
        box-shadow: var(--glass-shadow);
        text-align: center;
        min-width: 70px;
    }

    .pagination__select:hover,
    .pagination__select:focus {
        border-color: var(--card-hover-border);
        box-shadow: 0 4px 12px rgba(var(--accent-blue-rgb), 0.08);
    }

    .pagination__select-icon {
        position: absolute;
        right: 14px;
        pointer-events: none;
        font-size: 0.8rem;
        color: var(--accent-blue);
        transition: var(--transition-smooth);
    }

    .pagination__select-wrapper:hover .pagination__select-icon {
        color: var(--accent-cyan);
    }

    .pagination__total {
        color: var(--text-secondary);
        font-weight: 500;
    }

    @media (max-width: 600px) {
        .blog-container {
            padding-top: 130px;
        }

        .pagination {
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
            gap: 16px;
            padding-top: 30px;
        }

        .pagination__selector {
            width: 100%;
            justify-content: center;
            order: -1;
            margin-bottom: 8px;
        }

        .pagination__btn {
            flex: 1;
            min-width: 120px;
            justify-content: center;
            padding: 10px 18px;
            font-size: 0.9rem;
        }
    }
</style>
