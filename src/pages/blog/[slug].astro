---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HeroBg from "../../components/HeroBg.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Spis treści - nagłówki H2 oraz H3
const tocHeadings = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);

// Szacowany czas czytania
const rawBody = post.body || "";
const wordCount = rawBody.trim() ? rawBody.trim().split(/\s+/).length : 500;
const readingTime = Math.max(2, Math.ceil(wordCount / 220));

const formatDate = (date: Date) => {
    return date.toLocaleDateString("pl-PL", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};

const canonicalURL = `https://web2sell.pl/blog/${post.id}`;
const ogImageURL = post.data.image.startsWith("http")
    ? post.data.image
    : `https://web2sell.pl${post.data.image}`;

// Dane strukturalne SEO pod Google (Rich Snippet - BlogPosting + BreadcrumbList)
const blogPostingSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BlogPosting",
            "@id": `${canonicalURL}#article`,
            "headline": post.data.title,
            "description": post.data.description,
            "image": ogImageURL,
            "datePublished": post.data.pubDate.toISOString(),
            "dateModified": post.data.pubDate.toISOString(),
            "inLanguage": "pl-PL",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": canonicalURL
            },
            "author": {
                "@type": "Person",
                "name": post.data.author || "Kacper Moskal",
                "url": "https://web2sell.pl/#o-nas"
            },
            "publisher": {
                "@type": "Organization",
                "name": "web2sell",
                "url": "https://web2sell.pl/",
                "logo": {
                    "@type": "ImageObject",
                    "url": "https://web2sell.pl/assets/frameworks/logo.avif"
                }
            }
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${canonicalURL}#breadcrumb`,
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Strona główna",
                    "item": "https://web2sell.pl/"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Blog",
                    "item": "https://web2sell.pl/blog"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": post.data.title,
                    "item": canonicalURL
                }
            ]
        }
    ]
};

// Pobieramy wszystkie posty posortowane chronologicznie
const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = posts.findIndex((p) => p.id === post.id);

// Pokaż dalej: następny post chronologicznie (starszy).
const nextPost =
    currentIndex < posts.length - 1
        ? posts[currentIndex + 1]
        : posts.length > 1
          ? posts[0]
          : null;
---

<Layout
    title={`${post.data.title} | web2sell Blog`}
    description={post.data.description}
    canonical={canonicalURL}
    ogImage={post.data.image}
    ogType="article"
    robots="index, follow"
>
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    <Header activePage="blog" />

    <main class="post-container">
        <HeroBg behindContent={true} />

        <article class="post">
            <!-- Breadcrumbs SEO -->
            <nav class="post__breadcrumbs" aria-label="Ścieżka nawigacyjna">
                <a href="/">Strona główna</a>
                <span class="bc-sep">/</span>
                <a href="/blog">Blog</a>
                <span class="bc-sep">/</span>
                <span class="bc-current" aria-current="page">{post.data.title}</span>
            </nav>

            <div class="post__header">
                <a href="/blog" class="post__back-btn">
                    <i class="fa-solid fa-arrow-left-long"></i>
                    <span>Wróć do bloga</span>
                </a>

                <div class="post__meta">
                    <span class="post__author">
                        <i class="fa-regular fa-user"></i>
                        {post.data.author || "web2sell"}
                    </span>
                    <span class="post__divider">•</span>
                    <time
                        datetime={post.data.pubDate.toISOString()}
                        class="post__date"
                    >
                        <i class="fa-regular fa-calendar-days"></i>
                        {formatDate(post.data.pubDate)}
                    </time>
                    <span class="post__divider">•</span>
                    <span class="post__reading-time">
                        <i class="fa-regular fa-clock"></i>
                        {readingTime} min czytania
                    </span>
                </div>

                <h1 class="post__title">{post.data.title}</h1>
            </div>

            <!-- UKŁAD DWUKOLUMNOWY: LEWA STRONA TREŚĆ, PRAWA STRONA STICKY SIDEBAR -->
            <div class="post__layout">
                <!-- LEWA KOLUMNA: GŁÓWNA TREŚĆ ARTYKUŁU -->
                <div class="post__main-content">
                    <div class="post__image-wrapper">
                        <Image
                            src={post.data.image}
                            alt={post.data.imageAlt || post.data.title}
                            width={1280}
                            height={720}
                            class="post__image"
                            loading="eager"
                        />
                    </div>
                    {tocHeadings.length > 0 && (
                        <!-- Spis treści na telefony (zwijany akordeon) -->
                        <div class="post__mobile-toc">
                            <details class="mobile-toc-details">
                                <summary class="mobile-toc-summary">
                                    <span class="mobile-toc-title">
                                        <i class="fa-solid fa-list-ul"></i>
                                        Spis treści artykułu
                                    </span>
                                    <i class="fa-solid fa-chevron-down mobile-toc-arrow"></i>
                                </summary>
                                <ul class="mobile-toc-list">
                                    {tocHeadings.map((h) => (
                                        <li class={`mobile-toc-item mobile-toc-item--depth-${h.depth}`}>
                                            <a href={`#${h.slug}`}>{h.text}</a>
                                        </li>
                                    ))}
                                </ul>
                            </details>
                        </div>
                    )}

                    <section class="post__content">
                        <Content />
                    </section>

                    <!-- Sekcja udostępniania -->
                    <div class="post__share">
                        <span class="share__title"
                            >Spodobał ci się artykuł? Udostępnij go innym!</span
                        >
                        <div class="share__buttons">
                            <button
                                class="share-btn share-btn--native"
                                id="shareNative"
                                style="display: none;"
                                aria-label="Udostępnij artykuł"
                            >
                                <i class="fa-solid fa-share-nodes"></i>
                                <span class="tooltip">Udostępnij</span>
                            </button>
                            <a
                                href="#"
                                class="share-btn share-btn--facebook"
                                id="shareFacebook"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Udostępnij na Facebooku"
                            >
                                <i class="fa-brands fa-facebook-f"></i>
                            </a>
                            <a
                                href="#"
                                class="share-btn share-btn--x"
                                id="shareX"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Udostępnij na X"
                            >
                                <i class="fa-brands fa-x-twitter"></i>
                            </a>
                            <a
                                href="#"
                                class="share-btn share-btn--linkedin"
                                id="shareLinkedIn"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Udostępnij na LinkedIn"
                            >
                                <i class="fa-brands fa-linkedin-in"></i>
                            </a>
                            <button
                                class="share-btn share-btn--copy"
                                id="shareCopy"
                                aria-label="Kopiuj link do schowka"
                            >
                                <i class="fa-solid fa-link"></i>
                                <span class="tooltip" id="copyTooltip"
                                    >Skopiuj link</span
                                >
                            </button>
                        </div>
                    </div>

                    <!-- Dolna nawigacja artykułu -->
                    <div class="post__navigation">
                        <a
                            href="/blog"
                            class="post__nav-btn post__nav-btn--back"
                            aria-label="Wróć do listy wszystkich artykułów"
                        >
                            <i class="fa-solid fa-arrow-left-long"></i>
                            <span>Powrót na bloga</span>
                        </a>

                        {
                            nextPost && (
                                <a
                                    href={`/blog/${nextPost.id}`}
                                    class="post__nav-btn post__nav-btn--next"
                                    aria-label={`Przeczytaj kolejny artykuł: ${nextPost.data.title}`}
                                >
                                    <span>Pokaż dalej</span>
                                    <i class="fa-solid fa-arrow-right-long" />
                                </a>
                            )
                        }
                    </div>
                </div>

                <!-- PRAWA KOLUMNA: STICKY DIVY (SPIS TREŚCI + DARMOWA WYCENA) -->
                <aside class="post__sidebar">
                    <div class="post__sidebar-sticky">
                        {tocHeadings.length > 0 && (
                            <div class="post__toc-card">
                                <div class="toc-card__header">
                                    <i class="fa-solid fa-list-ul"></i>
                                    <span>Spis treści</span>
                                </div>
                                <nav class="toc-card__nav" aria-label="Spis treści artykułu">
                                    <ul class="toc-card__list">
                                        {tocHeadings.map((h) => (
                                            <li class={`toc-card__item toc-card__item--depth-${h.depth}`}>
                                                <a href={`#${h.slug}`} class="toc-link">
                                                    {h.text}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </nav>
                            </div>
                        )}

                        <!-- STICKY CTA: DARMOWA WYCENA / CZY POTRZEBUJESZ STRONY -->
                        <div class="post__sidebar-cta">
                            <div class="sidebar-cta__badge">
                                <i class="fa-solid fa-bolt"></i>
                                <span>Darmowa wycena w 24h</span>
                            </div>
                            <h3 class="sidebar-cta__title">
                                Potrzebujesz strony dla swojej firmy?
                            </h3>
                            <p class="sidebar-cta__desc">
                                Budujemy ultra-szybkie strony internetowe od zera. Bez ciężkich motywów WordPress, z wynikiem 95-100 PageSpeed i bez comiesięcznych abonamentów.
                            </p>
                            
                            <ul class="sidebar-cta__features">
                                <li>
                                    <i class="fa-solid fa-check"></i>
                                    <span>100% autorski kod (Astro)</span>
                                </li>
                                <li>
                                    <i class="fa-solid fa-check"></i>
                                    <span>Ładowanie w ułamek sekundy</span>
                                </li>
                                <li>
                                    <i class="fa-solid fa-check"></i>
                                    <span>Optymalizacja SEO pod Google</span>
                                </li>
                            </ul>

                            <div class="sidebar-cta__actions">
                                <a href="/zamow" class="sidebar-cta__btn-primary">
                                    <span>Wyceń projekt za darmo</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                <a href="tel:+48530315860" class="sidebar-cta__btn-phone">
                                    <i class="fa-solid fa-phone"></i>
                                    <span>Zadzwoń: 530 315 860</span>
                                </a>
                            </div>

                            <a href="/cennik" class="sidebar-cta__link-cennik">
                                Sprawdź nasz przejrzysty cennik &rarr;
                            </a>
                        </div>
                    </div>
                </aside>
            </div>
        </article>
    </main>

    <!-- Skrypt płynnego przewijania spisu treści i podświetlania aktywnego nagłówka -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            var tocLinks = document.querySelectorAll(".toc-link, .mobile-toc-list a");
            var contentHeadings = document.querySelectorAll(
                ".post__content h2, .post__content h3"
            );

            if (tocLinks.length && contentHeadings.length) {
                tocLinks.forEach(function (link) {
                    link.addEventListener("click", function (e) {
                        var targetHref = this.getAttribute("href");
                        if (targetHref && targetHref.startsWith("#")) {
                            var targetEl = document.getElementById(targetHref.substring(1));
                            if (targetEl) {
                                e.preventDefault();
                                var offset = 100;
                                var bodyRect = document.body.getBoundingClientRect().top;
                                var elementRect = targetEl.getBoundingClientRect().top;
                                var elementPosition = elementRect - bodyRect;
                                var offsetPosition = elementPosition - offset;

                                window.scrollTo({
                                    top: offsetPosition,
                                    behavior: "smooth"
                                });
                                history.pushState(null, "", targetHref);
                            }
                        }
                    });
                });

                var observer = new IntersectionObserver(
                    function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                var id = entry.target.id;
                                document.querySelectorAll(".toc-link").forEach(function (l) {
                                    if (l.getAttribute("href") === "#" + id) {
                                        l.classList.add("toc-link--active");
                                    } else {
                                        l.classList.remove("toc-link--active");
                                    }
                                });
                            }
                        });
                    },
                    { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
                );

                contentHeadings.forEach(function (h) {
                    observer.observe(h);
                });
            }
        });
    </script>

    <Footer />
</Layout>

<style is:global>
    /* Stylowanie wyrenderowanej zawartości markdown za pomocą is:global */
    .post__content {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.8;
        font-weight: 400;
    }

    .post__content p {
        margin: 0 0 24px;
    }

    .post__content img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 32px auto;
        border-radius: 12px;
    }

    .post__content h2 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 40px 0 20px;
        line-height: 1.3;
        letter-spacing: -0.5px;
    }

    .post__content h3 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 32px 0 16px;
        line-height: 1.3;
    }

    .post__content ul,
    .post__content ol {
        margin: 0 0 24px;
        padding-left: 24px;
    }

    .post__content li {
        margin-bottom: 10px;
    }

    .post__content strong {
        color: var(--text-primary);
        font-weight: 700;
    }

    .post__content blockquote {
        border-left: 4px solid var(--accent-cyan);
        background: rgba(var(--accent-cyan-rgb), 0.04);
        padding: 16px 24px;
        margin: 30px 0;
        border-radius: 0 8px 8px 0;
        font-style: italic;
    }

    .post__content blockquote p {
        margin: 0;
    }

    .post__content a {
        color: var(--accent-blue);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px dashed var(--accent-blue);
        transition: var(--transition-smooth);
    }

    .post__content a:hover {
        color: var(--accent-cyan);
        border-bottom-color: var(--accent-cyan);
    }

    .post__content code {
        font-family: monospace;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--glass-border);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.95rem;
        color: var(--accent-cyan);
    }

    html[data-theme="light"] .post__content code {
        background: rgba(0, 0, 0, 0.04);
    }

    /* Przycisk CTA dla linkowania wewnętrznego w artykułach */
    .post__content .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 14px 28px;
        background: linear-gradient(
            135deg,
            var(--accent-cyan),
            var(--accent-blue)
        );
        color: #fff !important;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        text-decoration: none !important;
        border-radius: 50px;
        border: none !important;
        box-shadow: 0 4px 15px rgba(6, 182, 212, 0.2);
        transition: var(--transition-smooth);
        margin: 30px 0;
        cursor: pointer;
    }
    .post__content .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(6, 182, 212, 0.35);
        background: linear-gradient(
            135deg,
            var(--accent-blue),
            var(--accent-cyan)
        );
    }
    @media (max-width: 600px) {
        .post__content .cta-button {
            width: 100%;
            padding: 14px 20px;
            font-size: 0.95rem;
            box-sizing: border-box;
        }
    }
</style>

<style>
    .post-container {
        position: relative;
        max-width: 1260px;
        margin: 0 auto;
        padding: 150px 24px 80px;
        min-height: 85vh;
    }

    .post {
        position: relative;
        z-index: 2;
    }

    .post__breadcrumbs {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 24px;
    }

    .post__breadcrumbs a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: var(--transition-smooth);
    }

    .post__breadcrumbs a:hover {
        color: var(--accent-blue);
    }

    .bc-sep {
        color: var(--glass-border);
    }

    .bc-current {
        color: var(--text-primary);
        font-weight: 600;
        max-width: 420px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .post__header {
        margin-bottom: 30px;
    }

    .post__back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
        transition: var(--transition-smooth);
    }

    .post__back-btn i {
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        color: var(--accent-cyan);
    }

    .post__back-btn:hover {
        color: var(--text-primary);
    }

    .post__back-btn:hover i {
        transform: translateX(-6px);
        color: var(--accent-blue);
    }

    .post__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin-bottom: 16px;
        font-weight: 300;
    }

    .post__meta i {
        color: var(--accent-blue);
        margin-right: 4px;
    }

    .post__divider {
        color: var(--glass-border);
    }

    .post__reading-time {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text-secondary);
    }

    .post__reading-time i {
        color: var(--accent-cyan);
    }

    .post__title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(28px, 4.2vw, 46px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.25;
        letter-spacing: -1px;
        margin: 0;
    }

    .post__image-wrapper {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        margin-bottom: 32px;
        width: 100%;
        max-width: 820px;
        aspect-ratio: 16 / 9;
        background: rgba(var(--accent-blue-rgb), 0.05);
    }

    .post__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* UKŁAD DWUKOLUMNOWY: LEWA TREŚĆ, PRAWY STICKY SIDEBAR */
    .post__layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 48px;
        margin-top: 30px;
    }

    .post__main-content {
        min-width: 0;
    }

    .post__sidebar {
        position: -webkit-sticky;
        position: sticky;
        top: 100px;
        align-self: start;
        width: 340px;
    }

    .post__sidebar-sticky {
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        padding-right: 4px;
        scrollbar-width: thin;
    }

    .post__sidebar-sticky::-webkit-scrollbar {
        width: 4px;
    }

    .post__sidebar-sticky::-webkit-scrollbar-thumb {
        background: rgba(var(--accent-blue-rgb), 0.2);
        border-radius: 4px;
    }

    /* KARTA SPISU TREŚCI (TOC) */
    .post__toc-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 22px 20px;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
    }

    .toc-card__header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--text-primary);
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--glass-border);
    }

    .toc-card__header i {
        color: var(--accent-blue);
        font-size: 0.9rem;
    }

    .toc-card__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .toc-card__item {
        line-height: 1.4;
    }

    .toc-card__item--depth-3 {
        padding-left: 14px;
        font-size: 0.85rem;
    }

    .toc-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.88rem;
        transition: all 0.2s ease;
        display: block;
        border-left: 2px solid transparent;
        padding-left: 6px;
    }

    .toc-link:hover {
        color: var(--text-primary);
        border-left-color: rgba(var(--accent-blue-rgb), 0.5);
        padding-left: 10px;
    }

    .toc-link--active {
        color: var(--accent-blue) !important;
        font-weight: 700;
        border-left-color: var(--accent-blue) !important;
        padding-left: 10px;
    }

    /* KARTA STICKY CTA: DARMOWA WYCENA */
    .post__sidebar-cta {
