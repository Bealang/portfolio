---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HeroBg from "../../components/HeroBg.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
    return date.toLocaleDateString("pl-PL", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};

// Pobieramy wszystkie posty posortowane chronologicznie
const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = posts.findIndex((p) => p.id === post.id);

// Pokaż dalej: następny post chronologicznie (starszy).
// Jeśli nie ma starszego (jesteśmy na końcu), wracamy do najnowszego (pierwszego na liście).
const nextPost =
    currentIndex < posts.length - 1
        ? posts[currentIndex + 1]
        : posts.length > 1
          ? posts[0]
          : null;
---

<Layout
    title={`${post.data.title} | web2sell`}
    description={post.data.description}
    ogImage={post.data.image}
    ogType="article"
    robots="noindex, follow"
>
    <Header activePage="blog" />

    <main class="post-container">
        <HeroBg behindContent={true} />

        <article class="post">
            <div class="post__header">
                <a href="/blog" class="post__back-btn">
                    <i class="fa-solid fa-arrow-left-long"></i>
                    <span>Wróć do bloga</span>
                </a>

                <div class="post__meta">
                    <span class="post__author">
                        <i class="fa-regular fa-user"></i>
                        {post.data.author || "web2sell"}
                    </span>
                    <span class="post__divider">•</span>
                    <time
                        datetime={post.data.pubDate.toISOString()}
                        class="post__date"
                    >
                        <i class="fa-regular fa-calendar-days"></i>
                        {formatDate(post.data.pubDate)}
                    </time>
                </div>

                <h1 class="post__title">{post.data.title}</h1>
            </div>

            <div class="post__image-wrapper">
                <Image
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    width={1200}
                    height={600}
                    class="post__image"
                />
            </div>

            <section class="post__content">
                <Content />
            </section>

            <!-- Sekcja udostępniania -->
            <div class="post__share">
                <span class="share__title"
                    >Spodobał ci się artykuł? Udostępnij go innym!</span
                >
                <div class="share__buttons">
                    <button
                        class="share-btn share-btn--native"
                        id="shareNative"
                        style="display: none;"
                        aria-label="Udostępnij artykuł"
                    >
                        <i class="fa-solid fa-share-nodes"></i>
                        <span class="tooltip">Udostępnij</span>
                    </button>
                    <a
                        href="#"
                        class="share-btn share-btn--facebook"
                        id="shareFacebook"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Udostępnij na Facebooku"
                    >
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a
                        href="#"
                        class="share-btn share-btn--x"
                        id="shareX"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Udostępnij na X"
                    >
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>
                    <a
                        href="#"
                        class="share-btn share-btn--linkedin"
                        id="shareLinkedIn"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Udostępnij na LinkedIn"
                    >
                        <i class="fa-brands fa-linkedin-in"></i>
                    </a>
                    <button
                        class="share-btn share-btn--copy"
                        id="shareCopy"
                        aria-label="Kopiuj link do schowka"
                    >
                        <i class="fa-solid fa-link"></i>
                        <span class="tooltip" id="copyTooltip"
                            >Skopiuj link</span
                        >
                    </button>
                </div>
            </div>

            <script is:inline>
                document.addEventListener("DOMContentLoaded", function () {
                    var pageUrl = window.location.href;
                    var pageTitle = document.title;

                    var shareNativeBtn = document.getElementById("shareNative");
                    var fbBtn = document.getElementById("shareFacebook");
                    var xBtn = document.getElementById("shareX");
                    var liBtn = document.getElementById("shareLinkedIn");
                    var copyBtn = document.getElementById("shareCopy");
                    var tooltip = document.getElementById("copyTooltip");

                    if (navigator.share) {
                        // Jeśli przeglądarka wspiera Web Share API (głównie urządzenia mobilne)
                        if (shareNativeBtn) {
                            shareNativeBtn.style.display = "flex";
                            shareNativeBtn.addEventListener(
                                "click",
                                function () {
                                    navigator
                                        .share({
                                            title: document.title,
                                            url: pageUrl,
                                        })
                                        .catch(function (err) {
                                            console.log(
                                                "Anulowano udostępnianie lub błąd: ",
                                                err,
                                            );
                                        });
                                },
                            );
                        }
                        // Ukrywamy poszczególne przyciski społecznościowe, bo natywny panel systemowy obsługuje je znacznie lepiej
                        if (fbBtn) fbBtn.style.display = "none";
                        if (xBtn) xBtn.style.display = "none";
                        if (liBtn) liBtn.style.display = "none";
                    } else {
                        // Tradycyjne linki społecznościowe dla komputerów stacjonarnych
                        var encodedUrl = encodeURIComponent(pageUrl);
                        var encodedTitle = encodeURIComponent(pageTitle);
                        if (fbBtn)
                            fbBtn.href =
                                "https://www.facebook.com/sharer/sharer.php?u=" +
                                encodedUrl;
                        if (xBtn)
                            xBtn.href =
                                "https://twitter.com/intent/tweet?url=" +
                                encodedUrl +
                                "&text=" +
                                encodedTitle;
                        if (liBtn)
                            liBtn.href =
                                "https://www.linkedin.com/sharing/share-offsite/?url=" +
                                encodedUrl;
                    }

                    if (copyBtn && tooltip) {
                        copyBtn.addEventListener("click", function () {
                            navigator.clipboard
                                .writeText(pageUrl)
                                .then(function () {
                                    tooltip.textContent = "Skopiowano!";
                                    tooltip.classList.add("tooltip--visible");
                                    setTimeout(function () {
                                        tooltip.textContent = "Skopiuj link";
                                        tooltip.classList.remove(
                                            "tooltip--visible",
                                        );
                                    }, 2000);
                                })
                                .catch(function (err) {
                                    console.error("Błąd kopiowania: ", err);
                                });
                        });
                    }
                });
            </script>

            <!-- Dolna nawigacja artykułu -->
            <div class="post__navigation">
                <a
                    href="/blog"
                    class="post__nav-btn post__nav-btn--back"
                    aria-label="Wróć do listy wszystkich artykułów"
                >
                    <i class="fa-solid fa-arrow-left-long"></i>
                    <span>Powrót na bloga</span>
                </a>

                {
                    nextPost && (
                        <a
                            href={`/blog/${nextPost.id}`}
                            class="post__nav-btn post__nav-btn--next"
                            aria-label={`Przeczytaj kolejny artykuł: ${nextPost.data.title}`}
                        >
                            <span>Pokaż dalej</span>
                            <i class="fa-solid fa-arrow-right-long" />
                        </a>
                    )
                }
            </div>
        </article>
    </main>

    <Footer />
</Layout>

<style is:global>
    /* Stylowanie wyrenderowanej zawartości markdown za pomocą is:global */
    .post__content {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.8;
        font-weight: 400;
    }

    .post__content p {
        margin: 0 0 24px;
    }

    .post__content img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 32px auto;
        border-radius: 12px;
    }

    .post__content h2 {
        font-family: "Figtree", sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 40px 0 20px;
        line-height: 1.3;
        letter-spacing: -0.5px;
    }

    .post__content h3 {
        font-family: "Figtree", sans-serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 32px 0 16px;
        line-height: 1.3;
    }

    .post__content ul,
    .post__content ol {
        margin: 0 0 24px;
        padding-left: 24px;
    }

    .post__content li {
        margin-bottom: 10px;
    }

    .post__content strong {
        color: var(--text-primary);
        font-weight: 700;
    }

    .post__content blockquote {
        border-left: 4px solid var(--accent-cyan);
        background: rgba(var(--accent-cyan-rgb), 0.04);
        padding: 16px 24px;
        margin: 30px 0;
        border-radius: 0 8px 8px 0;
        font-style: italic;
    }

    .post__content blockquote p {
        margin: 0;
    }

    .post__content a {
        color: var(--accent-blue);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px dashed var(--accent-blue);
        transition: var(--transition-smooth);
    }

    .post__content a:hover {
        color: var(--accent-cyan);
        border-bottom-color: var(--accent-cyan);
    }

    .post__content code {
        font-family: monospace;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--glass-border);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.95rem;
        color: var(--accent-cyan);
    }

    html[data-theme="light"] .post__content code {
        background: rgba(0, 0, 0, 0.04);
    }

    /* Przycisk CTA dla linkowania wewnętrznego w artykułach */
    .post__content .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 14px 28px;
        background: linear-gradient(
            135deg,
            var(--accent-cyan),
            var(--accent-blue)
        );
        color: #fff !important;
        font-family: "Figtree", sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        text-decoration: none !important;
        border-radius: 50px;
        border: none !important;
        box-shadow: 0 4px 15px rgba(6, 182, 212, 0.2);
        transition: var(--transition-smooth);
        margin: 30px 0;
        cursor: pointer;
    }
    .post__content .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(6, 182, 212, 0.35);
        background: linear-gradient(
            135deg,
            var(--accent-blue),
            var(--accent-cyan)
        );
    }
    @media (max-width: 600px) {
        .post__content .cta-button {
            width: 100%;
            padding: 14px 20px;
            font-size: 0.95rem;
            box-sizing: border-box;
        }
    }
</style>

<style>
    .post-container {
        position: relative;
        max-width: 800px; /* węższy kontener dla maksymalnego skupienia na czytaniu */
        margin: 0 auto;
        padding: 160px 5% 80px;
        min-height: 85vh;
    }

    .post {
        position: relative;
        z-index: 2;
    }

    .post__header {
        margin-bottom: 40px;
    }

    .post__back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 30px;
        transition: var(--transition-smooth);
    }

    .post__back-btn i {
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        color: var(--accent-cyan);
    }

    .post__back-btn:hover {
        color: var(--text-primary);
    }

    .post__back-btn:hover i {
        transform: translateX(-6px);
        color: var(--accent-blue);
    }

    .post__meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin-bottom: 16px;
        font-weight: 300;
    }

    .post__meta i {
        color: var(--accent-blue);
        margin-right: 4px;
    }

    .post__divider {
        color: var(--glass-border);
    }

    .post__title {
        font-family: "Figtree", sans-serif;
        font-size: clamp(28px, 4.5vw, 48px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -1px;
        margin: 0;
    }

    .post__image-wrapper {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        margin-bottom: 40px;
        height: 400px;
        width: 100%;
    }

    .post__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: 768px) {
        .post-container {
            padding-top: 130px;
        }

        .post__title {
            text-align: left !important;
        }

        .post__image-wrapper {
            height: 250px;
            border-radius: 12px;
        }

        .post__content {
            text-align: justify;
            text-justify: inter-word;
        }
    }

    /* Dolna nawigacja artykułu - premium glassmorphism styling */
    .post__navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid var(--glass-border);
        gap: 20px;
        flex-wrap: nowrap;
        width: 100%;
        box-sizing: border-box;
    }

    .post__nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 30px;
        border-radius: 50px;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        box-sizing: border-box;
        transition:
            transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
            box-shadow 0.3s ease,
            background 0.3s ease,
            border-color 0.3s ease,
            color 0.3s ease;
        cursor: pointer;
    }

    .post__nav-btn i {
        font-size: 0.85rem;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .post__nav-btn:active {
        transform: scale(0.97);
    }

    /* Powrót na bloga — subtelny outline z gradientowym akcentem */
    .post__nav-btn--back {
        background: transparent;
        border: 1.5px solid var(--glass-border);
        color: var(--text-primary);
    }

    .post__nav-btn--back i {
        color: var(--accent-cyan);
    }

    .post__nav-btn--back:hover {
        transform: translateY(-3px);
        border-color: var(--accent-cyan);
        box-shadow: 0 8px 24px rgba(6, 182, 212, 0.12);
        color: var(--accent-cyan);
    }

    .post__nav-btn--back:hover i {
        transform: translateX(-6px);
    }

    /* Pokaż dalej — pełny gradient CTA */
    .post__nav-btn--next {
        background: linear-gradient(
            135deg,
            var(--accent-cyan),
            var(--accent-blue)
        );
        border: 1.5px solid transparent;
        color: #fff;
        box-shadow: 0 4px 15px rgba(6, 182, 212, 0.2);
    }

    .post__nav-btn--next i {
        color: #fff;
    }

    .post__nav-btn--next:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(6, 182, 212, 0.3);
        background: linear-gradient(
            135deg,
            var(--accent-blue),
            var(--accent-cyan)
        );
    }

    .post__nav-btn--next:hover i {
        transform: translateX(6px);
    }

    @media (max-width: 600px) {
        .post__navigation {
            flex-direction: row;
            flex-wrap: nowrap;
            align-items: stretch;
            gap: 10px;
            margin-top: 45px;
            padding-top: 30px;
            width: 100%;
        }

        .post__nav-btn {
            flex: 1;
            min-width: 0;
            justify-content: center;
            padding: 12px 10px;
            font-size: 0.85rem;
            text-align: center;
            white-space: normal;
        }

        .post__nav-btn span {
            display: inline-block;
            line-height: 1.2;
        }
    }

    /* Sekcja udostępniania */
    .post__share {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 40px;
        padding: 20px 24px;
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        gap: 20px;
    }

    .share__title {
        font-family: "Figtree", sans-serif;
        font-weight: 700;
        color: var(--text-primary);
        font-size: 1rem;
    }

    .share__buttons {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .share-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid var(--glass-border);
        background: var(--bg-color);
        color: var(--text-secondary);
        transition: var(--transition-smooth);
        text-decoration: none !important;
        cursor: pointer;
        position: relative;
        padding: 0;
    }

    .share-btn i {
        font-size: 1.1rem;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .share-btn--facebook:hover {
        background: #1877f2;
        color: #fff;
        border-color: #1877f2;
        box-shadow: 0 0 15px rgba(24, 119, 242, 0.4);
    }

    .share-btn--x:hover {
        background: #000000;
        color: #fff;
        border-color: #333;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.4);
    }

    html[data-theme="light"] .share-btn--x:hover {
        background: #0f1419;
    }

    .share-btn--linkedin:hover {
        background: #0077b5;
        color: #fff;
        border-color: #0077b5;
        box-shadow: 0 0 15px rgba(0, 119, 181, 0.4);
    }

    .share-btn--native:hover {
        background: linear-gradient(
            135deg,
            var(--accent-cyan),
            var(--accent-blue)
        );
        color: #fff;
        border-color: transparent;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }

    .share-btn--copy:hover {
        background: linear-gradient(
            135deg,
            var(--accent-cyan),
            var(--accent-blue)
        );
        color: #fff;
        border-color: transparent;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }

    .share-btn:hover i {
        transform: scale(1.12);
    }

    .share-btn .tooltip {
        position: absolute;
        bottom: 125%;
        left: 50%;
        transform: translateX(-50%) translateY(5px);
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        color: var(--text-primary);
        font-family: "Figtree", sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 6px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        box-shadow: var(--glass-shadow);
        z-index: 10;
    }

    .share-btn:hover .tooltip,
    .share-btn .tooltip.tooltip--visible {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    @media (max-width: 600px) {
        .post__share {
            flex-direction: column;
            align-items: center;
            padding: 16px;
            gap: 12px;
        }
    }
</style>
