---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HeroBg from '../../components/HeroBg.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('pl-PL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
};

// Pobieramy wszystkie posty posortowane chronologicznie
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = posts.findIndex((p) => p.id === post.id);

// Pokaż dalej: następny post chronologicznie (starszy). 
// Jeśli nie ma starszego (jesteśmy na końcu), wracamy do najnowszego (pierwszego na liście).
const nextPost = currentIndex < posts.length - 1 ? posts[currentIndex + 1] : (posts.length > 1 ? posts[0] : null);
---

<Layout
  title={`${post.data.title} | web2sell`}
  description={post.data.description}
  ogImage={post.data.image}
  ogType="article"
>
    <Header activePage="blog" />

    <main class="post-container">
        <HeroBg behindContent={true} />

        <article class="post">
            <div class="post__header" data-aos="fade-up" data-aos-duration="800">
                <a href="/blog" class="post__back-btn">
                    <i class="fa-solid fa-arrow-left-long"></i>
                    <span>Wróć do bloga</span>
                </a>

                <div class="post__meta">
                    <span class="post__author">
                        <i class="fa-regular fa-user"></i> {post.data.author || 'web2sell'}
                    </span>
                    <span class="post__divider">•</span>
                    <time datetime={post.data.pubDate.toISOString()} class="post__date">
                        <i class="fa-regular fa-calendar-days"></i> {formatDate(post.data.pubDate)}
                    </time>
                </div>

                <h1 class="post__title">{post.data.title}</h1>
            </div>

            <div class="post__image-wrapper" data-aos="zoom-in" data-aos-duration="1000" data-aos-delay="100">
                <Image src={post.data.image} alt={post.data.imageAlt || post.data.title} width={1200} height={600} class="post__image" />
            </div>

            <section class="post__content" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
                <Content />
            </section>

            <!-- Dolna nawigacja artykułu -->
            <div class="post__navigation" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">
                <a href="/blog" class="post__nav-btn post__nav-btn--back" aria-label="Wróć do listy wszystkich artykułów">
                    <i class="fa-solid fa-arrow-left-long"></i>
                    <span>Powrót na bloga</span>
                </a>
                
                {nextPost && (
                    <a href={`/blog/${nextPost.id}`} class="post__nav-btn post__nav-btn--next" aria-label={`Przeczytaj kolejny artykuł: ${nextPost.data.title}`}>
                        <span>Pokaż dalej</span>
                        <i class="fa-solid fa-arrow-right-long"></i>
                    </a>
                )}
            </div>
        </article>
    </main>

    <Footer />

    <!-- Floating CTA (Poznaj naszą ofertę cennikową) -->
    <a href="/cennik" class="floating-cta" aria-label="Poznaj naszą ofertę cennikową">
        <span>Poznaj naszą ofertę</span>
        <i class="fa-solid fa-arrow-right-long"></i>
    </a>
</Layout>

<style is:global>
    /* Stylowanie wyrenderowanej zawartości markdown za pomocą is:global */
    .post__content {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.8;
        font-weight: 300;
    }

    .post__content p {
        margin: 0 0 24px;
    }

    .post__content img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 32px auto;
        border-radius: 12px;
    }

    .post__content h2 {
        font-family: 'Figtree', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 40px 0 20px;
        line-height: 1.3;
        letter-spacing: -0.5px;
    }

    .post__content h3 {
        font-family: 'Figtree', sans-serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 32px 0 16px;
        line-height: 1.3;
    }

    .post__content ul, .post__content ol {
        margin: 0 0 24px;
        padding-left: 24px;
    }

    .post__content li {
        margin-bottom: 10px;
    }

    .post__content strong {
        color: var(--text-primary);
        font-weight: 700;
    }

    .post__content blockquote {
        border-left: 4px solid var(--accent-cyan);
        background: rgba(236, 72, 153, 0.04);
        padding: 16px 24px;
        margin: 30px 0;
        border-radius: 0 8px 8px 0;
        font-style: italic;
    }

    .post__content blockquote p {
        margin: 0;
    }

    .post__content a {
        color: var(--accent-blue);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px dashed var(--accent-blue);
        transition: var(--transition-smooth);
    }

    .post__content a:hover {
        color: var(--accent-cyan);
        border-bottom-color: var(--accent-cyan);
    }

    .post__content code {
        font-family: monospace;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--glass-border);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.95rem;
        color: var(--accent-cyan);
    }

    html[data-theme="light"] .post__content code {
        background: rgba(0, 0, 0, 0.04);
    }
</style>

<style>
    .post-container {
        position: relative;
        max-width: 800px; /* węższy kontener dla maksymalnego skupienia na czytaniu */
        margin: 0 auto;
        padding: 160px 5% 80px;
        min-height: 85vh;
    }

    .post {
        position: relative;
        z-index: 2;
    }

    .post__header {
        margin-bottom: 40px;
    }

    .post__back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 30px;
        transition: var(--transition-smooth);
    }

    .post__back-btn i {
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        color: var(--accent-cyan);
    }

    .post__back-btn:hover {
        color: var(--text-primary);
    }

    .post__back-btn:hover i {
        transform: translateX(-6px);
        color: var(--accent-blue);
    }

    .post__meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin-bottom: 16px;
        font-weight: 300;
    }

    .post__meta i {
        color: var(--accent-blue);
        margin-right: 4px;
    }

    .post__divider {
        color: var(--glass-border);
    }

    .post__title {
        font-family: 'Figtree', sans-serif;
        font-size: clamp(28px, 4.5vw, 48px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -1px;
        margin: 0;
    }

    .post__image-wrapper {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        margin-bottom: 40px;
        height: 400px;
        width: 100%;
    }

    .post__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: 768px) {
        .post-container {
            padding-top: 130px;
        }

        .post__image-wrapper {
            height: 250px;
            border-radius: 12px;
        }

        .post__content {
            text-align: justify;
            text-justify: inter-word;
        }
    }

    /* Dolna nawigacja artykułu - premium glassmorphism styling */
    .post__navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid var(--glass-border);
        gap: 20px;
        flex-wrap: wrap;
    }

    .post__nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 26px;
        border-radius: 50px;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        transition: var(--transition-smooth);
        border: 1px solid var(--glass-border);
        background: var(--card-bg);
        color: var(--text-primary);
        box-shadow: var(--glass-shadow);
        cursor: pointer;
    }

    .post__nav-btn i {
        font-size: 0.85rem;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    /* Powrót na bloga */
    .post__nav-btn--back i {
        color: var(--accent-cyan);
    }

    .post__nav-btn--back:hover {
        transform: translateY(-3px);
        border-color: var(--card-hover-border);
        box-shadow: 0 10px 20px rgba(139, 92, 246, 0.06), var(--glass-shadow);
    }

    .post__nav-btn--back:hover i {
        transform: translateX(-6px);
        color: var(--accent-blue);
    }

    /* Pokaż dalej */
    .post__nav-btn--next {
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.08), rgba(59, 130, 246, 0.08));
        border-color: rgba(6, 182, 212, 0.25);
    }

    .post__nav-btn--next i {
        color: var(--accent-cyan);
    }

    .post__nav-btn--next:hover {
        transform: translateY(-3px);
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
        border-color: transparent;
        color: #fff;
        box-shadow: 0 12px 25px rgba(6, 182, 212, 0.25);
    }

    .post__nav-btn--next:hover i {
        transform: translateX(6px);
        color: #fff;
    }

    @media (max-width: 600px) {
        .post__navigation {
            flex-direction: column-reverse;
            align-items: stretch;
            gap: 14px;
            margin-top: 45px;
            padding-top: 30px;
        }

        .post__nav-btn {
            justify-content: center;
            width: 100%;
            padding: 14px 20px;
        }
    }

    /* ==========================================================================
       FLOATING CTA STYLES (ALWAYS VISIBLE EN ROUTE TO /CENNIK)
       ========================================================================== */
    .floating-cta {
        position: fixed;
        bottom: 32px;
        right: 32px;
        z-index: 999;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        border-radius: 50px;
        font-family: 'Figtree', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        color: #fff !important;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), 
                    box-shadow 0.3s ease, 
                    background-color 0.3s ease;
        cursor: pointer;
    }
    .floating-cta i {
        font-size: 0.9rem;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        color: #fff;
    }
    .floating-cta:hover {
        transform: translateY(-4px) scale(1.03);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-cyan));
    }
    .floating-cta:hover i {
        transform: translateX(4px);
    }
    .floating-cta:active {
        transform: translateY(-2px) scale(0.98);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    @media (max-width: 600px) {
        .floating-cta {
            bottom: 20px;
            right: 20px;
            padding: 12px 22px;
            font-size: 0.88rem;
            gap: 8px;
        }
    }
</style>
