---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  bodyClass?: string;
}

const { title, description, canonical, bodyClass = '' } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;

import '@fontsource/figtree/300.css';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/800.css';
import '../styles/main.css';
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL}>
    <meta name="robots" content="index, follow">

    <!-- Fonts -->

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- AOS Animations -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Swiper -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <!-- Styles -->
    <style is:global>
      /* ==========================================================================
         PROJECT MODAL STYLES
         ========================================================================== */
      .project-modal {
          position: fixed;
          inset: 0;
          z-index: 9999;
          display: flex;
          align-items: center;
          justify-content: center;
          pointer-events: none;
          visibility: hidden;
      }
      .project-modal.is-open {
          pointer-events: auto;
          visibility: visible;
      }
      .project-modal__backdrop {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.4);
          backdrop-filter: blur(5px);
          -webkit-backdrop-filter: blur(5px);
          opacity: 0;
          transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .project-modal.is-open .project-modal__backdrop {
          opacity: 1;
      }
      .project-modal__container {
          position: relative;
          width: 90%;
          max-width: 800px;
          max-height: 85vh;
          background: #ffffff;
          border: none;
          border-radius: 16px;
          overflow: hidden;
          display: flex;
          flex-direction: column;
          opacity: 0;
          transform: translateY(30px) scale(0.96);
          transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          box-shadow: 0 25px 80px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
      }
      .project-modal.is-open .project-modal__container {
          opacity: 1;
          transform: translateY(0) scale(1);
      }
      .project-modal__close {
          position: absolute;
          top: 16px;
          right: 16px;
          z-index: 10;
          width: 48px;
          height: 48px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(255, 255, 255, 0.1);
          border: 1px solid rgba(255, 255, 255, 0.15);
          border-radius: 50%;
          color: #fff;
          font-size: 18px;
          cursor: pointer;
          transition: background 0.2s, transform 0.2s;
      }
      .project-modal__close:hover {
          background: rgba(255, 255, 255, 0.2);
          transform: scale(1.1);
      }
      .project-modal__header {
          padding: 32px 32px 24px;
          position: relative;
          border-top-left-radius: 16px;
          border-top-right-radius: 16px;
          background-clip: padding-box;
      }
      .project-modal__header::after {
          display: none;
      }
      .project-modal__header-content {
          display: flex;
          flex-direction: column;
          gap: 8px;
      }
      .project-modal__title {
          font-family: 'Figtree', sans-serif;
          font-size: 1.8rem;
          font-weight: 800;
          color: #fff;
          margin: 0;
          line-height: 1.2;
      }
      .project-modal__tag {
          font-size: 0.85rem;
          color: rgba(255, 255, 255, 0.5);
          font-weight: 400;
      }
      .project-modal__link {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          margin-top: 8px;
          padding: 8px 16px;
          background: rgba(255, 255, 255, 0.08);
          border: 1px solid rgba(255, 255, 255, 0.12);
          border-radius: 8px;
          color: #fff;
          font-size: 0.85rem;
          text-decoration: none;
          width: fit-content;
          transition: background 0.2s, border-color 0.2s;
      }
      .project-modal__link:hover {
          background: rgba(255, 255, 255, 0.15);
          border-color: rgba(255, 255, 255, 0.25);
      }
      .project-modal__body {
          flex: 1;
          overflow-y: auto;
          padding: 24px 32px 32px;
          scrollbar-width: thin;
          scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
      }
      .project-modal__body::-webkit-scrollbar {
          width: 8px;
      }
      .project-modal__body::-webkit-scrollbar-track {
          background: transparent;
      }
      .project-modal__body::-webkit-scrollbar-thumb {
          background: rgba(0, 0, 0, 0.15);
          border-radius: 4px;
      }
      .project-modal__body::-webkit-scrollbar-thumb:hover {
          background: rgba(0, 0, 0, 0.3);
      }
      .project-modal__gallery {
          margin-bottom: 24px;
          border-radius: 12px;
          overflow: hidden;
      }
      @keyframes modal-shimmer {
          0% {
              background-position: -200% 0;
          }
          100% {
              background-position: 200% 0;
          }
      }
      .swiper-slide-shimmer {
          background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
          background-size: 200% 100%;
          animation: modal-shimmer 1.5s infinite linear;
          border-radius: 12px;
          min-height: 250px;
      }
      @media (max-width: 600px) {
          .swiper-slide-shimmer {
              min-height: 180px;
          }
      }
      .project-modal__gallery .swiper-slide img {
          width: 100%;
          height: 100%;
          max-height: 400px;
          object-fit: cover;
          display: block;
          border-radius: 12px;
      }
      .project-modal__gallery .swiper-button-prev,
      .project-modal__gallery .swiper-button-next {
          color: #fff;
          --swiper-navigation-size: 28px;
      }
      .project-modal__gallery .swiper-pagination-bullet {
          background: rgba(255, 255, 255, 0.5);
      }
      .project-modal__gallery .swiper-pagination-bullet-active {
          background: #fff;
      }
      .project-modal__content {
          color: var(--text-secondary);
          font-size: 0.95rem;
          line-height: 1.7;
      }
      .project-modal__content h2 {
          font-family: 'Figtree', sans-serif;
          font-size: 1.3rem;
          font-weight: 700;
          color: var(--text-primary);
          margin: 0 0 16px;
      }
      .project-modal__content h3 {
          font-family: 'Figtree', sans-serif;
          font-size: 1.05rem;
          font-weight: 600;
          color: var(--text-primary);
          margin: 20px 0 12px;
      }
      .project-modal__content p { margin: 0 0 12px; }
      .project-modal__content ul { padding-left: 20px; margin: 0 0 16px; }
      .project-modal__content li { margin-bottom: 6px; }
      .project-modal__content strong { color: var(--text-primary); }

      @media (max-width: 600px) {
          .project-modal__container { width: 95%; max-height: 90vh; border-radius: 12px; }
          .project-modal__header { padding: 24px 20px 20px; }
          .project-modal__title { font-size: 1.4rem; }
          .project-modal__body { padding: 16px 20px 24px; }
      }
    </style>

    <!-- Google Analytics -->
    <meta name="google-site-verification" content="Mwvnib0juSolxrmHkKg77XAaBqiaqVDiL0JvLCP7hr0">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QZ55XLZEDP"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-QZ55XLZEDP');
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "web2sell - Tworzenie stron www",
        "image": "https://web2sell.pl/assets/project-img/joecraft.png",
        "url": "https://web2sell.pl/",
        "telephone": "",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Myślenice",
            "addressCountry": "PL"
        },
        "description": "Profesjonalne tworzenie stron www w Myślenicach. Projektowanie i programowanie nowoczesnych, szybkich stron internetowych."
    }
    </script>

    <slot name="head" />
</head>
<body class={bodyClass}>
    <slot />

    <!-- AOS -->
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
        AOS.init({ once: true, mirror: false, offset: 100 });
    </script>
</body>
</html>
