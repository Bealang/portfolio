---
interface Props {
    title: string;
    description: string;
    canonical?: string;
    bodyClass?: string;
    robots?: string;
    ogImage?: string;
    ogType?: string;
}

const {
    title,
    description,
    canonical,
    bodyClass = "",
    robots = "index, follow",
    ogImage = "/assets/og-image.png",
    ogType = "website",
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

import "@fontsource/plus-jakarta-sans/300.css";
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "../styles/main.css";
import ThemePicker from "../components/ThemePicker.astro";
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
        <script is:inline>
            (function () {
                // Theme (light/dark) - System default with manual override support
                const savedTheme = localStorage.getItem("theme");
                const systemPrefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
                const activeTheme = savedTheme || (systemPrefersDark ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", activeTheme);

                // Listen for system theme changes live if no manual preference is saved
                if (window.matchMedia) {
                    try {
                        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
                        const handleSystemThemeChange = function (e) {
                            if (!localStorage.getItem("theme")) {
                                const newTheme = e.matches ? "dark" : "light";
                                document.documentElement.setAttribute("data-theme", newTheme);
                            }
                        };
                        if (mediaQuery.addEventListener) {
                            mediaQuery.addEventListener("change", handleSystemThemeChange);
                        } else if (mediaQuery.addListener) {
                            mediaQuery.addListener(handleSystemThemeChange);
                        }
                    } catch (e) {}
                }

                // Color Palette Theme (cookie-based)
                const cookies = document.cookie.split(';');
                let colorTheme = 'pink'; // default to pink
                for (let i = 0; i < cookies.length; i++) {
                    const c = cookies[i].trim();
                    if (c.startsWith('color-theme=')) {
                        colorTheme = c.substring('color-theme='.length);
                        break;
                    }
                }
                document.documentElement.setAttribute('data-color-theme', colorTheme);
            })();
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/assets/favicon.png" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <meta name="robots" content={robots} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:site_name" content="web2sell" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImageURL} />

        <!-- Fonts -->

        <!-- Icons (Asynchronous non-blocking load) -->
        <link
            rel="preload"
            href="/assets/css/all.min.css"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript
            ><link
                rel="stylesheet"
                href="/assets/css/all.min.css"
            /></noscript
        >

        <!-- Google Analytics (Conditional load based on user cookie consent) -->
        <meta
            name="google-site-verification"
            content="Mwvnib0juSolxrmHkKg77XAaBqiaqVDiL0JvLCP7hr0"
        />
        <script is:inline>
            (function () {
                var CONSENT_KEY = "cookie-consent";
                var CONSENT_VERSION = "2026-09-22";
                var GA_ID = "G-QZ55XLZEDP";

                window.getPrivacyConsentRecord = function () {
                    try {
                        var storedConsent = localStorage.getItem(CONSENT_KEY);
                        if (!storedConsent) return null;

                        var record = JSON.parse(storedConsent);
                        if (
                            !record ||
                            record.version !== CONSENT_VERSION ||
                            (record.decision !== "accepted" &&
                                record.decision !== "declined") ||
                            !record.updatedAt
                        ) {
                            return null;
                        }

                        return record;
                    } catch (error) {
                        return null;
                    }
                };

                window.hasOptionalGoogleConsent = function () {
                    var record = window.getPrivacyConsentRecord();
                    return Boolean(
                        record &&
                            record.decision === "accepted" &&
                            record.categories &&
                            record.categories.analytics === true &&
                            record.categories.googleMaps === true,
                    );
                };

                window.initGA = function () {
                    if (window.gaInitialized) return;
                    window.gaInitialized = true;
                    window["ga-disable-" + GA_ID] = false;

                    // Inject gtag.js
                    var script = document.createElement("script");
                    script.async = true;
                    script.src =
                        "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
                    document.head.appendChild(script);

                    window.dataLayer = window.dataLayer || [];
                    window.gtag = function () {
                        window.dataLayer.push(arguments);
                    };
                    window.gtag("consent", "default", {
                        analytics_storage: "granted",
                        ad_storage: "denied",
                        ad_user_data: "denied",
                        ad_personalization: "denied",
                    });
                    window.gtag("js", new Date());
                    window.gtag("config", GA_ID, {
                        allow_google_signals: false,
                        allow_ad_personalization_signals: false,
                    });
                };

                if (window.hasOptionalGoogleConsent()) {
                    // User has already given consent. Load GA non-blockingly with delayed strategy.
                    var gaTriggered = false;
                    function triggerGA() {
                        if (gaTriggered) return;
                        gaTriggered = true;
                        window.removeEventListener("scroll", triggerGA);
                        window.removeEventListener("mousemove", triggerGA);
                        window.removeEventListener("touchstart", triggerGA);
                        window.removeEventListener("keydown", triggerGA);
                        window.initGA();
                    }
                    setTimeout(triggerGA, 3000);
                    window.addEventListener("scroll", triggerGA, {
                        passive: true,
                    });
                    window.addEventListener("mousemove", triggerGA, {
                        passive: true,
                    });
                    window.addEventListener("touchstart", triggerGA, {
                        passive: true,
                    });
                    window.addEventListener("keydown", triggerGA, {
                        passive: true,
                    });
                }
            })();
        </script>

        <!-- Structured Data -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ProfessionalService",
                "name": "web2sell - Tworzenie stron www",
                "image": "https://web2sell.pl/assets/project-img/joecraft.avif",
                "url": "https://web2sell.pl/",
                "telephone": "",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Myślenice",
                    "addressCountry": "PL"
                },
                "description": "Profesjonalne tworzenie stron www w Myślenicach. Projektowanie i programowanie nowoczesnych, szybkich stron internetowych."
            }
        </script>

        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <div class="app-wrapper">
            <slot />
        </div>

        <!-- Cookie Consent Banner (Premium Glassmorphic RODO Compliance) -->
        <div
            id="cookie-banner"
            class="cookie-banner hidden"
            role="dialog"
            aria-modal="true"
            aria-label="Zgoda na pliki cookie"
            aria-describedby="cookie-text"
        >
            <div class="cookie-banner__container">
                <div class="cookie-banner__content">
                    <i
                        class="fa-solid fa-cookie-bite cookie-banner__icon"
                        aria-hidden="true"></i>
                    <p id="cookie-text">
                        Ta strona korzysta z opcjonalnych usług Google Analytics
                        i Google Maps. Uruchomimy je dopiero po Twojej zgodzie.
                        Szczegóły znajdziesz w <a
                            href="/polityka"
                            class="cookie-banner__link">Polityce Prywatności</a
                        >.
                    </p>
                </div>
                <div class="cookie-banner__actions">
                    <button id="cookie-decline" class="cookie-banner__btn cookie-banner__btn--decline"
                        >Odrzuć</button
                    >
                    <button id="cookie-accept" class="cookie-banner__btn"
                        >Akceptuję</button
                    >
                </div>
            </div>
        </div>

        <script is:inline>
            (function () {
                var CONSENT_KEY = "cookie-consent";
                var CONSENT_VERSION = "2026-09-22";
                var GA_ID = "G-QZ55XLZEDP";
                var banner = document.getElementById("cookie-banner");
                var acceptBtn = document.getElementById("cookie-accept");
                var declineBtn = document.getElementById("cookie-decline");

                if (!banner || !acceptBtn || !declineBtn) return;

                function showBanner() {
                    banner.classList.remove("hidden");
                    banner.setAttribute("aria-hidden", "false");
                }

                function hideBanner() {
                    banner.classList.add("hidden");
                    banner.setAttribute("aria-hidden", "true");
                }

                function saveDecision(decision) {
                    var accepted = decision === "accepted";
                    var record = {
                        version: CONSENT_VERSION,
                        decision: decision,
                        updatedAt: new Date().toISOString(),
                        categories: {
                            analytics: accepted,
                            googleMaps: accepted,
                        },
                    };
                    localStorage.setItem(CONSENT_KEY, JSON.stringify(record));
                    return record;
                }

                function deleteAnalyticsCookies() {
                    var cookieNames = document.cookie
                        .split(";")
                        .map(function (cookie) {
                            return cookie.split("=")[0].trim();
                        })
                        .filter(function (name) {
                            return name === "_ga" || name.indexOf("_ga_") === 0;
                        });

                    cookieNames.forEach(function (name) {
                        var expired =
                            name +
                            "=; Max-Age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; SameSite=Lax";
                        document.cookie = expired;
                        document.cookie =
                            expired + "; domain=" + window.location.hostname;
                        document.cookie =
                            expired + "; domain=." + window.location.hostname;
                    });
                }

                function notifyConsentChange(record) {
                    window.dispatchEvent(
                        new CustomEvent("privacy-consent-changed", {
                            detail: record,
                        }),
                    );
                }

                acceptBtn.addEventListener("click", function () {
                    var record = saveDecision("accepted");
                    hideBanner();
                    window["ga-disable-" + GA_ID] = false;

                    if (typeof window.gtag === "function") {
                        window.gtag("consent", "update", {
                            analytics_storage: "granted",
                        });
                        window.gtag("config", GA_ID, {
                            allow_google_signals: false,
                            allow_ad_personalization_signals: false,
                        });
                    } else if (typeof window.initGA === "function") {
                        window.initGA();
                    }

                    notifyConsentChange(record);
                });

                declineBtn.addEventListener("click", function () {
                    var record = saveDecision("declined");
                    hideBanner();
                    window["ga-disable-" + GA_ID] = true;

                    if (typeof window.gtag === "function") {
                        window.gtag("consent", "update", {
                            analytics_storage: "denied",
                        });
                    }

                    deleteAnalyticsCookies();
                    notifyConsentChange(record);
                });

                document.addEventListener("click", function (event) {
                    if (!(event.target instanceof Element)) return;
                    var trigger = event.target.closest(
                        "[data-open-privacy-settings]",
                    );
                    if (!trigger) return;

                    event.preventDefault();
                    showBanner();
                    acceptBtn.focus();
                });

                // Legacy string values do not contain a date or policy version,
                // so one fresh choice is requested after this update.
                if (!window.getPrivacyConsentRecord()) {
                    showBanner();
                } else {
                    hideBanner();
                }
            })();
        </script>

        <!-- Native GPU-accelerated Scroll Reveal using IntersectionObserver -->
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                if (
                    window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                ) {
                    document.querySelectorAll("[data-aos]").forEach((el) => {
                        el.classList.add("aos-animate");
                    });
                    return;
                }

                // Batch DOM writes to prevent layout thrashing
                let elementsToAnimate: HTMLElement[] = [];
                let rAFId: number | null = null;

                const processAnimations = () => {
                    elementsToAnimate.forEach((el) => {
                        el.classList.add("aos-animate");
                    });
                    elementsToAnimate = [];
                    rAFId = null;
                };

                const observer = new IntersectionObserver(
                    (entries, obs) => {
                        let hasIntersecting = false;

                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                const el = entry.target as HTMLElement;
                                const duration =
                                    el.getAttribute("data-aos-duration");
                                const delay = el.getAttribute("data-aos-delay");

                                if (duration)
                                    el.style.transitionDuration = `${duration}ms`;
                                if (delay)
                                    el.style.transitionDelay = `${delay}ms`;

                                elementsToAnimate.push(el);
                                hasIntersecting = true;
                                obs.unobserve(el);
                            }
                        });

                        if (hasIntersecting && rAFId === null) {
                            rAFId = requestAnimationFrame(processAnimations);
                        }
                    },
                    {
                        rootMargin: "0px 0px -60px 0px",
                        threshold: 0.05,
                    },
                );

                document.querySelectorAll("[data-aos]").forEach((el) => {
                    observer.observe(el);
                });
            });
        </script>
        <ThemePicker />
    </body>
</html>
